---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SITE_AUTHOR } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  rightSidebar?: boolean;
  jsonLdType?: 'BlogPosting' | 'Person' | 'ProfilePage' | 'CollectionPage' | 'WebSite';
  date?: Date;
  dateModified?: Date;
  tags?: string[];
  includeDefaultJsonLd?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  rightSidebar = false,
  jsonLdType = 'WebSite',
  date,
  dateModified,
  tags,
  includeDefaultJsonLd = true,
} = Astro.props;

const pageTitle = title ? `${title} -- ${SITE_TITLE}` : `${SITE_TITLE} -- AI Systems, Foundational Models & Research`;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const markdownURL = Astro.url.pathname === '/' || Astro.url.pathname === ''
  ? new URL('/index.md', SITE_URL)
  : new URL(`${Astro.url.pathname.replace(/\/$/, '')}/index.md`, SITE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicon/site.webmanifest" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL(image || '/assets/images/profile.webp', SITE_URL)} />

    <!-- Twitter -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@jayjshah" />
    <meta name="twitter:creator" content="@jayjshah" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image || '/assets/images/profile.webp', SITE_URL)} />

    <!-- Discovery & Content Negotiation Alternates -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="alternate" type="text/markdown" title={`${pageTitle} (Markdown)`} href={markdownURL} />
    <link rel="alternate" type="text/plain" title="LLM Context Index" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="Full LLM Context" href="/llms-full.txt" />
    <link rel="service-desc" type="application/vnd.oai.openapi+json" title="OpenAPI 3.1 JSON" href="/openapi.json" />
    <link rel="service-desc" type="application/yaml" title="OpenAPI 3.1 YAML" href="/openapi.yaml" />
    <link rel="help" type="text/markdown" title="Agent Instructions" href="/.well-known/agent-instructions.md" />
    <link rel="canonical" href={canonicalURL} />

    <!-- JSON-LD Structured Data -->
    {includeDefaultJsonLd && (
      <JsonLd
        type={jsonLdType}
        title={title}
        description={description}
        date={date}
        dateModified={dateModified}
        image={image}
        tags={tags}
      />
    )}

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZQ651N672F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZQ651N672F');
    </script>

    <ClientRouter />

    <script is:inline>
      // Apply theme immediately to prevent flash (runs before paint)
      ;(function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh page-pattern">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-terra focus:text-white focus:rounded-lg focus:text-sm focus:font-mono">
      Skip to main content
    </a>
    <Sidebar />
    <MobileNav />

    <div class="app-content pt-14 lg:pt-0">
      <div class="w-full max-w-[1152px] px-6 lg:px-10 py-10 lg:py-14 flex justify-between gap-10 xl:gap-16">
        <main id="main-content" class="w-full max-w-[768px] min-w-0" data-pagefind-body>
          <slot />
        </main>
        {rightSidebar && (
          <slot name="right-sidebar" />
        )}
      </div>
    </div>

    <script is:inline>
      // Theme toggle + View Transitions compatibility
      function updateThemeAriaLabels() {
        var isDark = document.documentElement.classList.contains('dark');
        var label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
        document.querySelectorAll('#theme-toggle-desktop, #theme-toggle-mobile').forEach(function(b) {
          b.setAttribute('aria-label', label);
        });
      }

      function initThemeToggle() {
        var btns = document.querySelectorAll('#theme-toggle-desktop, #theme-toggle-mobile');
        btns.forEach(function(btn) {
          // Remove old listeners by cloning
          var newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);
          newBtn.addEventListener('click', function(e) {
            e.preventDefault();
            var isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeAriaLabels();
          });
        });
        updateThemeAriaLabels();
      }

      // Mobile menu toggle
      function initMobileMenu() {
        var btn = document.getElementById('mobile-menu-toggle');
        var menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
          var newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);
          newBtn.addEventListener('click', function() {
            var isOpen = !menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            var nowOpen = !menu.classList.contains('hidden');
            newBtn.setAttribute('aria-expanded', String(nowOpen));
            newBtn.setAttribute('aria-label', nowOpen ? 'Close menu' : 'Open menu');
          });
        }
      }

      // Re-apply theme after View Transition swap (before new page renders)
      document.addEventListener('astro:after-swap', function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      });

      // Re-bind event listeners after each page load (initial + transitions)
      document.addEventListener('astro:page-load', function() {
        initThemeToggle();
        initMobileMenu();
      });

      // Also run on initial page load (before astro:page-load fires)
      initThemeToggle();
      initMobileMenu();
    </script>
  </body>
</html>
