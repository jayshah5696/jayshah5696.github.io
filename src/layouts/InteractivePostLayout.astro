---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import Giscus from '../components/Giscus.astro';
import JsonLd from '../components/JsonLd.astro';
import KolamDivider from '../components/KolamDivider.astro';
import CodexScrubber from '../components/CodexScrubber.astro';
import readingTime from 'reading-time';
import '../styles/interactive-theme.css';

interface PostLink {
  slug: string;
  title: string;
}

interface SeriesPost {
  slug: string;
  title: string;
  order: number;
  current: boolean;
}

interface Props {
  title: string;
  date: Date;
  description: string;
  image?: string;
  tags: string[];
  body?: string;
  headings?: { depth: number; text: string; slug: string }[];
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
  seriesName?: string | null;
  seriesPosts?: SeriesPost[];
}

const {
  title,
  date,
  description,
  image,
  tags,
  body = '',
  headings = [],
  prevPost,
  nextPost,
  seriesName,
  seriesPosts = [],
} = Astro.props;

const stats = readingTime(body);
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = filteredHeadings.length > 2;
---

<BaseLayout title={title} description={description} image={image} rightSidebar={showToc} jsonLdType="BlogPosting" date={date} tags={tags}>
  
  <!-- Reading progress bar -->
  <div id="reading-progress" class="fixed top-0 left-0 right-0 z-50 h-1 app-progress" aria-hidden="true">
    <div id="reading-progress-bar" class="h-full w-0 transition-none shadow-sm" style="background: linear-gradient(to right, #c4623a, #d4a843); box-shadow: 0 1px 3px rgba(196,98,58,0.3);"></div>
  </div>

  <article class="vav-interactive-root w-full min-w-0 py-2">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums mb-4">
        <span class="whitespace-nowrap"><FormattedDate date={date} /></span>
        <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
        <span class="whitespace-nowrap">{stats.text}</span>
        <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
        <span class="inline-flex items-center gap-1.5 text-mor dark:text-mor-light whitespace-nowrap">
          <span class="size-1.5 rounded-full bg-mor dark:bg-mor-light" aria-hidden="true" />
          lab
        </span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-ink dark:text-silk leading-tight carved-heading mb-6">
        {title}
      </h1>

      <p class="text-lg text-ink-light dark:text-silk-muted leading-relaxed mb-6 text-pretty">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="mb-8">
          <TagList tags={tags} />
        </div>
      )}

      <KolamDivider class="mb-8" />
    </header>

    {seriesPosts.length > 0 && seriesName && (
      <nav class="mb-10 p-4 rounded-lg border border-cream-200 dark:border-night-700 bg-cream-50/50 dark:bg-night-800/50" aria-label="Post series">
        <h4 class="font-mono text-[11px] uppercase text-ink-faint dark:text-silk-faint mb-3" style="letter-spacing: 0.15em;">
          Series: {seriesName}
        </h4>
        <ol class="space-y-1.5">
          {seriesPosts.map((sp, i) => (
            <li class="flex items-baseline gap-2">
              <span class="font-mono text-[11px] text-ink-faint dark:text-silk-faint tabular-nums shrink-0">{i + 1}.</span>
              {sp.current ? (
                <span class="text-sm font-medium text-terra dark:text-terra-light">{sp.title}</span>
              ) : (
                <a href={`/posts/${sp.slug}/`} class="text-sm text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors">
                  {sp.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="interactive-content">
      <slot />
    </div>

    <!-- Comments & Discussion -->
    <div class="mt-16 pt-8 border-t border-cream-200 dark:border-night-700">
      <Giscus />
    </div>

    <footer class="mt-12 pt-6 pb-16 xl:pb-0">
      <KolamDivider class="mb-6" />

      <!-- Prev / Next navigation (Architectural Hairline Lattice) -->
      {(prevPost || nextPost) && (
        <nav class="vav-lattice grid grid-cols-1 sm:grid-cols-2 mb-8" aria-label="Post navigation">
          {prevPost ? (
            <a
              href={`/posts/${prevPost.slug}/`}
              class="group vav-cell flex flex-col gap-1.5 p-4 sm:p-5"
            >
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase text-ink-faint dark:text-silk-faint" style="letter-spacing: 0.1em;">
                <span class="inline-block group-hover:-translate-x-0.5 group-hover:text-terra dark:group-hover:text-terra-light transition-[color,transform] duration-150" aria-hidden="true">&larr;</span>
                <span>Newer</span>
              </span>
              <span class="text-[15px] font-body font-medium text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 line-clamp-2 leading-snug">
                {prevPost.title}
              </span>
            </a>
          ) : <div class="hidden sm:block vav-cell" />}
          {nextPost ? (
            <a
              href={`/posts/${nextPost.slug}/`}
              class="group vav-cell flex flex-col sm:items-end gap-1.5 p-4 sm:p-5 sm:text-right"
            >
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase text-ink-faint dark:text-silk-faint" style="letter-spacing: 0.1em;">
                <span>Older</span>
                <span class="inline-block group-hover:translate-x-0.5 group-hover:text-terra dark:group-hover:text-terra-light transition-[color,transform] duration-150" aria-hidden="true">&rarr;</span>
              </span>
              <span class="text-[15px] font-body font-medium text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 line-clamp-2 leading-snug">
                {nextPost.title}
              </span>
            </a>
          ) : <div class="hidden sm:block vav-cell" />}
        </nav>
      )}

      <a
        href="/blog/"
        class="group/back inline-flex items-center gap-1.5 text-xs text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors duration-150 font-mono"
        style="letter-spacing: 0.06em;"
      >
        <span class="inline-block group-hover/back:-translate-x-0.5 transition-transform duration-150" aria-hidden="true">&larr;</span>
        <span>All posts</span>
      </a>
    </footer>
  </article>

  {showToc && (
    <CodexScrubber slot="right-sidebar" headings={headings} />
  )}

  <script is:inline>
    (function() {
      var cleanup = null;
      var initializedPage = null;

      function initInteractivePostLayout() {
        var page = document.querySelector('.vav-interactive-root');
        if (!page || page === initializedPage) return;
        if (cleanup) cleanup();
        initializedPage = page;

        // Reading progress bar
        var bar = document.getElementById('reading-progress-bar');
        var progressUpdate = null;
        if (bar) {
          progressUpdate = function() {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            var pct = h > 0 ? Math.min((window.scrollY / h) * 100, 100) : 0;
            bar.style.width = pct + '%';
          };
          window.addEventListener('scroll', progressUpdate, { passive: true });
          progressUpdate();
        }

        cleanup = function() {
          if (progressUpdate) window.removeEventListener('scroll', progressUpdate);
          initializedPage = null;
          cleanup = null;
        };
      }

      document.addEventListener('astro:page-load', initInteractivePostLayout);
      document.addEventListener('astro:before-swap', function() {
        if (cleanup) cleanup();
      });
      initInteractivePostLayout();
    })();
  </script>
</BaseLayout>
