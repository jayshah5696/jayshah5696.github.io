---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import Giscus from '../components/Giscus.astro';
import JsonLd from '../components/JsonLd.astro';
import readingTime from 'reading-time';
import '../styles/interactive-theme.css';

interface PostLink {
  slug: string;
  title: string;
}

interface SeriesPost {
  slug: string;
  title: string;
  order: number;
  current: boolean;
}

interface Props {
  title: string;
  date: Date;
  description: string;
  image?: string;
  tags: string[];
  body?: string;
  headings?: { depth: number; text: string; slug: string }[];
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
  seriesName?: string | null;
  seriesPosts?: SeriesPost[];
}

const {
  title,
  date,
  description,
  image,
  tags,
  body = '',
  headings = [],
  prevPost,
  nextPost,
  seriesName,
  seriesPosts = [],
} = Astro.props;

const stats = readingTime(body);
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = filteredHeadings.length > 2;
---

<BaseLayout title={title} description={description} image={image} rightSidebar={showToc}>
  <JsonLd type="BlogPosting" title={title} description={description} date={date} image={image} tags={tags} />
  
  <!-- Reading progress bar -->
  <div id="reading-progress" class="fixed top-0 left-0 right-0 z-50 h-1 app-progress" aria-hidden="true">
    <div id="reading-progress-bar" class="h-full w-0 transition-none shadow-sm" style="background: currentcolor;"></div>
  </div>

  <article class="vav-interactive-root w-full min-w-0 py-2">
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <FormattedDate date={date} />
        <span class="text-cream-400 dark:text-night-700 text-xs select-none" aria-hidden="true">&bull;</span>
        <span class="font-mono text-xs text-ink-muted dark:text-silk-muted tabular-nums">{stats.text}</span>
        <span class="text-cream-400 dark:text-night-700 text-xs select-none" aria-hidden="true">&bull;</span>
        <span class="text-xs text-terra dark:text-terra-light font-semibold">Interactive Laboratory</span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-ink dark:text-silk leading-tight carved-heading mb-6">
        {title}
      </h1>

      <p class="text-lg text-ink-light dark:text-silk-muted leading-relaxed mb-6 text-pretty">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="mb-8">
          <TagList tags={tags} />
        </div>
      )}

      <div class="kolam-border mb-8"></div>
    </header>

    {seriesPosts.length > 0 && seriesName && (
      <nav class="mb-10 p-4 rounded-lg border border-cream-200 dark:border-night-700 bg-cream-50/50 dark:bg-night-800/50" aria-label="Post series">
        <h4 class="font-sans text-xs text-ink-faint dark:text-silk-faint mb-3">
          Series: {seriesName}
        </h4>
        <ol class="space-y-1.5">
          {seriesPosts.map((sp, i) => (
            <li class="flex items-baseline gap-2">
              <span class="font-mono text-[10px] text-ink-faint dark:text-silk-faint tabular-nums shrink-0">{i + 1}.</span>
              {sp.current ? (
                <span class="text-sm font-medium text-terra dark:text-terra-light">{sp.title}</span>
              ) : (
                <a href={`/posts/${sp.slug}/`} class="text-sm text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors">
                  {sp.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="interactive-content">
      <slot />
    </div>

    <!-- Comments & Discussion -->
    <div class="mt-16 pt-8 border-t border-cream-200 dark:border-night-700">
      <Giscus />
    </div>

    <footer class="mt-12 pt-6">
      <div class="kolam-border mb-6"></div>

      <!-- Prev / Next navigation -->
      {(prevPost || nextPost) && (
        <nav class="grid grid-cols-2 gap-4 mb-8" aria-label="Post navigation">
          {prevPost ? (
            <a
              href={`/posts/${prevPost.slug}/`}
              class="group flex flex-col gap-1 p-4 rounded-lg border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors"
            >
              <span class="font-sans text-xs text-ink-faint dark:text-silk-faint">
                <svg class="size-3 inline-block mr-1 -mt-px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Newer
              </span>
              <span class="text-sm font-display text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors line-clamp-2">
                {prevPost.title}
              </span>
            </a>
          ) : <div />}
          {nextPost ? (
            <a
              href={`/posts/${nextPost.slug}/`}
              class="group flex flex-col items-end gap-1 p-4 rounded-lg border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors text-right"
            >
              <span class="font-sans text-xs text-ink-faint dark:text-silk-faint">
                Older
                <svg class="size-3 inline-block ml-1 -mt-px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </span>
              <span class="text-sm font-display text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors line-clamp-2">
                {nextPost.title}
              </span>
            </a>
          ) : <div />}
        </nav>
      )}

      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors duration-200"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to all writings
      </a>
    </footer>
  </article>

  <!-- Right Sidebar with Table of Contents -->
  {showToc && (
    <aside slot="right-sidebar" class="hidden xl:block w-[240px] shrink-0">
      <div id="toc-container" class="sticky top-16 max-h-[calc(100dvh-5rem)] overflow-y-auto pr-2 scrollbar-none">
        <nav id="toc-nav" class="text-xs" aria-label="Table of contents">
          <!-- Header -->
          <div class="mb-4">
            <h4 class="text-ink-faint dark:text-silk-faint text-[10px] font-semibold">
              On this page
            </h4>
          </div>

          <!-- Main Track and Headings -->
          <div class="relative pl-6">
            <!-- Dual Kolam Track (Terra & Gold vertical rails) -->
            <div class="absolute left-[7px] top-1.5 bottom-1.5 flex gap-[1px] pointer-events-none" aria-hidden="true">
              <div class="w-px h-full bg-black/15 dark:bg-white/20"></div>
              <div class="w-px h-full bg-black/15 dark:bg-white/20"></div>
            </div>

            <!-- Sliding Kolam Interlaced Diamond Knot -->
            <div
              id="toc-active-knot"
              class="absolute -left-[1px] top-0 pointer-events-none transition-all duration-200 ease-out opacity-0 z-10"
              aria-hidden="true"
            >
              <svg class="size-5 text-terra dark:text-terra-light drop-shadow-[0_0_8px_rgba(196,98,58,0.6)] dark:drop-shadow-[0_0_10px_rgba(224,122,79,0.8)]" viewBox="0 0 24 24" fill="none">
                <!-- Kolam 4-petal sikku loop motif -->
                <path
                  d="M12 2 Q15 6 18 6 Q22 6 22 12 Q22 18 18 18 Q15 18 12 22 Q9 18 6 18 Q2 18 2 12 Q2 6 6 6 Q9 6 12 2 Z"
                  fill="currentColor"
                  fill-opacity="0.18"
                  stroke="currentColor"
                  stroke-width="1.2"
                />
                <!-- Center rotated diamond knot -->
                <rect x="7" y="7" width="10" height="10" rx="1" transform="rotate(45 12 12)" fill="currentColor" />
                <rect x="9" y="9" width="6" height="6" transform="rotate(45 12 12)" fill="#fdf9f1" class="dark:fill-[#15111e]" stroke="#d4a843" stroke-width="1" />
                <!-- Bindu Gold Center Dot -->
                <circle cx="12" cy="12" r="1.5" fill="#d4a843" class="dark:fill-[#e8c462]" />
              </svg>
            </div>

            <ul class="space-y-3">
              {filteredHeadings.map(({ depth, text, slug }) => (
                <li
                  data-toc-item
                  data-depth={depth}
                  class:list={[
                    'relative transition-all duration-150',
                    depth === 3 ? 'pl-4 ml-1.5' : '',
                  ]}
                >
                  {depth === 3 && (
                    <span
                      class="absolute left-0 top-2.5 w-3 h-px bg-cream-300/90 dark:bg-night-700 pointer-events-none"
                      aria-hidden="true"
                    />
                  )}
                  <a
                    href={`#${slug}`}
                    data-toc-link
                    data-heading-id={slug}
                    class="block text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors duration-150 line-clamp-2 leading-relaxed py-0.5 font-normal"
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </div>
    </aside>
  )}

  <script is:inline>
    (function() {
      var cleanup = null;
      var initializedPage = null;

      function initInteractivePostLayout() {
        var page = document.querySelector('.vav-interactive-root');
        if (!page || page === initializedPage) return;
        if (cleanup) cleanup();
        initializedPage = page;

        // Reading progress bar
        var bar = document.getElementById('reading-progress-bar');
        var progressUpdate = null;
        if (bar) {
          progressUpdate = function() {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            var pct = h > 0 ? Math.min((window.scrollY / h) * 100, 100) : 0;
            bar.style.width = pct + '%';
          };
          window.addEventListener('scroll', progressUpdate, { passive: true });
          progressUpdate();
        }

        // Copy button on code blocks
        document.querySelectorAll('pre:not(.mermaid)').forEach(function(pre) {
          if (pre.querySelector('.copy-code-btn')) return;
          var btn = document.createElement('button');
          btn.className = 'copy-code-btn';
          btn.textContent = 'Copy';
          btn.setAttribute('aria-label', 'Copy code to clipboard');
          btn.addEventListener('click', function() {
            var code = pre.querySelector('code');
            var text = code ? code.innerText : pre.innerText;
            navigator.clipboard.writeText(text).then(function() {
              btn.textContent = 'Copied!';
              setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
            });
          });
          pre.appendChild(btn);
        });

        // Table of Contents Scrollspy (Option 1: Kolam Rail & Knot)
        var tocNav = document.getElementById('toc-nav');
        var knot = document.getElementById('toc-active-knot');
        var headings = Array.from(document.querySelectorAll('article h2[id], article h3[id]'));
        var tocLinks = tocNav ? Array.from(tocNav.querySelectorAll('a[data-heading-id]')) : [];

        var scrollHandler = null;

        if (tocNav && headings.length > 0 && tocLinks.length > 0) {
          var activeId = '';

          function updateActiveHeading() {
            var scrollPos = window.scrollY + 140;
            var docHeight = document.documentElement.scrollHeight;
            var winHeight = window.innerHeight;
            var isAtBottom = (window.scrollY + winHeight) >= (docHeight - 60);

            var currentActiveId = headings[0].id;

            if (isAtBottom) {
              currentActiveId = headings[headings.length - 1].id;
            } else {
              for (var i = 0; i < headings.length; i++) {
                var h = headings[i];
                var top = h.getBoundingClientRect().top + window.scrollY;
                if (top <= scrollPos) {
                  currentActiveId = h.id;
                } else {
                  break;
                }
              }
            }

            if (currentActiveId !== activeId) {
              activeId = currentActiveId;

              tocLinks.forEach(function(link) {
                var headingId = link.getAttribute('data-heading-id');
                var item = link.closest('[data-toc-item]');
                var isActive = (headingId === activeId);

                if (isActive) {
                  link.classList.add('text-terra', 'dark:text-terra-light', 'font-medium');
                  link.classList.remove('text-ink-muted', 'dark:text-silk-muted');

                  // Move the Kolam knot to center on the active heading item
                  if (knot && item) {
                    var itemTop = item.offsetTop;
                    var linkEl = item.querySelector('a');
                    var linkH = linkEl ? linkEl.offsetHeight : item.offsetHeight;
                    var knotY = itemTop + Math.max(0, (linkH / 2) - 10);
                    knot.style.transform = 'translateY(' + knotY + 'px)';
                    knot.style.opacity = '1';
                  }

                  // Auto-scroll TOC sidebar container if needed
                  var container = document.getElementById('toc-container');
                  if (container && item) {
                    var cRect = container.getBoundingClientRect();
                    var iRect = item.getBoundingClientRect();
                    if (iRect.top < cRect.top + 20 || iRect.bottom > cRect.bottom - 20) {
                      item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    }
                  }
                } else {
                  link.classList.remove('text-terra', 'dark:text-terra-light', 'font-medium');
                  link.classList.add('text-ink-muted', 'dark:text-silk-muted');
                }
              });
            }
          }

          var ticking = false;
          scrollHandler = function() {
            if (!ticking) {
              window.requestAnimationFrame(function() {
                updateActiveHeading();
                ticking = false;
              });
              ticking = true;
            }
          };

          window.addEventListener('scroll', scrollHandler, { passive: true });
          window.addEventListener('resize', scrollHandler, { passive: true });

          // Smooth anchor scroll on TOC link click
          tocLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
              var targetId = link.getAttribute('data-heading-id');
              var targetEl = document.getElementById(targetId);
              if (targetEl) {
                e.preventDefault();
                history.pushState(null, '', '#' + targetId);
                targetEl.scrollIntoView({ behavior: 'smooth' });
                activeId = targetId;
                updateActiveHeading();
              }
            });
          });

          // Run immediately
          updateActiveHeading();
        }

        cleanup = function() {
          if (progressUpdate) window.removeEventListener('scroll', progressUpdate);
          if (scrollHandler) {
            window.removeEventListener('scroll', scrollHandler);
            window.removeEventListener('resize', scrollHandler);
          }
          initializedPage = null;
          cleanup = null;
        };
      }

      document.addEventListener('astro:page-load', initInteractivePostLayout);
      document.addEventListener('astro:before-swap', function() {
        if (cleanup) cleanup();
      });
      initInteractivePostLayout();
    })();
  </script>
</BaseLayout>
