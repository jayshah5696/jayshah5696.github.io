---
import { SITE_TITLE, NAV_ITEMS, SOCIAL_LINKS } from '../consts';
import SocialIcon from './SocialIcon.astro';
import BrandEmblem from './BrandEmblem.astro';

const currentPath = Astro.url.pathname;
const inlineNavItems = NAV_ITEMS.filter((n) => ['Blog', 'Projects', 'About'].includes(n.label));

function isNavActive(href: string): boolean {
  if (href.startsWith('http')) return false;
  if (href === '/') return currentPath === '/';
  if (href === '/blog/') {
    return currentPath === '/blog' || currentPath === '/blog/' || currentPath.startsWith('/posts/');
  }
  return currentPath.startsWith(href);
}
---

<header class="lg:hidden fixed top-0 left-0 right-0 z-40 border-b border-cream-200/85 dark:border-night-700/80
  bg-cream-50/92 dark:bg-night-900/92" style="backdrop-filter: blur(12px);">
  <div class="flex items-center justify-between px-4 h-14">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE_TITLE} Home`}>
      <BrandEmblem size="sm" />
      <span class="font-body font-bold text-sm text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 tracking-tight inline">{SITE_TITLE}</span>
    </a>

    <div class="flex items-center gap-2.5 sm:gap-3.5">
      <nav class="flex items-center gap-2.5 sm:gap-3.5" aria-label="Quick navigation">
        {inlineNavItems.map(({ label, href }) => {
          const isActive = isNavActive(href);
          return (
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-xs font-body transition-colors duration-150',
                isActive
                  ? 'text-terra dark:text-terra-light font-medium'
                  : 'text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light',
              ]}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <button
        id="search-trigger-mobile"
        data-search-trigger
        type="button"
        class="text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,transform] duration-150 cursor-pointer p-1 -m-1"
        aria-label="Search site"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>

      <button
        id="theme-toggle-mobile"
        type="button"
        class="text-ink-muted dark:text-silk-muted hover:text-gold-dark dark:hover:text-gold-light hover:rotate-12 active:scale-95 transition-[color,transform,rotate] duration-150 cursor-pointer p-1 -m-1"
        aria-label="Toggle dark mode"
      >
        <svg class="size-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="size-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,transform] duration-150 cursor-pointer p-1 -m-1"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Slide-down mobile menu (matches desktop Sidebar Vav bindu indicator) -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-terra/15 dark:border-gold/15 bg-cream-50/98 dark:bg-night-900/98 px-4 py-3"
    style="backdrop-filter: blur(12px);"
    aria-label="Mobile menu"
  >
    <div class="flex flex-col gap-0.5">
      {NAV_ITEMS.map(({ label, href }) => {
        const isActive = isNavActive(href);
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'group vav-row-hover flex items-center gap-3 px-2.5 py-2.5 text-[15px] font-body',
              isActive
                ? 'text-terra dark:text-terra-light font-medium'
                : 'text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light',
            ]}
          >
            <span
              class:list={[
                'vav-nav-diamond size-1.5 rounded-[1px] shrink-0',
                isActive
                  ? 'bg-terra dark:bg-terra-light ring-2 ring-gold/45 dark:ring-gold-light/40'
                  : 'bg-cream-300/75 dark:bg-night-700 group-hover:bg-terra dark:group-hover:bg-terra-light group-hover:ring-2 group-hover:ring-gold/40 dark:group-hover:ring-gold-light/35',
              ]}
              aria-hidden="true"
            />
            <span class="group-hover:translate-x-0.5 transition-transform duration-150">
              {label}
            </span>
          </a>
        );
      })}
    </div>

    <div class="pt-3 mt-2 border-t border-terra/15 dark:border-gold/15 flex items-center justify-around px-2">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 p-2 transition-[color,background-color,transform] duration-150" aria-label="GitHub">
        <SocialIcon name="github" class="size-4" />
      </a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 p-2 transition-[color,background-color,transform] duration-150" aria-label="X / Twitter">
        <SocialIcon name="x" class="size-4" />
      </a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 p-2 transition-[color,background-color,transform] duration-150" aria-label="LinkedIn">
        <SocialIcon name="linkedin" class="size-4" />
      </a>
      <a href={SOCIAL_LINKS.huggingface} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 p-2 transition-[color,background-color,transform] duration-150" aria-label="Hugging Face">
        <SocialIcon name="huggingface" class="size-4" />
      </a>
      <a href={SOCIAL_LINKS.email} class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 p-2 transition-[color,background-color,transform] duration-150" aria-label="Email">
        <SocialIcon name="email" class="size-4" />
      </a>
    </div>
  </nav>
</header>
