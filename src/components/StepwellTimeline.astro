---
export interface TimelineItem {
  period: string;
  role: string;
  organization: string;
  orgUrl?: string;
  description: string;
  current?: boolean;
}

interface Props {
  items: TimelineItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['stepwell-timeline', className]}>
  <ol class="stepwell-spine pl-8 space-y-7">
    {items.map((item, idx) => (
      <li class="reveal relative group" style={`--index: ${idx};`}>
        <div
          class:list={[
            'kolam-diamond-node timeline-node pointer-events-none -left-[27px] top-1.5 transition-colors',
            item.current
              ? 'border-terra dark:border-terra-light ring-2 ring-terra/20 dark:ring-terra-light/25'
              : 'group-hover:border-gold group-hover:ring-2 group-hover:ring-gold/25 dark:group-hover:ring-gold/30',
          ]}
          aria-hidden="true"
        />

        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-display text-lg text-ink dark:text-silk leading-snug">
            {item.role}{' '}
            <span class="text-ink-faint dark:text-silk-faint font-body font-normal text-sm">at</span>{' '}
            {item.orgUrl ? (
              <a
                href={item.orgUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-terra dark:text-terra-light hover:underline underline-offset-4 decoration-terra/40"
              >
                {item.organization}
              </a>
            ) : (
              <span class="text-terra dark:text-terra-light">{item.organization}</span>
            )}
          </h3>
          <span class="font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums shrink-0">
            {item.period}
          </span>
        </div>

        <p class="mt-2 max-w-[65ch] font-body text-sm sm:text-[15px] text-ink-light dark:text-silk-muted leading-relaxed text-pretty">
          {item.description}
        </p>
      </li>
    ))}
  </ol>
</div>

<style>
  .timeline-node {
    transition-duration: 75ms !important;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
</style>
