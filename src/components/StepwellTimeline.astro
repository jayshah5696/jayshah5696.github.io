---
import { getTagMicroPillClasses, getTagIndicator } from '../utils/tags';

export interface TimelineItem {
  period: string;
  role: string;
  organization: string;
  orgUrl?: string;
  description: string;
  highlights?: string[];
  tags?: string[];
  current?: boolean;
}

interface Props {
  items: TimelineItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['stepwell-timeline space-y-8', className]}>
  <div class="stepwell-spine pl-8 space-y-8">
    {items.map((item, idx) => (
      <div class="reveal relative group" style={`--index: ${idx};`}>
        <!-- Sacred Kolam Diamond Bindu Node on the dual rail -->
        <div
          class:list={[
            'kolam-diamond-node -left-[27px] top-6',
            item.current
              ? 'ring-4 ring-terra/25 dark:ring-terra-light/30 border-terra dark:border-terra-light scale-125'
              : 'group-hover:border-gold group-hover:ring-4 group-hover:ring-gold/20 dark:group-hover:ring-gold/25 group-hover:scale-125 transition-transform duration-150',
          ]}
          aria-hidden="true"
        />

        <!-- Timeline Milestone Card (Harmonized with featured-card & rangoli-corners) -->
        <article class="featured-card rangoli-corners p-5 sm:p-6 rounded-xl border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors duration-150">
          <!-- Card Header: Period and Active Pill -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <span class="font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums tracking-wider uppercase">
              {item.period}
            </span>
            {item.current && (
              <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase text-terra dark:text-terra-light px-2 py-0.5 rounded-full bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20 font-semibold" style="letter-spacing: 0.1em;">
                <span class="size-1.5 rounded-full bg-terra dark:bg-terra-light" />
                Current Role
              </span>
            )}
          </div>

          <!-- Role & Organization -->
          <h3 class="font-display text-lg sm:text-xl text-ink dark:text-silk leading-snug">
            {item.role}{' '}
            <span class="text-ink-faint dark:text-silk-faint font-sans font-light text-base">&bull;</span>{' '}
            {item.orgUrl ? (
              <a
                href={item.orgUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-terra dark:text-terra-light hover:underline underline-offset-4 decoration-terra/40"
              >
                {item.organization}
              </a>
            ) : (
              <span class="text-terra dark:text-terra-light">{item.organization}</span>
            )}
          </h3>

          <!-- Role Description -->
          <p class="mt-2.5 text-sm text-ink-light dark:text-silk-muted leading-relaxed text-pretty">
            {item.description}
          </p>

          <!-- Key Technical Highlights (if any) -->
          {item.highlights && item.highlights.length > 0 && (
            <div class="mt-4 pt-3.5 border-t border-cream-200/60 dark:border-night-700/60">
              <span class="block font-mono text-[10.5px] uppercase tracking-widest text-ink-faint dark:text-silk-faint mb-2">
                Technical Highlights:
              </span>
              <ul class="space-y-1.5 text-xs text-ink-muted dark:text-silk-muted">
                {item.highlights.map((highlight) => (
                  <li class="flex items-start gap-2">
                    <span class="text-terra dark:text-terra-light select-none font-bold mt-0.5">&rsaquo;</span>
                    <span class="leading-relaxed">{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Tag Pills -->
          {item.tags && item.tags.length > 0 && (
            <div class="mt-4 pt-3 border-t border-cream-200/40 dark:border-night-700/40 flex flex-wrap gap-1.5">
              {item.tags.map((tag) => (
                <span class={getTagMicroPillClasses(tag)}>
                  {getTagIndicator(tag) && (
                    <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
                  )}
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      </div>
    ))}
  </div>
</div>
