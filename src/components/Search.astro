---
// Desktop sidebar trigger for the global Pagefind SearchModal mounted in BaseLayout
---

<div>
  <button
    id="search-trigger"
    data-search-trigger
    type="button"
    class="flex items-center gap-2 w-full px-3 py-2 text-sm text-ink-muted dark:text-silk-muted
      bg-cream-100 dark:bg-night-800 border border-cream-200 dark:border-night-700
      rounded-lg hover:border-terra/40 dark:hover:border-terra-light/40 transition-colors cursor-pointer"
    aria-label="Search site"
  >
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <span class="font-mono text-xs">Search...</span>
    <kbd class="ml-auto font-mono text-[10px] px-1.5 py-0.5 rounded bg-cream-200 dark:bg-night-700 text-ink-faint dark:text-silk-faint">/</kbd>
  </button>
</div>
