---
import { render } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import SocialIcon from './SocialIcon.astro';
import { getTagMicroPillClasses, getTagIndicator, normalizeTagSlug } from '../utils/tags';

interface Props {
  entry: any;
  featured?: boolean;
  expanded?: boolean;
  index?: number;
}

const { entry, featured = false, expanded = false, index } = Astro.props;
const { title, url, date, tags } = entry.data;
const isFeatured = featured || Boolean(entry.data.featured);
const { Content } = await render(entry);
const normalizedTags = [...new Set((tags as string[]).map((tag) => normalizeTagSlug(tag)))];

let domain = '';
try {
  domain = new URL(url).hostname.replace('www.', '');
} catch (e) {
  domain = url;
}

const hasNotes = Boolean(entry.body && entry.body.trim().length > 0);
const year = date.getFullYear().toString();
const month = String(date.getMonth() + 1).padStart(2, '0');
---

<article
  class:list={[
    'reveal read-card-item featured-card rangoli-corners overflow-hidden transition-colors duration-150 relative p-4 sm:p-5 rounded-xl flex flex-col gap-2 group',
    hasNotes && 'cursor-pointer',
    isFeatured
      ? 'border-terra/30 dark:border-terra-light/20 hover:border-terra dark:hover:border-terra-light'
      : 'border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light',
  ]}
  style={index !== undefined ? `--index: ${Math.min(index, 5)};` : undefined}
  data-read-card
  data-tags={normalizedTags.join(',')}
  data-year={year}
  data-month={month}
  data-title={title.toLowerCase()}
  data-domain={domain.toLowerCase()}
  data-has-notes={hasNotes ? 'true' : 'false'}
  data-expanded={hasNotes && expanded ? 'true' : 'false'}
>
  {/* Optional Featured Read Pill */}
  {isFeatured && (
    <div class="mb-0.5">
      <span class="inline-block font-mono text-[10px] uppercase text-terra dark:text-terra-light px-2 py-0.5 rounded bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20" style="letter-spacing: 0.12em;">
        Featured Read
      </span>
    </div>
  )}

  <!-- Top Meta Line: Date • Domain • Inline Tags -->
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 font-mono text-[11px] text-ink-muted dark:text-silk-muted pr-6 relative z-10">
    <span class="inline-flex items-center gap-1 shrink-0">
      <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4m-5 4h18"/>
      </svg>
      <FormattedDate date={date} />
    </span>

    <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>

    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-gold-dark dark:text-gold-light hover:text-terra dark:hover:text-terra-light font-medium shrink-0 inline-flex items-center gap-1 hover:underline"
      title={`Open ${domain}`}
      onclick="event.stopPropagation();"
    >
      {domain}
      <SocialIcon name="external" class="size-3 opacity-70" />
    </a>

    {normalizedTags.length > 0 && (
      <>
        <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
        <div class="inline-flex flex-wrap items-center gap-1.5">
          {normalizedTags.map((tag: string) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class={getTagMicroPillClasses(tag)}
              data-tag-link={tag}
              onclick="event.stopPropagation();"
            >
              {getTagIndicator(tag) && (
                <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
              )}
              {tag}
            </a>
          ))}
        </div>
      </>
    )}
  </div>

  <!-- Title, Collapsible Note Chevron & External Link Icon -->
  <div class="flex items-start justify-between gap-3 relative z-10">
    <h3 class="font-display text-base sm:text-lg text-ink dark:text-silk leading-snug group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150">
      <span>{title}</span>
    </h3>

    <div class="flex items-center gap-1 shrink-0 -mt-0.5">
      {hasNotes && (
        <button
          type="button"
          class="read-card-toggle size-6 rounded-md hover:bg-cream-200 dark:hover:bg-night-800 text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light inline-flex items-center justify-center transition-colors duration-150 cursor-pointer active:scale-95"
          aria-expanded={expanded ? 'true' : 'false'}
          aria-label={expanded ? `Collapse notes for ${title}` : `Expand notes for ${title}`}
          title={expanded ? 'Collapse note' : 'Expand note'}
        >
          <svg
            class:list={[
              'read-card-chevron size-3.5 transition-transform duration-200',
              expanded && 'rotate-180',
            ]}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
      )}
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="size-6 rounded-md hover:bg-cream-200 dark:hover:bg-night-800 text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light inline-flex items-center justify-center transition-colors duration-150"
        title={`Open ${title} in new tab`}
        onclick="event.stopPropagation();"
      >
        <SocialIcon name="external" class="size-3.5" />
      </a>
    </div>
  </div>

  <!-- Smoothly Collapsible Commentary -->
  {hasNotes && (
    <div
      class="read-card-notes-collapse relative z-10"
      aria-hidden={expanded ? 'false' : 'true'}
      inert={!expanded ? true : undefined}
      onclick="event.stopPropagation();"
    >
      <div class="read-card-notes-inner">
        <div class="read-card-notes prose prose-kolam dark:prose-invert prose-sm max-w-none bg-cream-50/60 dark:bg-night-950/40 p-3.5 rounded-lg border border-cream-200/60 dark:border-night-700/60 mt-1 cursor-text select-text">
          <Content />
        </div>
      </div>
    </div>
  )}
</article>
