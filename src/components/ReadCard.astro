---
import { render } from 'astro:content';
import { normalizeTagSlug, getTagDotClass } from '../utils/tags';

interface Props {
  entry: any;
  featured?: boolean;
  expanded?: boolean;
  index?: number;
}

const { entry, expanded = false } = Astro.props;
const { title, url, date, tags } = entry.data;
const { Content } = await render(entry);
const normalizedTags = [...new Set((tags as string[]).map((tag) => normalizeTagSlug(tag)))];

let domain = '';
try {
  domain = new URL(url).hostname.replace(/^www\./, '');
} catch {
  domain = url;
}

const hasNotes = Boolean(entry.body && entry.body.trim().length > 0);
const year = date.getFullYear().toString();
const month = String(date.getMonth() + 1).padStart(2, '0');
const shortDate = date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article
  class:list={[
    'reveal read-card-item vav-row-hover group relative py-3.5 sm:py-4 px-2 -mx-2 border-b border-terra/15 dark:border-gold/15 last:border-b-0',
    hasNotes && 'cursor-pointer',
  ]}
  data-read-card
  data-tags={normalizedTags.join(',')}
  data-year={year}
  data-month={month}
  data-title={title.toLowerCase()}
  data-domain={domain.toLowerCase()}
  data-has-notes={hasNotes ? 'true' : 'false'}
  data-expanded={hasNotes && expanded ? 'true' : 'false'}
>
  <div class="min-w-0">
    <!-- Title directly opens the article, with inline arrow right beside the text -->
    <h3 class="font-body font-medium text-[16px] sm:text-[17px] text-ink dark:text-silk leading-snug">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="group/link inline hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
        onclick="event.stopPropagation();"
      >
        <span>{title}</span><span
          class="inline-block ml-1.5 font-mono text-xs text-ink-faint dark:text-silk-faint group-hover/link:text-terra dark:group-hover/link:text-terra-light group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-[color,transform] duration-150"
          aria-hidden="true"
        >&nearr;</span>
      </a>
    </h3>

    <!-- Meta row: domain · date · generous note toggle -->
    <div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
        onclick="event.stopPropagation();"
      >
        {domain}
      </a>
      <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
      <span>{shortDate}</span>
      {hasNotes && (
        <>
          <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
          <button
            type="button"
            class="read-card-toggle inline-flex items-center gap-1 text-terra/85 dark:text-terra-light/85 hover:text-terra dark:hover:text-terra-light transition-colors duration-150 cursor-pointer py-0.5 -my-0.5"
            aria-expanded={expanded ? 'true' : 'false'}
            aria-label={expanded ? `Hide notes for ${title}` : `Read notes for ${title}`}
          >
            <span class="read-card-toggle-label">{expanded ? 'hide note' : 'read note'}</span>
            <svg
              class:list={[
                'read-card-chevron size-3 transition-transform duration-150',
                expanded && 'rotate-180',
              ]}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
        </>
      )}
    </div>
  </div>

  {hasNotes && (
    <div
      class="read-card-notes-collapse"
      aria-hidden={expanded ? 'false' : 'true'}
      inert={!expanded ? true : undefined}
      onclick="event.stopPropagation();"
    >
      <div class="read-card-notes-inner">
        <div class="read-card-notes prose prose-kolam dark:prose-invert prose-sm max-w-[62ch] mt-3 px-3.5 sm:px-4 py-3 border-l-2 border-gold dark:border-gold-light bg-cream-200/45 dark:bg-[#1b1626] cursor-text select-text">
          <Content />
        </div>
        {normalizedTags.length > 0 && (
          <div class="mt-3 flex flex-wrap items-center gap-x-3.5 gap-y-1 font-mono text-[11px] text-ink-faint dark:text-silk-faint">
            {normalizedTags.map((tag: string) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
                data-tag-link={tag}
                onclick="event.stopPropagation();"
              >
                <span class:list={['size-1.5 rounded-full', getTagDotClass(tag)]} aria-hidden="true" />
                <span>#{tag}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  )}
</article>
