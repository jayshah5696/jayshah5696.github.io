---
import { render } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getTagMicroPillClasses, getTagIndicator } from '../utils/tags';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { title, url, date, tags } = entry.data;
const { Content } = await render(entry);

let domain = '';
try {
  domain = new URL(url).hostname.replace('www.', '');
} catch (e) {
  domain = url;
}

const hasNotes = Boolean(entry.body && entry.body.trim().length > 0);
const year = date.getFullYear().toString();
const month = String(date.getMonth() + 1).padStart(2, '0');
---

<article
  class="read-card-item featured-card border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors duration-200 relative p-4 sm:p-5 rounded-xl flex flex-col gap-2 cursor-pointer group"
  data-read-card
  data-tags={tags.join(',')}
  data-year={year}
  data-month={month}
  data-title={title.toLowerCase()}
  data-domain={domain.toLowerCase()}
  data-has-notes={hasNotes ? 'true' : 'false'}
>
  <!-- Top Meta Line: Date • Domain • Inline Tags -->
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 font-mono text-[11px] text-ink-muted dark:text-silk-muted pr-6">
    <span class="inline-flex items-center gap-1 shrink-0">
      <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4m-5 4h18"/>
      </svg>
      <FormattedDate date={date} />
    </span>

    <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
    
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-gold-dark dark:text-gold-light hover:text-terra dark:hover:text-terra-light font-medium shrink-0 inline-flex items-center gap-1 hover:underline"
      title={`Open ${domain}`}
      onclick="event.stopPropagation();"
    >
      {domain}
      <svg class="size-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>

    {tags.length > 0 && (
      <>
        <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
        <div class="inline-flex flex-wrap items-center gap-1.5">
          {tags.map((tag: string) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class={getTagMicroPillClasses(tag)}
              data-tag-link={tag}
              onclick="event.stopPropagation();"
            >
              {getTagIndicator(tag) && (
                <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
              )}
              {tag}
            </a>
          ))}
        </div>
      </>
    )}
  </div>

  <!-- Title & External Link Icon -->
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-base sm:text-lg text-ink dark:text-silk leading-snug group-hover:text-terra dark:group-hover:text-terra-light transition-colors">
      <span>{title}</span>
    </h3>

    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="size-6 rounded-md hover:bg-cream-200 dark:hover:bg-night-800 text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light inline-flex items-center justify-center transition-colors shrink-0 -mt-0.5"
      title={`Open ${title} in new tab`}
      onclick="event.stopPropagation();"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </div>

  <!-- Commentary (Markdown Body - Click card to expand/collapse) -->
  {hasNotes && (
    <div
      class="read-card-notes hidden prose prose-kolam dark:prose-invert prose-sm max-w-none bg-cream-50/60 dark:bg-night-950/40 p-3.5 rounded-lg border border-cream-200/60 dark:border-night-700/60 mt-1 cursor-text select-text"
      onclick="event.stopPropagation();"
    >
      <Content />
    </div>
  )}
</article>
