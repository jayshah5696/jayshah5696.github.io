---
import { getTagDotClass } from '../utils/tags';

interface Props {
  title: string;
  script?: string;
  summary?: string;
  description: string;
  url: string;
  tags?: string[];
  index?: number;
  class?: string;
  headingTag?: 'h2' | 'h3';
}

const {
  title,
  script,
  summary,
  description,
  url,
  tags = [],
  index = 0,
  class: className = '',
  headingTag = 'h2',
} = Astro.props;

const HeadingTag = headingTag;
const text = summary || description;
const dotClass = tags.length > 0 ? getTagDotClass(tags[0]) : 'bg-terra dark:bg-terra-light';
const indexLabel = String(index + 1).padStart(2, '0');

// Avoid repeating Indic script inside the title when already displayed as the carved corner watermark
const cleanTitle = script
  ? title.replace(/\s*\([^)]*\)\s*/g, ' ').replace(/\s+/g, ' ').trim()
  : title;

let nonGithubPlatform = '';
if (url.includes('huggingface.co')) {
  nonGithubPlatform = 'HF';
} else if (url.includes('devpost.com')) {
  nonGithubPlatform = 'Devpost';
} else if (!url.includes('github.com')) {
  nonGithubPlatform = 'Web';
}
---

<article
  class:list={[
    'group vav-cell flex flex-col justify-start p-4 sm:p-6 min-h-[132px] sm:min-h-[152px]',
    className,
  ]}
>
  <div class="relative z-10 flex items-center justify-between gap-3 mb-3.5 sm:mb-5">
    <span class="inline-flex items-center gap-2 font-mono text-[11px] text-ink-faint dark:text-silk-faint tabular-nums">
      <span class:list={['size-1.5 rounded-full shrink-0 opacity-85 group-hover:opacity-100 transition-opacity duration-150', dotClass]} aria-hidden="true" />
      <span>{indexLabel}</span>
    </span>

    <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-ink-faint dark:text-silk-faint shrink-0">
      {nonGithubPlatform && <span>{nonGithubPlatform}</span>}
      <span
        class="inline-block group-hover:text-terra dark:group-hover:text-terra-light group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-[color,transform] duration-150"
        aria-hidden="true"
      >
        &nearr;
      </span>
    </span>
  </div>

  <div class="relative z-10">
    <HeadingTag class="font-body font-medium text-[16px] sm:text-[17px] text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 leading-snug">
      <a href={url} target="_blank" rel="noopener noreferrer">
        <span class="absolute inset-0 z-0" aria-hidden="true"></span>
        {cleanTitle}
      </a>
    </HeadingTag>

    <p class="mt-2 font-body text-sm text-ink-muted dark:text-silk-muted leading-relaxed text-pretty max-w-[34ch]">
      {text}
    </p>
  </div>

  {script ? (
    <span class="lattice-glyph-wm" aria-hidden="true">{script}</span>
  ) : (
    <span class="lattice-bindu-wm" aria-hidden="true" />
  )}
</article>
