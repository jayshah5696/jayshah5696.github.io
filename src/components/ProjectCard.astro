---
import SocialIcon from './SocialIcon.astro';
import { getTagMicroPillClasses, getTagIndicator } from '../utils/tags';

interface Props {
  title: string;
  description: string;
  url: string;
  tags: string[];
  featured?: boolean;
}

const { title, description, url, tags = [], featured = false } = Astro.props;

let platform: 'github' | 'huggingface' | 'devpost' | 'external' = 'external';
let platformLabel = 'Project';

if (url.includes('github.com')) {
  platform = 'github';
  platformLabel = 'GitHub';
} else if (url.includes('huggingface.co')) {
  platform = 'huggingface';
  platformLabel = 'Hugging Face';
} else if (url.includes('devpost.com')) {
  platform = 'devpost';
  platformLabel = 'Devpost';
}
---

<article class:list={[
  'group relative rounded-xl border overflow-hidden transition-all duration-200 featured-card rangoli-corners hover:-translate-y-1 flex flex-col justify-between p-5',
  featured
    ? 'border-terra/30 dark:border-terra-light/20 hover:border-terra dark:hover:border-terra-light hover:shadow-lg shadow-sm'
    : 'border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light hover:shadow-md',
]}>
  <div>
    <!-- Optional Featured Badge -->
    {featured && (
      <div class="mb-2">
        <span class="inline-block font-mono text-[10px] uppercase text-terra dark:text-terra-light px-2 py-0.5 rounded bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20" style="letter-spacing: 0.12em;">
          Featured Project
        </span>
      </div>
    )}

    <!-- Title & External Link Header -->
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-lg text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-200 text-balance leading-snug">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-terra dark:hover:text-terra-light"
        >
          <span class="absolute inset-0 z-0" aria-hidden="true"></span>
          {title}
        </a>
      </h3>

      <div class="text-ink-faint dark:text-silk-faint group-hover:text-terra dark:group-hover:text-terra-light transition-colors shrink-0 mt-0.5">
        <SocialIcon name={platform} class="size-4" />
      </div>
    </div>

    <!-- Description -->
    <p class="mt-2 text-sm text-ink-light dark:text-silk-muted text-pretty line-clamp-3 leading-relaxed">
      {description}
    </p>

    <!-- Tag Pills -->
    {tags.length > 0 && (
      <div class="mt-3.5 relative z-10 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}
            class={getTagMicroPillClasses(tag)}
          >
            {getTagIndicator(tag) && (
              <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
            )}
            {tag}
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom Platform / Action Bar -->
  <div class="flex items-center justify-between gap-2 mt-4 pt-3.5 border-t border-cream-200/50 dark:border-night-700/60 text-ink-muted dark:text-silk-faint text-xs relative z-10">
    <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-ink-faint dark:text-silk-faint">
      <SocialIcon name={platform} class="size-3.5 text-terra dark:text-terra-light" />
      {platformLabel}
    </span>

    <div class="inline-flex items-center text-terra dark:text-terra-light font-medium text-xs whitespace-nowrap transition-all duration-200 group-hover:translate-x-1 opacity-80 group-hover:opacity-100">
      <span class="mr-1">View code &rarr;</span>
    </div>
  </div>
</article>
