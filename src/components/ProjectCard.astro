---
import SocialIcon from './SocialIcon.astro';
import { getTagMicroPillClasses, getTagIndicator } from '../utils/tags';

interface Props {
  title: string;
  description: string;
  url: string;
  tags: string[];
  featured?: boolean;
  flagship?: boolean;
  metrics?: { label: string; value: string }[];
  index?: number;
  class?: string;
}

const {
  title,
  description,
  url,
  tags = [],
  featured = false,
  flagship = false,
  index,
  class: className = '',
} = Astro.props;

let platform: 'github' | 'huggingface' | 'devpost' | 'external' = 'external';
let platformLabel = 'Project';

if (url.includes('github.com')) {
  platform = 'github';
  platformLabel = 'GitHub';
} else if (url.includes('huggingface.co')) {
  platform = 'huggingface';
  platformLabel = 'Hugging Face';
} else if (url.includes('devpost.com')) {
  platform = 'devpost';
  platformLabel = 'Devpost';
}
---

<article
  class:list={[
    'reveal group relative rounded-xl border overflow-hidden transition-colors duration-150 featured-card rangoli-corners flex flex-col justify-between',
    flagship
      ? 'p-6 sm:p-7 border-terra/30 dark:border-terra-light/25 bg-cream-50/95 dark:bg-night-800/95 hover:border-terra dark:hover:border-terra-light hover:shadow-md'
      : featured
        ? 'p-5 border-terra/30 dark:border-terra-light/20 hover:border-terra dark:hover:border-terra-light hover:shadow-sm'
        : 'p-5 border-cream-200 dark:border-night-700 bg-white dark:bg-night-800 hover:border-terra dark:hover:border-terra-light',
    className,
  ]}
>
  <div>
    <!-- Flagship or Featured Badge -->
    {flagship ? (
      <div class="mb-3 flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase text-terra dark:text-terra-light px-2.5 py-0.5 rounded-full bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20 font-semibold" style="letter-spacing: 0.12em;">
          &#9733; Flagship System
        </span>
        <span class="font-mono text-[10px] text-mor dark:text-mor-light flex items-center gap-1.5 font-medium">
          <span class="size-1.5 rounded-full bg-mor dark:bg-mor-light animate-pulse" />
          Active Open-Source
        </span>
      </div>
    ) : featured ? (
      <div class="mb-2">
        <span class="inline-block font-mono text-[10px] uppercase text-terra dark:text-terra-light px-2 py-0.5 rounded bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20" style="letter-spacing: 0.12em;">
          Featured Project
        </span>
      </div>
    ) : null}

    <!-- Title & External Link Header -->
    <div class="flex items-start justify-between gap-2">
      <h3 class:list={[
        'font-display text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 text-balance leading-snug',
        flagship ? 'text-xl sm:text-2xl' : 'text-base sm:text-lg',
      ]}>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-terra dark:hover:text-terra-light"
        >
          <span class="absolute inset-0 z-0" aria-hidden="true"></span>
          {title}
        </a>
      </h3>

      <div class="text-ink-faint dark:text-silk-faint group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 shrink-0 mt-0.5">
        <SocialIcon name={platform} class="size-4" />
      </div>
    </div>

    <!-- Description -->
    <p class:list={[
      'mt-2 text-ink-light dark:text-silk-muted text-pretty leading-relaxed',
      flagship ? 'text-sm sm:text-base max-w-3xl' : 'text-sm line-clamp-3',
    ]}>
      {description}
    </p>

    <!-- Tag Micro-Pills -->
    {tags.length > 0 && (
      <div class="mt-3 relative z-10 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}
            class={getTagMicroPillClasses(tag)}
          >
            {getTagIndicator(tag) && (
              <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
            )}
            {tag}
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom Platform / Action Bar -->
  <div class="flex items-center justify-between gap-2 mt-4 pt-3 border-t border-cream-200/50 dark:border-night-700/60 text-ink-muted dark:text-silk-faint text-xs relative z-10">
    <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-ink-faint dark:text-silk-faint">
      <SocialIcon name={platform} class="size-3.5 opacity-80" />
      {platformLabel}
    </span>
    <span class="inline-flex items-center gap-1 text-terra dark:text-terra-light font-medium text-xs group-hover:translate-x-0.5 transition-transform duration-150">
      View repository &rarr;
    </span>
  </div>
</article>
