---
interface Props {
  variant?: 'standard' | 'compact';
  class?: string;
}

const {
  variant = 'standard',
  class: className = '',
} = Astro.props;

const uid = Math.random().toString(36).substring(2, 7);
const maskId = `kolam-fade-${uid}`;
const gradId = `kolam-grad-${uid}`;
---

<div class:list={['relative w-full flex items-center select-none', className]}>
  {variant === 'compact' ? (
    <svg viewBox="0 0 240 20" fill="none" class="w-full h-5 block" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="white" stop-opacity="0"/>
          <stop offset="10%" stop-color="white" stop-opacity="1"/>
          <stop offset="90%" stop-color="white" stop-opacity="1"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </linearGradient>
        <mask id={maskId}>
          <rect width="240" height="20" fill={`url(#${gradId})`}/>
        </mask>
      </defs>

      <g mask={`url(#${maskId})`}>
        <path
          class="wave-terra-strand text-terra dark:text-terra-light stroke-current"
          d="M 0 10 Q 15 2, 30 2 Q 45 2, 60 10 Q 75 18, 90 18 Q 105 18, 120 10 Q 135 2, 150 2 Q 165 2, 180 10 Q 195 18, 210 18 Q 225 18, 240 10"
          stroke-width="1.1"
          stroke-linecap="round"
        />
        <path
          class="wave-gold-strand text-gold dark:text-gold-light stroke-current"
          d="M 0 10 Q 15 18, 30 18 Q 45 18, 60 10 Q 75 2, 90 2 Q 105 2, 120 10 Q 135 18, 150 18 Q 165 18, 180 10 Q 195 2, 210 2 Q 225 2, 240 10"
          stroke-width="1.1"
          stroke-linecap="round"
        />
        <circle cx="60" cy="10" r="1.4" class="fill-terra dark:fill-terra-light" opacity="0.55"/>
        <circle cx="120" cy="10" r="1.4" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="180" cy="10" r="1.4" class="fill-terra dark:fill-terra-light" opacity="0.55"/>
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 640 24" fill="none" class="w-full h-6 block" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="white" stop-opacity="0"/>
          <stop offset="8%" stop-color="white" stop-opacity="1"/>
          <stop offset="92%" stop-color="white" stop-opacity="1"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </linearGradient>
        <mask id={maskId}>
          <rect width="640" height="24" fill={`url(#${gradId})`}/>
        </mask>
      </defs>

      <g mask={`url(#${maskId})`}>
        <path
          class="wave-terra-strand text-terra dark:text-terra-light stroke-current"
          d="M 0 12 Q 20 2, 40 2 Q 60 2, 80 12 Q 100 22, 120 22 Q 140 22, 160 12 Q 180 2, 200 2 Q 220 2, 240 12 Q 260 22, 280 22 Q 300 22, 320 12 Q 340 2, 360 2 Q 380 2, 400 12 Q 420 22, 440 22 Q 460 22, 480 12 Q 500 2, 520 2 Q 540 2, 560 12 Q 580 22, 600 22 Q 620 22, 640 12"
          stroke-width="1.1"
          stroke-linecap="round"
        />
        <path
          class="wave-gold-strand text-gold dark:text-gold-light stroke-current"
          d="M 0 12 Q 20 22, 40 22 Q 60 22, 80 12 Q 100 2, 120 2 Q 140 2, 160 12 Q 180 22, 200 22 Q 220 22, 240 12 Q 260 2, 280 2 Q 300 2, 320 12 Q 340 22, 360 22 Q 380 22, 400 12 Q 420 2, 440 2 Q 460 2, 480 12 Q 500 22, 520 22 Q 540 22, 560 12 Q 580 2, 600 2 Q 620 2, 640 12"
          stroke-width="1.1"
          stroke-linecap="round"
        />
        <circle cx="80" cy="12" r="1.5" class="fill-terra dark:fill-terra-light" opacity="0.55"/>
        <circle cx="160" cy="12" r="1.5" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="240" cy="12" r="1.5" class="fill-terra dark:fill-terra-light" opacity="0.55"/>
        <circle cx="320" cy="12" r="1.5" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="400" cy="12" r="1.5" class="fill-terra dark:fill-terra-light" opacity="0.55"/>
        <circle cx="480" cy="12" r="1.5" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="560" cy="12" r="1.5" class="fill-terra dark:fill-terra-light" opacity="0.55"/>
      </g>
    </svg>
  )}
</div>

<style>
  .wave-terra-strand {
    animation: kolamBreathTerra 7s ease-in-out infinite;
  }

  .wave-gold-strand {
    animation: kolamBreathGold 7s ease-in-out infinite;
  }

  @keyframes kolamBreathTerra {
    0%, 100% {
      opacity: 0.34;
      stroke-width: 0.9px;
    }
    50% {
      opacity: 0.78;
      stroke-width: 1.35px;
    }
  }

  @keyframes kolamBreathGold {
    0%, 100% {
      opacity: 0.78;
      stroke-width: 1.35px;
    }
    50% {
      opacity: 0.34;
      stroke-width: 0.9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-terra-strand,
    .wave-gold-strand {
      animation: none !important;
      opacity: 0.55;
    }
  }
</style>
