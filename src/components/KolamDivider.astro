---
interface Props {
  variant?: 'standard' | 'compact';
  class?: string;
}

const {
  variant = 'standard',
  class: className = '',
} = Astro.props;

const uid = Math.random().toString(36).substring(2, 7);
const maskId = `kolam-fade-${uid}`;
const gradId = `kolam-grad-${uid}`;
---

<div class:list={['relative w-full flex items-center select-none', className]}>
  {variant === 'compact' ? (
    <svg viewBox="0 0 240 24" fill="none" class="w-full h-6 block" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="white" stop-opacity="0"/>
          <stop offset="8%" stop-color="white" stop-opacity="1"/>
          <stop offset="92%" stop-color="white" stop-opacity="1"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </linearGradient>
        <mask id={maskId}>
          <rect width="240" height="24" fill={`url(#${gradId})`}/>
        </mask>
      </defs>

      <g mask={`url(#${maskId})`}>
        <path
          class="wave-terra-strand text-terra dark:text-terra-light stroke-current"
          d="M 0 12 Q 15 2, 30 2 Q 45 2, 60 12 Q 75 22, 90 22 Q 105 22, 120 12 Q 135 2, 150 2 Q 165 2, 180 12 Q 195 22, 210 22 Q 225 22, 240 12"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <path
          class="wave-gold-strand text-gold dark:text-gold-light stroke-current"
          d="M 0 12 Q 15 22, 30 22 Q 45 22, 60 12 Q 75 2, 90 2 Q 105 2, 120 12 Q 135 22, 150 22 Q 165 22, 180 12 Q 195 2, 210 2 Q 225 2, 240 12"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <circle cx="60" cy="12" r="1.5" class="fill-terra dark:fill-terra-light" opacity="0.6"/>
        <circle cx="120" cy="12" r="1.5" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="180" cy="12" r="1.5" class="fill-terra dark:fill-terra-light" opacity="0.6"/>
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 640 28" fill="none" class="w-full h-7 block" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="white" stop-opacity="0"/>
          <stop offset="5%" stop-color="white" stop-opacity="1"/>
          <stop offset="95%" stop-color="white" stop-opacity="1"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </linearGradient>
        <mask id={maskId}>
          <rect width="640" height="28" fill={`url(#${gradId})`}/>
        </mask>
      </defs>

      <g mask={`url(#${maskId})`}>
        <path
          class="wave-terra-strand text-terra dark:text-terra-light stroke-current"
          d="M 0 14 Q 20 2, 40 2 Q 60 2, 80 14 Q 100 26, 120 26 Q 140 26, 160 14 Q 180 2, 200 2 Q 220 2, 240 14 Q 260 26, 280 26 Q 300 26, 320 14 Q 340 2, 360 2 Q 380 2, 400 14 Q 420 26, 440 26 Q 460 26, 480 14 Q 500 2, 520 2 Q 540 2, 560 14 Q 580 26, 600 26 Q 620 26, 640 14"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <path
          class="wave-gold-strand text-gold dark:text-gold-light stroke-current"
          d="M 0 14 Q 20 26, 40 26 Q 60 26, 80 14 Q 100 2, 120 2 Q 140 2, 160 14 Q 180 26, 200 26 Q 220 26, 240 14 Q 260 2, 280 2 Q 300 2, 320 14 Q 340 26, 360 26 Q 380 26, 400 14 Q 420 2, 440 2 Q 460 2, 480 14 Q 500 26, 520 26 Q 540 26, 560 14 Q 580 2, 600 2 Q 620 2, 640 14"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <circle cx="80" cy="14" r="1.8" class="fill-terra dark:fill-terra-light" opacity="0.6"/>
        <circle cx="160" cy="14" r="1.8" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="240" cy="14" r="1.8" class="fill-terra dark:fill-terra-light" opacity="0.6"/>
        <circle cx="320" cy="14" r="1.8" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="400" cy="14" r="1.8" class="fill-terra dark:fill-terra-light" opacity="0.6"/>
        <circle cx="480" cy="14" r="1.8" class="fill-gold dark:fill-gold-light" opacity="0.6"/>
        <circle cx="560" cy="14" r="1.8" class="fill-terra dark:fill-terra-light" opacity="0.6"/>
      </g>
    </svg>
  )}
</div>

<style>
  .wave-terra-strand {
    animation: waveBreatheTerra 4.5s ease-in-out infinite alternate;
  }

  .wave-gold-strand {
    animation: waveBreatheGold 4.5s ease-in-out infinite alternate;
  }

  @keyframes waveBreatheTerra {
    0% {
      opacity: 0.35;
      stroke-width: 0.9px;
    }
    50% {
      opacity: 0.95;
      stroke-width: 1.5px;
    }
    100% {
      opacity: 0.35;
      stroke-width: 0.9px;
    }
  }

  @keyframes waveBreatheGold {
    0% {
      opacity: 0.95;
      stroke-width: 1.5px;
    }
    50% {
      opacity: 0.35;
      stroke-width: 0.9px;
    }
    100% {
      opacity: 0.95;
      stroke-width: 1.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-terra-strand,
    .wave-gold-strand {
      animation: none !important;
    }
  }
</style>
