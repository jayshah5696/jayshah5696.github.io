---
import FormattedDate from './FormattedDate.astro';
import readingTime from 'reading-time';

interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
  tags?: string[];
  body: string;
  image?: string;
  featured?: boolean;
  interactive?: boolean;
  index?: number;
  headingTag?: 'h2' | 'h3';
}

const {
  title,
  date,
  description,
  slug,
  body,
  image,
  interactive = false,
  headingTag = 'h2',
} = Astro.props;

const HeadingTag = headingTag;
const stats = readingTime(body);
---

<article class="reveal group relative featured-card vav-plate-ticks overflow-hidden">
  <div class="grid grid-cols-1 sm:grid-cols-12 items-stretch relative z-10">
    {image && (
      <div class="sm:col-span-5 aspect-[16/9] sm:aspect-auto sm:min-h-[216px] bg-cream-100 dark:bg-night-900 border-b sm:border-b-0 sm:border-r border-terra/15 dark:border-gold/15 overflow-hidden">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover card-hover-zoom"
          loading="eager"
        />
      </div>
    )}
    <div class:list={['p-4 sm:p-6 flex flex-col justify-between gap-3 sm:gap-4', image ? 'sm:col-span-7' : 'sm:col-span-12']}>
      <div>
        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums mb-2.5 sm:mb-3">
          <span class="whitespace-nowrap"><FormattedDate date={date} /></span>
          <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
          <span class="whitespace-nowrap">{stats.text}</span>
          {interactive && (
            <>
              <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
              <span class="inline-flex items-center gap-1.5 text-mor dark:text-mor-light whitespace-nowrap">
                <span class="size-1.5 rounded-full bg-mor dark:bg-mor-light" aria-hidden="true" />
                lab
              </span>
            </>
          )}
        </div>

        <HeadingTag class="font-display text-xl sm:text-2xl text-ink dark:text-silk leading-snug group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 text-balance">
          <a href={`/posts/${slug}/`}>
            <span class="absolute inset-0 z-0" aria-hidden="true"></span>
            {title}
          </a>
        </HeadingTag>

        <p class="mt-2.5 font-body text-sm sm:text-[15px] text-ink-light dark:text-silk-muted leading-relaxed line-clamp-4 text-pretty">
          {description}
        </p>
      </div>
    </div>
  </div>
</article>
