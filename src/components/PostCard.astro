---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import readingTime from 'reading-time';

interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
  tags: string[];
  body: string;
  image?: string;
  featured?: boolean;
}

const { title, date, description, slug, tags = [], body, image, featured = false } = Astro.props;
const stats = readingTime(body);
---

<article class:list={[
  'group relative rounded-xl border overflow-hidden transition-all duration-200 featured-card rangoli-corners hover:-translate-y-1',
  featured
    ? 'border-terra/30 dark:border-terra-light/20 hover:border-terra dark:hover:border-terra-light hover:shadow-lg shadow-sm'
    : 'border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light hover:shadow-md',
]}>
  {featured ? (
    <div class="flex flex-col">
      {/* Featured Card Layout (Vertical Full Banner) */}
      {image && (
        <div class="w-full h-[200px] sm:h-[220px] overflow-hidden bg-cream-100 dark:bg-night-900 border-b border-cream-200/60 dark:border-night-700/60">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
        </div>
      )}

      <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
        <div>
          <span class="inline-block font-mono text-[10px] uppercase text-terra dark:text-terra-light mb-2.5 px-2 py-0.5 rounded bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20" style="letter-spacing: 0.12em;">
            Latest
          </span>
          <h3 class="font-display text-xl sm:text-2xl text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-200 text-balance leading-snug">
            <a href={`/posts/${slug}/`} class="hover:text-terra dark:hover:text-terra-light">
              <span class="absolute inset-0 z-0" aria-hidden="true"></span>
              {title}
            </a>
          </h3>
          <p class="mt-2 text-sm sm:text-base text-ink-light dark:text-silk-muted text-pretty line-clamp-3 leading-relaxed">
            {description}
          </p>
          {tags.length > 0 && (
            <div class="mt-3.5 relative z-10">
              <TagList tags={tags} max={6} postSlug={slug} variant="micro" />
            </div>
          )}
        </div>

        <div class="flex flex-wrap items-center justify-between gap-y-2 mt-4 sm:mt-5 pt-3.5 border-t border-cream-200/50 dark:border-night-700/60 text-ink-muted dark:text-silk-faint text-xs">
          <div class="flex items-center gap-2 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4m-5 4h18"/></svg>
              <FormattedDate date={date} />
            </span>
            <span class="text-cream-400 dark:text-night-700 select-none">&bull;</span>
            <span class="font-mono tabular-nums">{stats.text}</span>
          </div>

          <div class="inline-flex items-center text-terra dark:text-terra-light font-medium text-xs sm:text-sm whitespace-nowrap transition-all duration-200 group-hover:translate-x-1 opacity-80 group-hover:opacity-100">
            <span class="mr-1">Read article</span>
            <svg class="size-3.5 sm:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="flex flex-col sm:flex-row items-stretch justify-between p-4 sm:p-5 gap-4 sm:gap-5">
      {/* Non-Featured Card Layout (Banner on Mobile, Horizontal Row on Desktop) */}
      {/* Text column (order-2 on mobile, order-1 on desktop) */}
      <div class="flex-1 min-w-0 flex flex-col justify-between order-2 sm:order-1">
        <div>
          <h3 class="font-display text-lg text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-200 text-balance leading-snug">
            <a href={`/posts/${slug}/`} class="hover:text-terra dark:hover:text-terra-light">
              <span class="absolute inset-0 z-0" aria-hidden="true"></span>
              {title}
            </a>
          </h3>
          <p class="mt-1.5 text-sm text-ink-light dark:text-silk-muted text-pretty line-clamp-2 leading-relaxed">
            {description}
          </p>
          {tags.length > 0 && (
            <div class="mt-3 relative z-10">
              <TagList tags={tags} max={4} postSlug={slug} variant="micro" />
            </div>
          )}
        </div>

        <div class="flex flex-wrap items-center justify-between gap-y-2 mt-4 pt-3 border-t border-cream-200/50 dark:border-night-700/60 text-ink-muted dark:text-silk-faint text-xs">
          <div class="flex items-center gap-2 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4m-5 4h18"/></svg>
              <FormattedDate date={date} />
            </span>
            <span class="text-cream-400 dark:text-night-700 select-none">&bull;</span>
            <span class="font-mono tabular-nums">{stats.text}</span>
          </div>

          <div class="inline-flex items-center text-terra dark:text-terra-light font-medium text-xs sm:text-sm whitespace-nowrap transition-all duration-200 group-hover:translate-x-1 opacity-80 group-hover:opacity-100">
            <span class="mr-1">Read article</span>
            <svg class="size-3.5 sm:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
      </div>

      {/* Image thumbnail (order-1 on mobile = top banner, order-2 on desktop = right sidebar) */}
      {image && (
        <div class="w-full sm:w-[190px] md:w-[210px] h-[140px] sm:h-auto sm:min-h-[125px] shrink-0 order-1 sm:order-2 flex items-center justify-center">
          <div class="w-full h-full max-h-[140px] sm:max-h-[135px] rounded-lg overflow-hidden border border-cream-200/80 dark:border-night-700/80 bg-cream-100/50 dark:bg-night-900/60 shadow-xs">
            <img
              src={image}
              alt={title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        </div>
      )}
    </div>
  )}
</article>
