---
/**
 * FontEvaluator.astro
 * Interactive typography workbench for comparing font pairings live on the homepage.
 * Zero-framework vanilla script with localStorage persistence.
 */

interface Preset {
  id: string;
  name: string;
  badge: string;
  display: string;
  body: string;
  mono: string;
  displayFamily: string;
  bodyFamily: string;
  monoFamily: string;
  desc: string;
  origin: string;
}

const presets: Preset[] = [
  {
    id: 'current',
    name: 'Kolam Classic',
    badge: 'Baseline (Current)',
    display: 'Yeseva One',
    body: 'Outfit',
    mono: 'Fira Code',
    displayFamily: "'Yeseva One', Georgia, serif",
    bodyFamily: "'Outfit Variable', 'Outfit', system-ui, sans-serif",
    monoFamily: "'Fira Code', Menlo, monospace",
    desc: 'The original identity: high-contrast sculpted display serif paired with friendly geometric sans.',
    origin: 'Jovanny Lemonad & Rodrigo Fuenzalida',
  },
  {
    id: 'libron-pure',
    name: 'Libron Monograph',
    badge: 'Pure Libron Serif',
    display: 'Libron (Bold)',
    body: 'Libron (Regular)',
    mono: 'Fira Code',
    displayFamily: "'Libron', Georgia, serif",
    bodyFamily: "'Libron', Georgia, serif",
    monoFamily: "'Fira Code', Menlo, monospace",
    desc: 'Pure literary & monograph feel. Tuned specifically for e-ink and digital screens, providing effortless long-form reading.',
    origin: 'Nico Verbruggen (derived from Production Type Newsreader)',
  },
  {
    id: 'editorial-scholar',
    name: 'Editorial Scholar',
    badge: 'Recommended Hybrid',
    display: 'Yeseva One',
    body: 'Libron (Regular)',
    mono: 'Fira Code',
    displayFamily: "'Yeseva One', Georgia, serif",
    bodyFamily: "'Libron', Georgia, serif",
    monoFamily: "'Fira Code', Menlo, monospace",
    desc: 'Preserves your signature carved headings while upgrading body text to bookish, paper-like reading serif.',
    origin: 'Yeseva One + Libron',
  },
  {
    id: 'research-press',
    name: 'Modern Research Press',
    badge: 'Contemporary Publishing',
    display: 'Plus Jakarta Sans',
    body: 'Libron (Regular)',
    mono: 'Fira Code',
    displayFamily: "'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, sans-serif",
    bodyFamily: "'Libron', Georgia, serif",
    monoFamily: "'Fira Code', Menlo, monospace",
    desc: 'Modern university / research press aesthetic (like MIT Press or Quanta). Sharp modern sans headings with serif prose.',
    origin: 'Tokotype & Nico Verbruggen',
  },
  {
    id: 'frontier-ai',
    name: 'Frontier AI Engineer',
    badge: 'Linear / Vercel Precision',
    display: 'Geist (SemiBold)',
    body: 'Geist (Regular)',
    mono: 'Geist Mono',
    displayFamily: "'Geist Variable', 'Geist', system-ui, sans-serif",
    bodyFamily: "'Geist Variable', 'Geist', system-ui, sans-serif",
    monoFamily: "'Geist Mono', Menlo, monospace",
    desc: 'Ultra-crisp, mathematical precision used across frontier AI infrastructure. Highly legible technical neo-grotesque.',
    origin: 'Vercel & Basement Studio',
  },
  {
    id: 'academic-literata',
    name: 'Literata Academic',
    badge: 'Digital Bookish',
    display: 'Literata (Bold)',
    body: 'Literata (Regular)',
    mono: 'JetBrains Mono',
    displayFamily: "'Literata Variable', 'Literata', Georgia, serif",
    bodyFamily: "'Literata Variable', 'Literata', Georgia, serif",
    monoFamily: "'JetBrains Mono', Menlo, monospace",
    desc: 'Google Books commissioned reading typeface with organic stroke cadence, paired with JetBrains Mono.',
    origin: 'TypeTogether (Veronika Burian & José Scaglione)',
  },
];
---

<div id="font-evaluator-wrapper" class="reveal mb-10 transition-all duration-200">
  <!-- Main Workbench Card -->
  <div class="relative rounded-xl border border-terra/30 dark:border-terra-light/20 bg-cream-100/90 dark:bg-night-800/90 backdrop-blur-sm shadow-md overflow-hidden p-5 sm:p-6 rangoli-corners">
    
    <!-- Header row -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-cream-200 dark:border-night-700">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center justify-center size-6 rounded-md bg-terra/10 dark:bg-terra-light/10 text-terra dark:text-terra-light border border-terra/20 dark:border-terra-light/20">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 7 4 4 20 4 20 7"></polyline>
            <line x1="9" y1="20" x2="15" y2="20"></line>
            <line x1="12" y1="4" x2="12" y2="20"></line>
          </svg>
        </span>
        <div>
          <h3 class="text-xs sm:text-sm font-mono uppercase tracking-wider font-semibold text-ink dark:text-silk flex items-center gap-2">
            Typography Evaluation Lab
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-gold/15 dark:bg-gold-light/15 text-gold-dark dark:text-gold-light border border-gold/30">
              Live Preview
            </span>
          </h3>
          <p class="text-xs text-ink-muted dark:text-silk-muted mt-0.5">
            Click any option below to instantly re-render the entire homepage in that font pairing.
          </p>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 text-xs font-mono">
        <button
          type="button"
          id="toggle-specimen-drawer"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-cream-300 dark:border-night-700 hover:border-terra dark:hover:border-terra-light text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light bg-cream-50 dark:bg-night-900 transition-colors"
        >
          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M12 3v18"/>
          </svg>
          <span id="specimen-btn-text">Compare Specimen</span>
        </button>
        <button
          type="button"
          id="toggle-code-drawer"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-cream-300 dark:border-night-700 hover:border-terra dark:hover:border-terra-light text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light bg-cream-50 dark:bg-night-900 transition-colors"
        >
          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
          </svg>
          <span>CSS Output</span>
        </button>
      </div>
    </div>

    <!-- Presets Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 pt-4">
      {presets.map((preset) => (
        <button
          type="button"
          data-preset-id={preset.id}
          data-preset-display={preset.display}
          data-preset-body={preset.body}
          data-preset-mono={preset.mono}
          data-preset-desc={preset.desc}
          data-preset-origin={preset.origin}
          data-display-family={preset.displayFamily}
          data-body-family={preset.bodyFamily}
          data-mono-family={preset.monoFamily}
          class="preset-btn group relative text-left p-3 rounded-lg border transition-all text-xs flex flex-col justify-between border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light bg-cream-50/60 dark:bg-night-900/60"
        >
          <div>
            <div class="flex items-center justify-between gap-1 mb-1.5">
              <span class="font-semibold text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors flex items-center gap-1.5">
                <span class="active-dot size-1.5 rounded-full bg-transparent inline-block"></span>
                {preset.name}
              </span>
              <span class="text-[9.5px] font-mono px-1.5 py-0.5 rounded bg-cream-200/80 dark:bg-night-700/80 text-ink-muted dark:text-silk-faint">
                {preset.badge}
              </span>
            </div>
            <div class="font-mono text-[10.5px] text-ink-muted dark:text-silk-muted space-y-0.5 mb-2">
              <div class="truncate"><span class="text-ink-faint dark:text-silk-faint">H:</span> {preset.display}</div>
              <div class="truncate"><span class="text-ink-faint dark:text-silk-faint">P:</span> {preset.body}</div>
              <div class="truncate"><span class="text-ink-faint dark:text-silk-faint">M:</span> {preset.mono}</div>
            </div>
          </div>
          <p class="text-[11px] text-ink-light dark:text-silk-faint line-clamp-2 leading-relaxed border-t border-cream-200/50 dark:border-night-700/50 pt-1.5">
            {preset.desc}
          </p>
        </button>
      ))}
    </div>

    <!-- Active Preset Status Bar -->
    <div class="mt-4 pt-3.5 border-t border-cream-200 dark:border-night-700 flex flex-wrap items-center justify-between gap-y-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="text-ink-faint dark:text-silk-faint font-mono text-[11px] uppercase">Active Pairing:</span>
        <span id="active-pairing-name" class="font-semibold text-terra dark:text-terra-light font-mono text-[11px]">
          Kolam Classic (Current)
        </span>
      </div>
      <div id="active-pairing-details" class="text-xs text-ink-muted dark:text-silk-muted">
        Display: <strong id="spec-display" class="font-normal text-ink dark:text-silk">Yeseva One</strong> &bull;
        Body: <strong id="spec-body" class="font-normal text-ink dark:text-silk">Outfit</strong> &bull;
        Mono: <strong id="spec-mono" class="font-normal text-ink dark:text-silk">Fira Code</strong>
      </div>
    </div>

    <!-- Collapsible Comparison Drawer -->
    <div id="specimen-drawer" class="hidden mt-5 pt-4 border-t border-cream-200 dark:border-night-700">
      <div class="flex items-center justify-between mb-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-ink-muted dark:text-silk-faint font-semibold">
          Side-by-Side Specimen Comparison
        </h4>
        <span class="text-[11px] text-ink-faint dark:text-silk-faint">Baseline vs. Current Selected Preset</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <!-- Baseline Sample -->
        <div class="p-4 rounded-lg border border-cream-200 dark:border-night-700 bg-cream-50 dark:bg-night-900" style="font-family: 'Outfit Variable', 'Outfit', sans-serif;">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-cream-200 dark:bg-night-700 text-ink-muted dark:text-silk-faint">
              Current Baseline
            </span>
            <span class="text-[10px] font-mono text-ink-faint dark:text-silk-faint">Yeseva One + Outfit</span>
          </div>
          <h5 style="font-family: 'Yeseva One', serif;" class="text-lg text-ink dark:text-silk leading-snug mb-1.5">
            Production Machine Learning &amp; Dense Retrieval
          </h5>
          <p class="text-xs text-ink-light dark:text-silk-muted leading-relaxed mb-3">
            Evaluating multi-vector ColBERT retrieval vs. bi-encoder cross-attention models for entity resolution on 500k product catalog records.
          </p>
          <div class="flex items-center justify-between text-[11px] font-mono text-ink-faint dark:text-silk-faint pt-2 border-t border-cream-200 dark:border-night-700">
            <span>Oct 2026 &bull; 8 min read</span>
            <span class="text-terra dark:text-terra-light">Read article &rarr;</span>
          </div>
        </div>

        <!-- Selected Candidate Sample -->
        <div id="candidate-specimen-card" class="p-4 rounded-lg border border-terra/30 dark:border-terra-light/30 bg-cream-50 dark:bg-night-900 shadow-sm transition-all duration-150">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-terra/15 dark:bg-terra-light/15 text-terra dark:text-terra-light font-semibold">
              Selected Candidate
            </span>
            <span id="candidate-specimen-subtitle" class="text-[10px] font-mono text-terra dark:text-terra-light">
              Libron Pure
            </span>
          </div>
          <h5 id="candidate-specimen-heading" class="text-lg text-ink dark:text-silk leading-snug mb-1.5">
            Production Machine Learning &amp; Dense Retrieval
          </h5>
          <p id="candidate-specimen-body" class="text-xs text-ink-light dark:text-silk-muted leading-relaxed mb-3">
            Evaluating multi-vector ColBERT retrieval vs. bi-encoder cross-attention models for entity resolution on 500k product catalog records.
          </p>
          <div id="candidate-specimen-meta" class="flex items-center justify-between text-[11px] font-mono text-ink-faint dark:text-silk-faint pt-2 border-t border-cream-200 dark:border-night-700">
            <span>Oct 2026 &bull; 8 min read</span>
            <span class="text-terra dark:text-terra-light">Read article &rarr;</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Collapsible Code Drawer -->
    <div id="code-drawer" class="hidden mt-5 pt-4 border-t border-cream-200 dark:border-night-700">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-xs font-mono uppercase tracking-wider text-ink-muted dark:text-silk-faint font-semibold">
          CSS Variables For Selected Preset
        </h4>
        <span class="text-[11px] text-ink-faint dark:text-silk-faint">Copy to lock in this selection</span>
      </div>
      <pre class="p-3 bg-night-900 text-silk text-xs font-mono rounded-lg overflow-x-auto border border-night-700"><code id="code-output">{`:root {
  --font-display: 'Libron', Georgia, serif;
  --font-body: 'Libron', Georgia, serif;
  --font-mono: 'Fira Code', Menlo, monospace;
}`}</code></pre>
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    function setupEvaluator() {
      var currentPreset = localStorage.getItem('font_preview_preset') || 'editorial-scholar';
      
      var buttons = document.querySelectorAll('.preset-btn');
      var activePairingName = document.getElementById('active-pairing-name');
      var specDisplay = document.getElementById('spec-display');
      var specBody = document.getElementById('spec-body');
      var specMono = document.getElementById('spec-mono');
      var codeOutput = document.getElementById('code-output');

      var specimenHeading = document.getElementById('candidate-specimen-heading');
      var specimenBody = document.getElementById('candidate-specimen-body');
      var specimenMeta = document.getElementById('candidate-specimen-meta');
      var specimenSubtitle = document.getElementById('candidate-specimen-subtitle');

      function applyPreset(id) {
        currentPreset = id;
        localStorage.setItem('font_preview_preset', id);
        document.documentElement.setAttribute('data-font-preset', id);

        var activeBtn = null;
        buttons.forEach(function(btn) {
          var isMatch = btn.getAttribute('data-preset-id') === id;
          var dot = btn.querySelector('.active-dot');
          if (isMatch) {
            activeBtn = btn;
            btn.classList.add('border-terra', 'dark:border-terra-light', 'bg-terra/5', 'dark:bg-terra-light/5', 'ring-1', 'ring-terra/30');
            btn.classList.remove('border-cream-200', 'dark:border-night-700');
            if (dot) dot.classList.replace('bg-transparent', 'bg-terra');
          } else {
            btn.classList.remove('border-terra', 'dark:border-terra-light', 'bg-terra/5', 'dark:bg-terra-light/5', 'ring-1', 'ring-terra/30');
            btn.classList.add('border-cream-200', 'dark:border-night-700');
            if (dot) dot.classList.replace('bg-terra', 'bg-transparent');
          }
        });

        if (activeBtn) {
          var name = activeBtn.querySelector('.font-semibold').innerText.trim();
          var display = activeBtn.getAttribute('data-preset-display');
          var body = activeBtn.getAttribute('data-preset-body');
          var mono = activeBtn.getAttribute('data-preset-mono');
          var displayFamily = activeBtn.getAttribute('data-display-family');
          var bodyFamily = activeBtn.getAttribute('data-body-family');
          var monoFamily = activeBtn.getAttribute('data-mono-family');

          if (activePairingName) activePairingName.innerText = name;
          if (specDisplay) specDisplay.innerText = display;
          if (specBody) specBody.innerText = body;
          if (specMono) specMono.innerText = mono;

          if (codeOutput) {
            codeOutput.innerText = ":root {\n  --font-display: " + displayFamily + ";\n  --font-body: " + bodyFamily + ";\n  --font-mono: " + monoFamily + ";\n}";
          }

          if (specimenHeading && displayFamily) {
            specimenHeading.style.fontFamily = displayFamily;
          }
          if (specimenBody && bodyFamily) {
            specimenBody.style.fontFamily = bodyFamily;
          }
          if (specimenMeta && monoFamily) {
            specimenMeta.style.fontFamily = monoFamily;
          }
          if (specimenSubtitle) {
            specimenSubtitle.innerText = display + " + " + body;
          }
        }
      }

      // Attach click events
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.getAttribute('data-preset-id');
          applyPreset(id);
        });
      });

      // Specimen Drawer Toggle
      var specToggle = document.getElementById('toggle-specimen-drawer');
      var specDrawer = document.getElementById('specimen-drawer');
      var specBtnText = document.getElementById('specimen-btn-text');
      if (specToggle && specDrawer) {
        specToggle.addEventListener('click', function() {
          var isHidden = specDrawer.classList.toggle('hidden');
          specBtnText.innerText = isHidden ? 'Compare Specimen' : 'Hide Specimen';
        });
      }

      // Code Drawer Toggle
      var codeToggle = document.getElementById('toggle-code-drawer');
      var codeDrawer = document.getElementById('code-drawer');
      if (codeToggle && codeDrawer) {
        codeToggle.addEventListener('click', function() {
          codeDrawer.classList.toggle('hidden');
        });
      }

      // Initial apply
      applyPreset(currentPreset);
    }

    // Run on initial load and view transitions
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupEvaluator);
    } else {
      setupEvaluator();
    }
    document.addEventListener('astro:page-load', setupEvaluator);
  })();
</script>

<style>
  /* Ensure fast, zero-delay hover responsiveness */
  .preset-btn {
    transition-delay: 0s !important;
  }
</style>
