---
import { SITE_TITLE, SOCIAL_LINKS, NAV_ITEMS } from '../consts';
import SocialIcon from './SocialIcon.astro';
import Search from './Search.astro';
import BrandEmblem from './BrandEmblem.astro';

const currentPath = Astro.url.pathname;

function isNavActive(href: string): boolean {
  if (href.startsWith('http')) return false;
  if (href === '/') return currentPath === '/';
  if (href === '/blog/') {
    return currentPath === '/blog' || currentPath === '/blog/' || currentPath.startsWith('/posts/');
  }
  return currentPath.startsWith(href);
}
---

<aside class="hidden lg:flex flex-col fixed top-0 bottom-0 w-[256px] z-30 overflow-y-auto
  bg-cream-50/75 dark:bg-night-900/95 border-r border-cream-200/60 dark:border-night-700/55 app-sidebar">

  <!-- Whisper-quiet Kolam dot grid -->
  <div class="absolute inset-0 kolam-dots pointer-events-none" aria-hidden="true"></div>

  <!-- Delicate radial Kolam canopy -->
  <div class="kolam-hero shrink-0 opacity-80" aria-hidden="true"></div>

  <div class="relative flex flex-col flex-1 px-7 py-5">
    <!-- Animated Vav Monogram Identity -->
    <a href="/" class="group flex flex-col items-center text-center -mt-12 mb-9" aria-label={`${SITE_TITLE} Home`}>
      <div class="relative mb-3">
        <BrandEmblem size="lg" />
      </div>
      <span class="font-body font-bold text-base text-ink dark:text-silk tracking-tight block group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150">
        {SITE_TITLE}
      </span>
    </a>

    <!-- Quiet underline search trigger -->
    <div class="mb-7">
      <Search />
    </div>

    <!-- Clean text-only navigation with active Vav bindu indicator -->
    <nav class="flex flex-col gap-0.5" aria-label="Primary navigation">
      {NAV_ITEMS.map(({ label, href }) => {
        const isActive = isNavActive(href);
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'group vav-row-hover flex items-center gap-3 px-2.5 -mx-2.5 py-2 text-[15px] font-body',
              isActive
                ? 'text-terra dark:text-terra-light font-medium'
                : 'text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light',
            ]}
          >
            <span
              class:list={[
                'vav-nav-diamond size-1.5 rounded-[1px] shrink-0',
                isActive
                  ? 'bg-terra dark:bg-terra-light ring-2 ring-gold/45 dark:ring-gold-light/40'
                  : 'bg-cream-300/75 dark:bg-night-700 group-hover:bg-terra dark:group-hover:bg-terra-light group-hover:ring-2 group-hover:ring-gold/40 dark:group-hover:ring-gold-light/35',
              ]}
              aria-hidden="true"
            />
            <span class="group-hover:translate-x-0.5 transition-transform duration-150">
              {label}
            </span>
          </a>
        );
      })}
    </nav>

    <div class="flex-1" />

    <!-- Quiet utility row: Social + Tactile Theme Toggle -->
    <div class="pt-6 mt-8 border-t border-cream-200/50 dark:border-night-700/50">
      <div class="flex items-center justify-center gap-1.5 mb-3">
        <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,background-color,transform] duration-150 p-1.5" aria-label="GitHub">
          <SocialIcon name="github" class="size-4" />
        </a>
        <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,background-color,transform] duration-150 p-1.5" aria-label="X / Twitter">
          <SocialIcon name="x" class="size-4" />
        </a>
        <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,background-color,transform] duration-150 p-1.5" aria-label="LinkedIn">
          <SocialIcon name="linkedin" class="size-4" />
        </a>
        <a href={SOCIAL_LINKS.huggingface} target="_blank" rel="noopener noreferrer" class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,background-color,transform] duration-150 p-1.5" aria-label="Hugging Face">
          <SocialIcon name="huggingface" class="size-4" />
        </a>
        <a href={SOCIAL_LINKS.email} class="vav-row-hover text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light active:scale-95 transition-[color,background-color,transform] duration-150 p-1.5" aria-label="Email">
          <SocialIcon name="email" class="size-4" />
        </a>
      </div>

      <button
        id="theme-toggle-desktop"
        type="button"
        class="vav-row-hover flex items-center justify-center p-1.5 text-ink-faint dark:text-silk-faint hover:text-gold-dark dark:hover:text-gold-light hover:rotate-12 transition-[color,background-color,transform,rotate] duration-150 cursor-pointer mx-auto active:scale-[0.94]"
        aria-label="Toggle dark mode"
      >
        <svg class="size-[18px] hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="size-[18px] block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </div>
</aside>
