---
import { SITE_TITLE, SITE_TAGLINE, SOCIAL_LINKS, NAV_ITEMS } from '../consts';
import NavIcon from './NavIcon.astro';
import SocialIcon from './SocialIcon.astro';
import Search from './Search.astro';
import BrandEmblem from './BrandEmblem.astro';
import KolamDivider from './KolamDivider.astro';

const currentPath = Astro.url.pathname;
---

<aside class="hidden lg:flex flex-col fixed top-0 bottom-0 w-[260px] z-30 overflow-y-auto
  bg-cream-50 dark:bg-night-900 border-r border-cream-200 dark:border-night-700 app-sidebar">

  <!-- Kolam dot grid background -->
  <div class="absolute inset-0 kolam-dots pointer-events-none" aria-hidden="true"></div>

  <!-- Integrated Radial Stage Header -->
  <div class="relative pt-6 pb-2 px-5 flex flex-col items-center text-center overflow-hidden">
    <!-- Concentric Radial Halo Arcs (Radiating from behind the emblem) -->
    <svg
      class="absolute top-2 left-1/2 -translate-x-1/2 w-[220px] h-[110px] pointer-events-none opacity-40 dark:opacity-45"
      viewBox="0 0 220 110"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="110" cy="80" r="68" class="stroke-gold dark:stroke-gold-light" stroke-width="1" stroke-dasharray="3 4" />
      <circle cx="110" cy="80" r="48" class="stroke-terra dark:stroke-terra-light" stroke-width="1" stroke-dasharray="2 3" />
      <path d="M 35 80 Q 110 20, 185 80" class="stroke-terra dark:stroke-terra-light" stroke-width="1" />
      <circle cx="110" cy="12" r="2" class="fill-gold dark:fill-gold-light" />
      <circle cx="42" cy="80" r="1.5" class="fill-terra dark:fill-terra-light" />
      <circle cx="178" cy="80" r="1.5" class="fill-terra dark:fill-terra-light" />
    </svg>

    <!-- Profile & Emblem (Seamlessly Centered, No Sliced Border Lines) -->
    <a href="/" class="group flex flex-col items-center text-center relative z-10" aria-label={`${SITE_TITLE} Home`}>
      <div class="relative mb-3">
        <BrandEmblem size="lg" />
      </div>
      <h1 class="font-body font-bold text-xl text-ink dark:text-silk tracking-tight block">{SITE_TITLE}</h1>
      <p class="text-xs text-ink-muted dark:text-silk-muted italic mt-0.5">{SITE_TAGLINE}</p>
    </a>

    <!-- Compact Tapered Vector Kolam Divider -->
    <KolamDivider variant="compact" class="mt-3 mb-1" />
  </div>

  <div class="relative flex flex-col flex-1 px-5 pb-5 pt-1">
    <!-- Search -->
    <div class="mb-2">
      <Search />
    </div>

    <!-- Navigation with icons -->
    <nav class="flex flex-col gap-0.5">
      {NAV_ITEMS.map(({ label, href, icon }) => {
        const isExternal = href.startsWith('http');
        const isActive = isExternal ? false : (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
        return (
          <a
            href={href}
            {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class:list={[
              'flex items-center gap-3 px-4 py-2.5 text-sm font-body rounded-lg transition-all duration-200',
              isActive
                ? 'bg-terra/10 dark:bg-terra-light/10 text-terra dark:text-terra-light font-medium'
                : 'text-ink-light dark:text-silk-muted hover:text-ink dark:hover:text-silk hover:bg-cream-100 dark:hover:bg-night-800',
            ]}
          >
            <NavIcon icon={icon} />
            {label}
            {isExternal && (
              <svg class="size-3 ml-auto opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            )}
          </a>
        );
      })}
    </nav>

    <div class="flex-1" />

    <!-- Social -->
    <div class="flex items-center justify-center gap-3.5 mb-3 mt-4">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors p-1 rounded-md hover:bg-cream-100 dark:hover:bg-night-800" aria-label="GitHub">
        <SocialIcon name="github" class="size-[18px]" />
      </a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors p-1 rounded-md hover:bg-cream-100 dark:hover:bg-night-800" aria-label="X / Twitter">
        <SocialIcon name="x" class="size-[18px]" />
      </a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors p-1 rounded-md hover:bg-cream-100 dark:hover:bg-night-800" aria-label="LinkedIn">
        <SocialIcon name="linkedin" class="size-[18px]" />
      </a>
      <a href={SOCIAL_LINKS.huggingface} target="_blank" rel="noopener noreferrer" class="text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors p-1 rounded-md hover:bg-cream-100 dark:hover:bg-night-800" aria-label="Hugging Face">
        <SocialIcon name="huggingface" class="size-[18px]" />
      </a>
      <a href={SOCIAL_LINKS.email} class="text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors p-1 rounded-md hover:bg-cream-100 dark:hover:bg-night-800" aria-label="Email">
        <SocialIcon name="email" class="size-[18px]" />
      </a>
    </div>

    <!-- Theme toggle -->
    <button
      id="theme-toggle-desktop"
      type="button"
      class="flex items-center justify-center p-2 rounded-lg text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light hover:bg-cream-100 dark:hover:bg-night-800 transition-all cursor-pointer mx-auto"
      aria-label="Toggle dark mode"
    >
      <svg class="size-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      <svg class="size-5 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
  </div>
</aside>
