    | 'github'
    | 'twitter'
    | 'x'
    | 'linkedin'
    | 'huggingface'
    | 'email'
    | 'mail'
    | 'resume'
    | 'cv'
    | 'rss'
    | 'llms'
    | 'openapi'
    | 'docs'
