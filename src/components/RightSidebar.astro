---
import { getCollection } from 'astro:content';
import { getTagPillClasses, getTagIndicator } from '../utils/tags';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const reads = (await getCollection('reads'))
  .filter((r) => !r.data.draft);

// Pick 3 cornerstone posts (most tags, excluding the latest 3 already visible in the feed)
const startHerePosts = posts.slice(3)
  .sort((a, b) => b.data.tags.length - a.data.tags.length)
  .slice(0, 3);

const tagCounts: Record<string, number> = {};

posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

reads.forEach((read) => {
  read.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const trendingTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<div class="hidden xl:block w-[240px] shrink-0">
  <div class="sticky top-8 space-y-8">
    <!-- Start Here -->
    <section>
      <h3 class="text-sm font-semibold text-ink dark:text-silk mb-3 flex items-center gap-2">
        <svg class="size-4 text-terra dark:text-terra-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        Start Here
      </h3>
      <ul class="space-y-2">
        {startHerePosts.map((post) => (
          <li>
            <a
              href={`/posts/${post.id}/`}
              class="text-sm text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors line-clamp-2"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Trending Tags -->
    <section>
      <h3 class="text-sm font-semibold text-ink dark:text-silk mb-3 flex items-center gap-2">
        <svg class="size-4 text-gold dark:text-gold-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
        Trending Tags
      </h3>
      <div class="flex flex-wrap gap-2">
        {trendingTags.map(([tag, count]) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}/`}
            class={getTagPillClasses(tag)}
          >
            {getTagIndicator(tag) && (
              <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
            )}
            {tag}
          </a>
        ))}
      </div>
    </section>
  </div>
</div>
