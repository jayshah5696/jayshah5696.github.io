---
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | number;
  animated?: boolean;
  hoverSpin?: boolean;
  class?: string;
}

const {
  size = 'md',
  animated = true,
  hoverSpin = true,
  class: className = '',
} = Astro.props;

const sizeMap = {
  xs: 'size-5',   // 20px
  sm: 'size-7',   // 28px
  md: 'size-12',  // 48px
  lg: 'size-18',  // 72px
  xl: 'size-24',  // 96px
};

const dimensionClass = typeof size === 'string' ? sizeMap[size] : '';
const inlineStyle = typeof size === 'number' ? `width: ${size}px; height: ${size}px;` : undefined;

const uid = Math.random().toString(36).substring(2, 7);
const jFlowId = `emblem-j-${uid}`;
const sFlowId = `emblem-s-${uid}`;
---

<div
  class:list={[
    'relative inline-flex items-center justify-center select-none shrink-0 group/emblem',
    dimensionClass,
    className,
  ]}
  style={inlineStyle}
  aria-label="Jay Shah Vav Monogram Emblem"
  role="img"
>
  <svg
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="size-full"
  >
    <defs>
      <linearGradient id={jFlowId} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#c4623a" />
        <stop offset="100%" stop-color="#e07a4f" />
      </linearGradient>

      <linearGradient id={sFlowId} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#e07a4f" />
        <stop offset="55%" stop-color="#d4a843" />
        <stop offset="100%" stop-color="#e8c462" />
      </linearGradient>
    </defs>

    <!-- Squircle Base -->
    <rect
      width="100"
      height="100"
      rx="22"
      class="fill-cream-100 dark:fill-night-800 transition-colors duration-200"
    />
    <rect
      x="1.5"
      y="1.5"
      width="97"
      height="97"
      rx="20.5"
      class="stroke-ink/10 dark:stroke-white/10 group-hover/emblem:stroke-terra/40 dark:group-hover/emblem:stroke-gold-light/40 transition-colors duration-200"
      stroke-width="1.5"
      fill="none"
    />

    <!-- Meditative Celestial Kolam Orbit -->
    <g
      class:list={[
        'origin-center',
        hoverSpin && 'kolam-orbit-spin',
      ]}
      style="transform-origin: 50px 50px;"
    >
      <rect
        x="22"
        y="22"
        width="56"
        height="56"
        rx="8"
        transform="rotate(45 50 50)"
        class="stroke-terra/30 dark:stroke-gold/30"
        stroke-width="1.4"
        stroke-dasharray="3.5 3.5"
        fill="none"
      />
      <rect
        x="30"
        y="30"
        width="40"
        height="40"
        rx="6"
        transform="rotate(45 50 50)"
        class="stroke-gold/25 dark:stroke-terra/25"
        stroke-width="1"
        stroke-dasharray="2.5 2.5"
        fill="none"
      />
      <circle cx="50" cy="8" r="2" class="fill-terra dark:fill-terra-light" />
      <circle cx="50" cy="92" r="2" class="fill-terra dark:fill-terra-light" />
      <circle cx="8" cy="50" r="2" class="fill-gold dark:fill-gold-light" />
      <circle cx="92" cy="50" r="2" class="fill-gold dark:fill-gold-light" />
    </g>

    <!-- 'J' Calligraphic Ink Stroke (draws once on entrance) -->
    <path
      d="M 33 24 H 44 M 43 24 V 58 C 43 70 33 74 24 66"
      stroke={`url(#${jFlowId})`}
      stroke-width={size === 'xs' || size === 'sm' ? '7' : '5.5'}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={[animated && 'emblem-draw-j']}
      fill="none"
    />

    <!-- 'S' Calligraphic Ink Stroke (draws once on entrance) -->
    <path
      d="M 74 30 C 74 20 58 20 48 28 C 42 34 46 44 56 48 C 68 52 74 60 70 70 C 66 78 48 78 38 72"
      stroke={`url(#${sFlowId})`}
      stroke-width={size === 'xs' || size === 'sm' ? '7' : '5.5'}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={[animated && 'emblem-draw-s']}
      fill="none"
    />

    <!-- Central Luminous Bindu Core (soft sanctuary pulse, no jarring scale) -->
    <circle
      cx="50"
      cy="50"
      r={size === 'xs' ? '5.5' : '4.5'}
      class="fill-ink dark:fill-silk"
    />
    <circle
      cx="50"
      cy="50"
      r="9"
      class:list={[
        'stroke-gold dark:stroke-gold-light transition-opacity duration-200 group-hover/emblem:opacity-100',
        animated && 'bindu-halo-breathe',
      ]}
      stroke-width="1.25"
      fill="none"
    />
  </svg>
</div>

<style>
  /* Slow meditative orbit — accelerates gracefully on hover */
  .kolam-orbit-spin {
    animation: concentricOrbit 60s linear infinite;
  }

  :global(.group\/emblem:hover) .kolam-orbit-spin {
    animation-duration: 14s;
  }

  @keyframes concentricOrbit {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* One-shot calligraphic ink draw on load, then settles cleanly */
  .emblem-draw-j {
    stroke-dasharray: 120;
    stroke-dashoffset: 0;
    animation: inkDrawJ 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .emblem-draw-s {
    stroke-dasharray: 180;
    stroke-dashoffset: 0;
    animation: inkDrawS 1100ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both;
  }

  @keyframes inkDrawJ {
    from {
      stroke-dashoffset: 120;
      opacity: 0.25;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes inkDrawS {
    from {
      stroke-dashoffset: 180;
      opacity: 0.25;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* Gentle lamp-like halo breath around the central bindu */
  .bindu-halo-breathe {
    animation: binduBreath 5.5s ease-in-out infinite;
  }

  @keyframes binduBreath {
    0%, 100% {
      opacity: 0.42;
    }
    50% {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kolam-orbit-spin,
    .emblem-draw-j,
    .emblem-draw-s,
    .bindu-halo-breathe {
      animation: none !important;
    }
  }
</style>
