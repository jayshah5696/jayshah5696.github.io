---
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | number;
  animated?: boolean;
  hoverSpin?: boolean;
  idPrefix?: string;
  class?: string;
}

const {
  size = 'md',
  animated = true,
  hoverSpin = true,
  idPrefix,
  class: className = '',
} = Astro.props;

const sizeMap = {
  xs: 'size-5',   // 20px
  sm: 'size-7',   // 28px
  md: 'size-12',  // 48px
  lg: 'size-20',  // 80px
  xl: 'size-24',  // 96px
};

const dimensionClass = typeof size === 'string' ? sizeMap[size] : '';
const inlineStyle = typeof size === 'number' ? `width: ${size}px; height: ${size}px;` : undefined;

// Guaranteed unique instance identifier to prevent SVG paint server cross-component collision
const uid = idPrefix || `vav-${Math.random().toString(36).slice(2, 8)}`;
const isCompact = size === 'xs' || size === 'sm';
const strokeWidth = isCompact ? '6.5' : '5.5';
---

<div
  class:list={[
    'relative inline-flex items-center justify-center select-none shrink-0 group/emblem',
    dimensionClass,
    className,
  ]}
  style={inlineStyle}
  aria-label="Jay Shah Vav Monogram Emblem"
  role="img"
>
  <svg
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="size-full transition-transform duration-500 ease-out group-hover/emblem:scale-[1.04]"
    shape-rendering="geometricPrecision"
  >
    <defs>
      <!-- Squircle Tile Gradient -->
      <linearGradient id={`${uid}-tile-grad`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" class="emblem-tile-stop-0" />
        <stop offset="100%" class="emblem-tile-stop-1" />
      </linearGradient>

      <!-- J Flow: Terracotta to Radiant Gold -->
      <linearGradient id={`${uid}-j-flow`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" class="emblem-j-stop-start" />
        <stop offset="100%" class="emblem-j-stop-end" />
      </linearGradient>

      <!-- S Flow: Radiant Gold to Terracotta Flow -->
      <linearGradient id={`${uid}-s-flow`} x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" class="emblem-s-stop-start" />
        <stop offset="50%" class="emblem-s-stop-mid" />
        <stop offset="100%" class="emblem-s-stop-end" />
      </linearGradient>
    </defs>

    <!-- 1. Squircle Base Tile -->
    <rect
      width="100"
      height="100"
      rx="22"
      fill={`url(#${uid}-tile-grad)`}
      class="transition-colors duration-300"
    />
    <rect
      x="1.5"
      y="1.5"
      width="97"
      height="97"
      rx="20.5"
      class="stroke-ink/10 dark:stroke-white/10"
      stroke-width="1.5"
      fill="none"
    />

    <!-- 2. Concentric Kolam Orbital Mandala (Outer Halo, R >= 35px, Zero Monogram Overlap) -->
    <g
      class:list={[
        'kolam-orbital-layer',
        hoverSpin && 'kolam-orbit-spin',
      ]}
    >
      <!-- Outer Stepped Diamond -->
      <rect
        x="20"
        y="20"
        width="60"
        height="60"
        rx="8"
        transform="rotate(45 50 50)"
        class="stroke-terra/35 dark:stroke-gold/35"
        stroke-width="1.4"
        stroke-dasharray="3.5 3.5"
        fill="none"
      />
      <!-- Inner Stepped Diamond -->
      <rect
        x="27"
        y="27"
        width="46"
        height="46"
        rx="6"
        transform="rotate(45 50 50)"
        class="stroke-gold/25 dark:stroke-terra/25"
        stroke-width="1"
        stroke-dasharray="2.5 2.5"
        fill="none"
      />
      <!-- 4 Cardinal Bindus -->
      <circle cx="50" cy="8" r="2.2" class="fill-terra dark:fill-terra-light" />
      <circle cx="50" cy="92" r="2.2" class="fill-terra dark:fill-terra-light" />
      <circle cx="8" cy="50" r="2.2" class="fill-terra dark:fill-terra-light" />
      <circle cx="92" cy="50" r="2.2" class="fill-terra dark:fill-terra-light" />
      <!-- 4 Ordinal Stepwell Corner Accents -->
      <circle cx="21" cy="21" r="1.3" class="fill-gold dark:fill-gold-light opacity-60" />
      <circle cx="79" cy="21" r="1.3" class="fill-gold dark:fill-gold-light opacity-60" />
      <circle cx="21" cy="79" r="1.3" class="fill-gold dark:fill-gold-light opacity-60" />
      <circle cx="79" cy="79" r="1.3" class="fill-gold dark:fill-gold-light opacity-60" />
    </g>

    <!-- 3. 'J' Stem (Left Flank at x=38 with Stepwell Reservoir Curl) -->
    <path
      d="M 26 26 H 38 V 56 C 38 68, 30 74, 20 66"
      stroke={`url(#${uid}-j-flow)`}
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={[
        'transition-all duration-300',
        animated && 'emblem-draw-j',
      ]}
      fill="none"
    />

    <!-- 4. 'S' Flow (Cascading Yin-Yang Kolam Curve) -->
    <path
      d="M 72 28 C 72 19, 56 19, 46 26 C 39 31, 45 41, 56 45 C 66 49, 74 57, 70 69 C 66 79, 50 80, 38 72"
      stroke={`url(#${uid}-s-flow)`}
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={[
        'transition-all duration-300',
        animated && 'emblem-draw-s',
      ]}
      fill="none"
    />

    <!-- 5. Central Sanctum Bindu Core (Origin at 50,50) -->
    <circle
      cx="50"
      cy="50"
      r="4"
      class="fill-ink dark:fill-silk transition-transform duration-300 origin-center group-hover/emblem:scale-125"
    />
    <circle
      cx="50"
      cy="50"
      r="7.5"
      class="stroke-gold dark:stroke-gold-light opacity-50 group-hover/emblem:opacity-90 transition-all duration-300"
      stroke-width="1.2"
      stroke-dasharray="2.5 2"
      fill="none"
    />
  </svg>
</div>

<style>
  /* CSS Theme-Aware Gradient Stop Colors */
  .emblem-tile-stop-0 { stop-color: #fbf5ea; }
  .emblem-tile-stop-1 { stop-color: #f4ecdf; }
  :global(.dark) .emblem-tile-stop-0 { stop-color: #1e1928; }
  :global(.dark) .emblem-tile-stop-1 { stop-color: #15111e; }

  .emblem-j-stop-start { stop-color: #c4623a; }
  .emblem-j-stop-end { stop-color: #e07a4f; }
  :global(.dark) .emblem-j-stop-start { stop-color: #e07a4f; }
  :global(.dark) .emblem-j-stop-end { stop-color: #f09068; }

  .emblem-s-stop-start { stop-color: #e07a4f; }
  .emblem-s-stop-mid { stop-color: #d4a843; }
  .emblem-s-stop-end { stop-color: #d4a843; }
  :global(.dark) .emblem-s-stop-start { stop-color: #f09068; }
  :global(.dark) .emblem-s-stop-mid { stop-color: #e8c462; }
  :global(.dark) .emblem-s-stop-end { stop-color: #e8c462; }

  /* 60fps GPU Composited Orbital Rotation */
  .kolam-orbital-layer {
    transform-origin: 50px 50px;
    will-change: transform;
  }

  .kolam-orbit-spin {
    animation: vavOrbitalOrbit 48s linear infinite;
  }

  @media (hover: hover) {
    :global(.group\/emblem:hover) .kolam-orbit-spin {
      animation-duration: 12s;
      transition: animation-duration 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes vavOrbitalOrbit {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* One-Shot Eased Entrance Draw (Emil Kowalski Spring Spec) */
  .emblem-draw-j {
    stroke-dasharray: 85;
    stroke-dashoffset: 85;
    animation: drawStrokeJ 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .emblem-draw-s {
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: drawStrokeS 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  @keyframes drawStrokeJ {
    to { stroke-dashoffset: 0; }
  }

  @keyframes drawStrokeS {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kolam-orbit-spin,
    .emblem-draw-j,
    .emblem-draw-s {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      transform: none !important;
    }
  }
</style>
