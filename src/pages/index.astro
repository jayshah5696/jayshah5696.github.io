---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import RightSidebar from '../components/RightSidebar.astro';
import SocialIcon from '../components/SocialIcon.astro';
import KolamDivider from '../components/KolamDivider.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPosts = posts.length;
---

<BaseLayout rightSidebar={true} jsonLdType="WebSite">
  <!-- Hero welcome section -->
  <header class="reveal mb-12">
    <h2 class="font-display text-2xl sm:text-3xl text-ink dark:text-silk carved-heading mb-3">
      AI Systems, Research &amp; Engineering
    </h2>
    <p class="text-ink-light dark:text-silk-muted text-base leading-relaxed">
      I am a Senior Machine Learning Engineer at 6sense, where I build production AI applications, foundational model systems, custom embeddings, and agent evaluation frameworks. On this site, I write technical essays documenting what I build, break, and learn when turning raw machine learning research into working products, with a current focus on ai agent-based automation systems.
    </p>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-4 text-xs font-mono text-ink-faint dark:text-silk-faint">
      <span class="uppercase" style="letter-spacing: 0.1em;">{totalPosts} writings</span>
      <span class="text-cream-300 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
      <a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">
        <SocialIcon name="rss" class="size-3.5 text-terra/70 dark:text-terra-light/70" />
        RSS
      </a>
      <span class="text-cream-300 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
      <a href="/llms.txt" class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">
        <SocialIcon name="llms" class="size-3.5 text-terra/70 dark:text-terra-light/70" />
        llms.txt
      </a>
      <span class="text-cream-300 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
      <a href="/openapi.json" class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">
        <SocialIcon name="openapi" class="size-3.5 text-terra/70 dark:text-terra-light/70" />
        OpenAPI
      </a>
      <span class="text-cream-300 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
      <a href="/api/docs/" class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">
        <SocialIcon name="docs" class="size-3.5 text-terra/70 dark:text-terra-light/70" />
        API Docs
      </a>
    </div>
    <KolamDivider class="mt-5" />
  </header>

  <section aria-labelledby="writings-heading" class="space-y-10">
    <div class="reveal flex items-center justify-between">
      <h2 id="writings-heading" class="font-mono text-xs uppercase text-ink-muted dark:text-silk-faint tracking-wider font-semibold">
        Recent Research &amp; Technical Articles
      </h2>
      <a href="/archives/" class="font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors">
        View archives &rarr;
      </a>
    </div>

    <div class="space-y-6">
      {posts.map((post, i) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          description={post.data.description}
          slug={post.id}
          tags={post.data.tags}
          body={post.body ?? ''}
          image={post.data.image}
          featured={i === 0}
          index={i}
        />
      ))}
    </div>
  </section>

  <!-- Subscribe CTA -->
  <div class="reveal mt-16 pt-8">
    <KolamDivider class="mb-6" />
    <div class="flex items-center gap-4">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 px-4 py-2 border border-terra/20 dark:border-terra-light/20 rounded-lg text-sm font-mono text-terra dark:text-terra-light hover:bg-terra/10 dark:hover:bg-terra-light/10 transition-colors"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        Subscribe via RSS
      </a>
      <span class="text-xs text-ink-faint dark:text-silk-faint font-mono">New posts in your reader</span>
    </div>
  </div>

  <RightSidebar slot="right-sidebar" />
</BaseLayout>
