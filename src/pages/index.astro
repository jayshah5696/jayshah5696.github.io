---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPosts = posts.length;
---

<BaseLayout rightSidebar={true} jsonLdType="WebSite">
  <!-- Hero welcome section -->
  <header class="mb-8">
    <h2 class="font-display text-2xl sm:text-3xl text-ink dark:text-silk carved-heading mb-3">
      AI Systems, Research &amp; Engineering
    </h2>
    <p class="text-ink-light dark:text-silk-muted text-base leading-relaxed">
      I am a Senior Data Scientist at 6sense building production AI applications, foundational model systems, custom embeddings, and agent evaluation frameworks. On this site, I write in-depth technical essays documenting what I build, break, and learn across large language models, retrieval-augmented generation (RAG), statistical text watermarking, and autonomous developer agents.
    </p>
    <div class="flex items-center gap-3 mt-4">
      <span class="font-mono text-xs text-ink-faint dark:text-silk-faint uppercase" style="letter-spacing: 0.1em;">{totalPosts} writings</span>
      <span class="text-cream-300 dark:text-night-700 text-xs select-none" aria-hidden="true">&bull;</span>
      <a href="/rss.xml" class="font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">RSS</a>
      <span class="text-cream-300 dark:text-night-700 text-xs select-none" aria-hidden="true">&bull;</span>
      <a href="/llms.txt" class="font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">llms.txt</a>
      <span class="text-cream-300 dark:text-night-700 text-xs select-none" aria-hidden="true">&bull;</span>
      <a href="/openapi.json" class="font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">OpenAPI</a>
      <span class="text-cream-300 dark:text-night-700 text-xs select-none" aria-hidden="true">&bull;</span>
      <a href="/api/docs/" class="font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors uppercase" style="letter-spacing: 0.1em;">API Docs</a>
    </div>
    <div class="kolam-border mt-5"></div>
  </header>

  <section aria-labelledby="writings-heading" class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 id="writings-heading" class="font-mono text-xs uppercase text-ink-muted dark:text-silk-faint tracking-wider font-semibold">
        Recent Research &amp; Technical Articles
      </h2>
      <a href="/archives/" class="font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors">
        View archives &rarr;
      </a>
    </div>

    <div class="space-y-5">
      {posts.map((post, i) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          description={post.data.description}
          slug={post.id}
          tags={post.data.tags}
          body={post.body ?? ''}
          image={post.data.image}
          featured={i === 0}
        />
      ))}
    </div>
  </section>

  <!-- Subscribe CTA -->
  <div class="mt-12 pt-6">
    <div class="kolam-border mb-6"></div>
    <div class="flex items-center gap-4">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 px-4 py-2 border border-terra/20 dark:border-terra-light/20 rounded-lg text-sm font-mono text-terra dark:text-terra-light hover:bg-terra/10 dark:hover:bg-terra-light/10 transition-colors"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        Subscribe via RSS
      </a>
      <span class="text-xs text-ink-faint dark:text-silk-faint font-mono">New posts in your reader</span>
    </div>
  </div>

  <RightSidebar slot="right-sidebar" />
</BaseLayout>
