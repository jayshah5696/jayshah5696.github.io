---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import IndexRow from '../components/IndexRow.astro';
import KolamDivider from '../components/KolamDivider.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { Image } from 'astro:assets';
import profileImage from '../../public/assets/images/profile.webp';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPosts = posts.length;
const latestPost = posts[0];
const recentPosts = posts.slice(1, 5);
const featuredProjects = projects.slice(0, 4);

function formatShortMonthYear(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout jsonLdType="WebSite">
  <!-- Editorial Hero with Bigger Halo Portrait & Kinetic Role Line -->
  <header class="reveal mb-12 sm:mb-14 pb-8 sm:pb-10 border-b border-terra/15 dark:border-gold/15" style="--index: 0;">
    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6 sm:gap-7">
      <div class="min-w-0 flex-1">
        <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading leading-[1.15] tracking-tight text-balance">
          Jay Shah
        </h1>

        <p class="mt-5 font-body text-ink-light dark:text-silk-muted text-base sm:text-[17px] leading-relaxed max-w-[46ch]">
          Machine learning engineer in San Francisco.
          <span class="block mt-0.5">Working on<span class="role-rotator inline-grid align-baseline overflow-hidden ml-[0.28em] pr-1" aria-label="forward-deployed predictive ML, custom embeddings, AI agent evaluations, and open Indic models">
            <span class="role-slot role-slot-1 italic text-terra dark:text-terra-light">forward-deployed ML.</span>
            <span class="role-slot role-slot-2 italic text-gold-dark dark:text-gold-light" aria-hidden="true">custom embeddings.</span>
            <span class="role-slot role-slot-3 italic text-mor dark:text-mor-light" aria-hidden="true">AI agent evals.</span>
            <span class="role-slot role-slot-4 italic text-kumkum dark:text-kumkum-light" aria-hidden="true">open Indic models.</span>
          </span></span>
        </p>
      </div>

      <!-- Larger Signature Portrait with Delicate Kolam Halo -->
      <a
        href="/about/"
        class="group/portrait relative shrink-0 self-start sm:self-center"
        aria-label="About Jay Shah"
      >
        <div
          class="portrait-halo absolute -inset-2.5 rounded-full border border-dashed border-gold/40 dark:border-gold-light/35 group-hover/portrait:border-terra/55 dark:group-hover/portrait:border-terra-light/55 transition-colors duration-200"
          aria-hidden="true"
        />
        <div class="relative size-24 sm:size-28 rounded-full overflow-hidden ring-1 ring-gold/70 dark:ring-gold-light/65 bg-cream-100 dark:bg-night-800 p-1 shadow-xs group-hover/portrait:ring-terra/80 dark:group-hover/portrait:ring-terra-light/80 transition-colors duration-200">
          <div class="relative size-full rounded-full overflow-hidden">
            <Image
              src={profileImage}
              alt="Jay Shah"
              width={112}
              height={112}
              densities={[1.5, 2]}
              quality={92}
              class="size-full object-cover object-top rounded-full portrait-hover-zoom"
            />
          </div>
        </div>
      </a>
    </div>
  </header>

  <!-- Featured Essay Architectural Plate -->
  {latestPost && (
    <section aria-labelledby="featured-heading" class="mb-16 sm:mb-20" style="--index: 1;">
      <h2 id="featured-heading" class="sr-only">Latest essay</h2>
      <PostCard
        title={latestPost.data.title}
        date={latestPost.data.date}
        description={latestPost.data.description}
        slug={latestPost.id}
        body={latestPost.body ?? ''}
        image={latestPost.data.image}
        interactive={latestPost.data.interactive}
        headingTag="h3"
      />
    </section>
  )}

  <!-- Writing (Numbered Architectural Hairline Ledger) -->
  <section aria-labelledby="writing-heading" class="reveal mb-16 sm:mb-20" style="--index: 2;">
    <div class="flex items-baseline justify-between gap-4 mb-4">
      <div class="flex items-center gap-3">
        <div class="kolam-diamond-node relative static! size-3 shrink-0" aria-hidden="true" />
        <h2 id="writing-heading" class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
          Writing
        </h2>
      </div>
      <a
        href="/blog/"
        class="group/more inline-flex items-center gap-1 font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors duration-150 whitespace-nowrap"
      >
        <span>All {totalPosts}</span>
        <span class="inline-block group-hover/more:translate-x-0.5 transition-transform duration-150" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <ul class="border-t border-terra/15 dark:border-gold/15">
      {recentPosts.map((post, i) => (
        <IndexRow
          href={`/posts/${post.id}/`}
          indexNum={String(i + 1).padStart(2, '0')}
          title={post.data.title}
          meta={formatShortMonthYear(post.data.date)}
          badge={post.data.interactive ? 'lab' : undefined}
        />
      ))}
    </ul>
  </section>

  <!-- Selected Projects (2x2 Architectural Hairline Lattice with Illuminated Hover) -->
  <section aria-labelledby="projects-heading" class="reveal" style="--index: 3;">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <div class="flex items-center gap-3">
        <div class="kolam-diamond-node relative static! size-3 shrink-0" aria-hidden="true" />
        <h2 id="projects-heading" class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
          Projects
        </h2>
      </div>
      <a
        href="/projects/"
        class="group/more inline-flex items-center gap-1 font-mono text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors duration-150 whitespace-nowrap"
      >
        <span>All {projects.length}</span>
        <span class="inline-block group-hover/more:translate-x-0.5 transition-transform duration-150" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="vav-lattice grid grid-cols-1 sm:grid-cols-2">
      {featuredProjects.map((project, i) => (
        <ProjectCard
          title={project.title}
          script={project.script}
          summary={project.summary}
          description={project.description}
          url={project.url}
          tags={project.tags}
          index={i}
          headingTag="h3"
        />
      ))}
    </div>
  </section>

  <KolamDivider class="mt-20" />
</BaseLayout>

<style>
  .role-rotator {
    position: relative;
    line-height: inherit;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .role-slot {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(55%);
    animation: roleCycle 12s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .role-slot-1 { animation-delay: 0s; }
  .role-slot-2 { animation-delay: 3s; }
  .role-slot-3 { animation-delay: 6s; }
  .role-slot-4 { animation-delay: 9s; }

  @keyframes roleCycle {
    0% {
      opacity: 0;
      transform: translateY(55%);
    }
    5%, 22% {
      opacity: 1;
      transform: translateY(0%);
    }
    27%, 100% {
      opacity: 0;
      transform: translateY(-55%);
    }
  }

  .portrait-halo {
    animation: portraitHaloDrift 48s linear infinite;
  }

  @keyframes portraitHaloDrift {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .role-slot {
      animation: none !important;
      opacity: 0;
      transform: none;
    }
    .role-slot-1 {
      opacity: 1;
    }
    .portrait-halo {
      animation: none !important;
    }
  }
</style>
