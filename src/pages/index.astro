---
import BaseLayout from '../layouts/BaseLayout.astro';
import RightSidebar from '../components/RightSidebar.astro';
import SocialIcon from '../components/SocialIcon.astro';
import KolamDivider from '../components/KolamDivider.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { getTagMicroPillClasses, getTagIndicator, normalizeTagSlug } from '../utils/tags';
import { Image } from 'astro:assets';
import profileImage from '../../public/assets/images/profile.webp';
import readingTime from 'reading-time';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const reads = (await getCollection('reads')).filter((r) => !r.data.draft);

const totalPosts = posts.length;
const latestPost = posts[0];
const recentPosts = posts.slice(1, 4).map((post) => ({
  post,
  readTime: readingTime(post.body ?? '').text,
}));
const featuredProjects = projects.slice(0, 3);
const latestStats = latestPost ? readingTime(latestPost.body ?? '') : null;

function formatShortMonthYear(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}

function getPlatform(url: string): { icon: 'github' | 'huggingface' | 'devpost' | 'external'; label: string } {
  if (url.includes('github.com')) return { icon: 'github', label: 'GitHub' };
  if (url.includes('huggingface.co')) return { icon: 'huggingface', label: 'Hugging Face' };
  if (url.includes('devpost.com')) return { icon: 'devpost', label: 'Devpost' };
  return { icon: 'external', label: 'Project' };
}
---

<BaseLayout rightSidebar={true} jsonLdType="WebSite">
  <!-- Editorial Hero (Asymmetric split with signature concentric gold portrait anchor) -->
  <header class="reveal mb-9" style="--index: 0;">
    <div class="flex flex-col-reverse sm:flex-row sm:items-start sm:justify-between gap-6">
      <div class="min-w-0 flex-1">
        <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading leading-[1.15] tracking-tight text-balance">
          ML systems, agents, and what works in production.
        </h1>

        <p class="mt-4 font-body text-ink-light dark:text-silk-muted text-base leading-relaxed max-w-[54ch]">
          I build custom embeddings, agent tools, and evaluation frameworks at 6sense, and write about what holds up after the prototype.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/blog/"
            class="group inline-flex items-center gap-2 px-4 py-2 rounded-lg font-body text-sm font-medium whitespace-nowrap bg-terra-dark text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.22)] hover:bg-terra dark:bg-terra-light dark:text-night-950 dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.35)] dark:hover:bg-[#ea8c64] transition-[color,background-color,border-color,transform] duration-150 active:scale-[0.98]"
          >
            <span>Read the blog</span>
            <svg class="size-4 transition-transform duration-150 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="/about/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-body text-sm font-medium whitespace-nowrap border border-cream-300 dark:border-night-700 bg-cream-50/90 dark:bg-night-800/90 text-ink dark:text-silk hover:border-terra dark:hover:border-terra-light hover:text-terra dark:hover:text-terra-light transition-[color,background-color,border-color,transform] duration-150 active:scale-[0.98]"
          >
            About me
          </a>
        </div>
      </div>

      <!-- Concentric Gold Portrait Anchor (echoes /about/ halo without repeating sidebar identity text) -->
      <a
        href="/about/"
        class="group/portrait relative shrink-0 self-start mt-1 sm:mt-2"
        aria-label="About Jay Shah"
        title="About Jay Shah"
      >
        <div class="absolute -inset-2 rounded-full border border-dashed border-gold/45 dark:border-gold-light/45 group-hover/portrait:border-terra/60 dark:group-hover/portrait:border-terra-light/60 transition-colors duration-150" aria-hidden="true" />
        <div class="absolute -inset-3.5 rounded-full border border-terra/15 dark:border-terra-light/20" aria-hidden="true" />
        <div class="relative size-[76px] sm:size-[88px] rounded-full overflow-hidden ring-2 ring-gold/60 dark:ring-gold-light/60 bg-cream-100 dark:bg-night-800 p-0.5 shadow-sm">
          <div class="relative size-full rounded-full overflow-hidden">
            <Image
              src={profileImage}
              alt="Jay Shah"
              width={88}
              height={88}
              densities={[1.5, 2]}
              quality={92}
              class="size-full object-cover object-top rounded-full portrait-hover-zoom"
            />
          </div>
        </div>
      </a>
    </div>
  </header>

  <!-- Featured Essay (Harmonized with PostCard visual grammar, edge-to-edge split artwork) -->
  {latestPost && (
    <section aria-labelledby="featured-heading" class="reveal mb-10" style="--index: 1;">
      <h2 id="featured-heading" class="sr-only">Featured essay</h2>
      <article class="group relative rounded-xl border border-terra/30 dark:border-terra-light/20 featured-card rangoli-corners overflow-hidden hover:border-terra dark:hover:border-terra-light hover:shadow-md transition-colors duration-150">
        <div class="grid grid-cols-1 sm:grid-cols-12 items-stretch relative z-10">
          {latestPost.data.image && (
            <div class="sm:col-span-5 bg-cream-100 dark:bg-night-900 border-b sm:border-b-0 sm:border-r border-cream-200/70 dark:border-night-700/70 overflow-hidden">
              <img
                src={latestPost.data.image}
                alt={latestPost.data.title}
                class="w-full h-48 sm:h-full object-cover card-hover-zoom"
                loading="eager"
              />
            </div>
          )}
          <div class:list={['p-5 sm:p-6 flex flex-col justify-between gap-4', latestPost.data.image ? 'sm:col-span-7' : 'sm:col-span-12']}>
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2.5">
                <span class="inline-block font-mono text-[11px] uppercase text-terra dark:text-terra-light px-2 py-0.5 rounded bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20" style="letter-spacing: 0.1em;">
                  Latest
                </span>
                {latestPost.data.interactive && (
                  <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase text-mor dark:text-mor-light px-2 py-0.5 rounded bg-mor/10 dark:bg-mor-light/10 border border-mor/25 dark:border-mor-light/25 font-medium" style="letter-spacing: 0.08em;">
                    <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="2" x2="6" y1="14" y2="14"/><line x1="10" x2="14" y1="8" y2="8"/><line x1="18" x2="22" y1="16" y2="16"/></svg>
                    Interactive Lab
                  </span>
                )}
              </div>
              <h3 class="font-display text-xl sm:text-2xl text-ink dark:text-silk leading-snug group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 text-balance">
                <a href={`/posts/${latestPost.id}/`}>
                  <span class="absolute inset-0 z-0" aria-hidden="true"></span>
                  {latestPost.data.title}
                </a>
              </h3>
              <p class="mt-2 font-body text-sm text-ink-light dark:text-silk-muted leading-relaxed line-clamp-3">
                {latestPost.data.description}
              </p>
              {latestPost.data.tags.length > 0 && (
                <div class="mt-3 relative z-10">
                  <TagList tags={latestPost.data.tags} max={3} postSlug={latestPost.id} variant="micro" />
                </div>
              )}
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-cream-200/70 dark:border-night-700/70 text-xs text-ink-muted dark:text-silk-faint">
              <div class="flex items-center gap-2 font-mono tabular-nums whitespace-nowrap">
                <span class="inline-flex items-center gap-1.5">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4m-5 4h18"/></svg>
                  <FormattedDate date={latestPost.data.date} />
                </span>
                {latestStats && (
                  <>
                    <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
                    <span>{latestStats.text}</span>
                  </>
                )}
              </div>
              <span class="font-body font-medium text-terra dark:text-terra-light inline-flex items-center gap-1 whitespace-nowrap">
                {latestPost.data.interactive ? 'Open lab' : 'Read article'}
                <svg class="size-3.5 transition-transform duration-150 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </div>
      </article>
    </section>
  )}

  <KolamDivider class="my-10" />

  <!-- Recent Writing (Vav Stepwell Spine — harmonized with /archives/ and /about/) -->
  <section aria-labelledby="recent-writing-heading" class="reveal" style="--index: 2;">
    <div class="flex items-center justify-between gap-4 mb-5">
      <div class="flex items-center gap-3">
        <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
        <h2 id="recent-writing-heading" class="font-display text-xl sm:text-2xl text-ink dark:text-silk">
          Recent writing
        </h2>
      </div>
      <a
        href="/blog/"
        class="font-mono text-xs text-terra dark:text-terra-light hover:underline whitespace-nowrap"
      >
        All {totalPosts} posts &rarr;
      </a>
    </div>

    <div class="stepwell-spine pl-8">
      <ul class="space-y-2">
        {recentPosts.map(({ post, readTime }) => (
          <li class="relative group">
            <div
              class="kolam-diamond-node hub-row-node pointer-events-none -left-[27px] top-4 group-hover:border-gold group-hover:ring-2 group-hover:ring-gold/30 dark:group-hover:ring-gold/35"
              aria-hidden="true"
            />
            <a
              href={`/posts/${post.id}/`}
              class="hub-row-link block p-3 rounded-xl border border-transparent group-hover:border-cream-300 dark:group-hover:border-[#3a3348] group-hover:bg-cream-200/55 dark:group-hover:bg-night-800/75 transition-colors"
            >
              <div class="flex items-center gap-2 font-mono text-[11px] text-ink-muted dark:text-silk-faint tabular-nums mb-1">
                <span>{formatShortMonthYear(post.data.date)}</span>
                <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
                <span>{readTime}</span>
              </div>
              <h3 class="hub-row-title font-display text-base sm:text-lg text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors leading-snug">
                {post.data.title}
              </h3>
              <p class="mt-1 font-body text-sm text-ink-light dark:text-silk-muted line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <KolamDivider class="my-10" />

  <!-- Selected Projects (Asymmetric 1+2 Bento Grid — harmonized with /projects/) -->
  <section aria-labelledby="selected-projects-heading" class="reveal" style="--index: 3;">
    <div class="flex items-center justify-between gap-4 mb-5">
      <div class="flex items-center gap-3">
        <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
        <h2 id="selected-projects-heading" class="font-display text-xl sm:text-2xl text-ink dark:text-silk">
          Selected projects
        </h2>
      </div>
      <a
        href="/projects/"
        class="font-mono text-xs text-terra dark:text-terra-light hover:underline whitespace-nowrap"
      >
        All {projects.length} projects &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {featuredProjects.map((project, idx) => {
        const isFlagship = idx === 0;
        const platform = getPlatform(project.url);
        return (
          <article
            class:list={[
              'group relative overflow-hidden flex flex-col justify-between rounded-xl border featured-card rangoli-corners transition-colors duration-150',
              isFlagship
                ? 'sm:col-span-2 p-5 sm:p-6 border-terra/30 dark:border-terra-light/25 hover:border-terra dark:hover:border-terra-light hover:shadow-md'
                : 'p-4 sm:p-5 border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light',
            ]}
          >
            <div class="relative z-10">
              {isFlagship && (
                <div class="mb-2.5 flex items-center justify-between gap-2">
                  <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase text-terra dark:text-terra-light px-2.5 py-0.5 rounded-full bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20 font-semibold" style="letter-spacing: 0.1em;">
                    &#9733; Flagship System
                  </span>
                  <span class="font-mono text-[11px] text-mor dark:text-mor-light flex items-center gap-1.5 font-medium">
                    <span class="size-1.5 rounded-full bg-mor dark:bg-mor-light" aria-hidden="true" />
                    Active Open-Source
                  </span>
                </div>
              )}

              <div class="flex items-start justify-between gap-2">
                <h3 class:list={[
                  'font-display text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 leading-snug',
                  isFlagship ? 'text-lg sm:text-xl' : 'text-base sm:text-lg',
                ]}>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="absolute inset-0 z-0" aria-hidden="true"></span>
                    {project.title}
                  </a>
                </h3>
                <div class="text-ink-faint dark:text-silk-faint group-hover:text-terra dark:group-hover:text-terra-light transition-colors duration-150 shrink-0 mt-0.5">
                  <SocialIcon name={platform.icon} class="size-4" />
                </div>
              </div>

              <p class:list={[
                'mt-2 font-body text-ink-light dark:text-silk-muted leading-relaxed text-pretty',
                isFlagship ? 'text-sm max-w-2xl' : 'text-xs sm:text-sm line-clamp-3',
              ]}>
                {project.description}
              </p>

              {project.tags.length > 0 && (
                <div class="mt-3 relative z-10 flex flex-wrap gap-1.5">
                  {project.tags.slice(0, isFlagship ? 4 : 3).map((tag) => (
                    <a
                      href={`/tags/${encodeURIComponent(normalizeTagSlug(tag))}/`}
                      class={getTagMicroPillClasses(tag)}
                    >
                      {getTagIndicator(tag) && (
                        <span class="text-[8px] opacity-60" aria-hidden="true">{getTagIndicator(tag)}</span>
                      )}
                      {tag}
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="relative z-10 flex items-center justify-between gap-2 mt-4 pt-3 border-t border-cream-200/60 dark:border-night-700/60 text-xs">
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-ink-faint dark:text-silk-faint">
                <SocialIcon name={platform.icon} class="size-3.5 opacity-80" />
                {platform.label}
              </span>
              <span class="inline-flex items-center gap-1 font-body font-medium text-terra dark:text-terra-light group-hover:translate-x-0.5 transition-transform duration-150">
                View repository &rarr;
              </span>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Quiet Footer with RSS & Discovery Links -->
  <footer class="reveal mt-12 pt-6 border-t border-cream-200 dark:border-night-700 flex flex-wrap items-center justify-between gap-4 text-xs" style="--index: 4;">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-terra/25 dark:border-terra-light/25 font-mono text-terra dark:text-terra-light hover:bg-terra/10 dark:hover:bg-terra-light/10 transition-[color,background-color,border-color,transform] duration-150 active:scale-[0.98]"
      >
        <SocialIcon name="rss" class="size-3.5" />
        Subscribe via RSS
      </a>
      <a
        href="/reads/"
        class="font-body text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors"
      >
        Reads ({reads.length} notes)
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-ink-muted dark:text-silk-faint">
      <a href="/llms.txt" class="hover:text-terra dark:hover:text-terra-light transition-colors">llms.txt</a>
      <span class="text-cream-300 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
      <a href="/openapi.json" class="hover:text-terra dark:hover:text-terra-light transition-colors">OpenAPI</a>
      <span class="text-cream-300 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
      <a href="/api/docs/" class="hover:text-terra dark:hover:text-terra-light transition-colors">API Docs</a>
    </div>
  </footer>

  <RightSidebar slot="right-sidebar" variant="hub" />
</BaseLayout>

<style>
  .hub-row-node,
  .hub-row-link,
  .hub-row-title {
    transition-duration: 75ms !important;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
</style>
