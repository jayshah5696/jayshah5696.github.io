---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const markdownRecoveryText = `# 404 — Resource Not Found

The requested URL does not exist on https://jayshah.dev.

## Agent & Crawler Recovery Index
- Sitemap Index: https://jayshah.dev/sitemap-index.xml
- LLM Overview: https://jayshah.dev/llms.txt
- Full LLM Context: https://jayshah.dev/llms-full.txt
- OpenAPI Spec: https://jayshah.dev/openapi.json
- Agent Instructions: https://jayshah.dev/.well-known/agent-instructions.md
- Posts API: https://jayshah.dev/api/posts.json
- Projects API: https://jayshah.dev/api/projects.json
- Home Page: https://jayshah.dev/
- About Page: https://jayshah.dev/about/
- Projects: https://jayshah.dev/projects/
- Reading List: https://jayshah.dev/reads/`;
---

<BaseLayout title="404 — Page Not Found" description="The requested page could not be found on jayshah.dev. Use the sitemap or LLM index to navigate.">
  <div class="py-8">
    <div class="text-center mb-8">
      <p class="font-display text-7xl text-cream-300 dark:text-night-800 mb-2">404</p>
      <h1 class="font-display text-2xl sm:text-3xl text-ink dark:text-silk carved-heading mb-2">
        Page Not Found
      </h1>
      <p class="font-mono text-xs uppercase text-ink-muted dark:text-silk-faint mb-4" style="letter-spacing: 0.15em;">
        The requested resource does not exist
      </p>
      <div class="kolam-border mb-8"></div>
    </div>

    <!-- Agent & Machine Recovery Block -->
    <section aria-labelledby="recovery-heading" class="mb-10 p-5 rounded-xl border border-cream-200 dark:border-night-700 bg-white dark:bg-night-800/80 shadow-xs">
      <div class="flex items-center justify-between mb-3 border-b border-cream-200 dark:border-night-700 pb-2">
        <h2 id="recovery-heading" class="font-mono text-xs uppercase text-terra dark:text-terra-light font-semibold" style="letter-spacing: 0.1em;">
          Agent &amp; Crawler Recovery Guide
        </h2>
        <span class="font-mono text-[10px] text-ink-faint dark:text-silk-faint">text/markdown</span>
      </div>
      <pre class="font-mono text-xs text-ink-light dark:text-silk-muted overflow-x-auto whitespace-pre-wrap bg-cream-50 dark:bg-night-900/90 p-4 rounded-lg border border-cream-200/60 dark:border-night-700/60 leading-relaxed">{markdownRecoveryText}</pre>
    </section>

    <!-- Human Navigation Links -->
    <section aria-labelledby="links-heading" class="mb-10">
      <h2 id="links-heading" class="font-mono text-xs uppercase text-ink-faint dark:text-silk-faint mb-4 tracking-wider">
        Quick Recovery Links
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a
          href="/"
          class="flex flex-col p-3 rounded-lg border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light text-ink dark:text-silk transition-colors text-center"
        >
          <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light">/</span>
          <span class="text-xs text-ink-muted dark:text-silk-muted mt-1">Home</span>
        </a>
        <a
          href="/llms.txt"
          class="flex flex-col p-3 rounded-lg border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light text-ink dark:text-silk transition-colors text-center"
        >
          <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light">/llms.txt</span>
          <span class="text-xs text-ink-muted dark:text-silk-muted mt-1">LLM Index</span>
        </a>
        <a
          href="/sitemap-index.xml"
          class="flex flex-col p-3 rounded-lg border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light text-ink dark:text-silk transition-colors text-center"
        >
          <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light">/sitemap</span>
          <span class="text-xs text-ink-muted dark:text-silk-muted mt-1">XML Sitemap</span>
        </a>
        <a
          href="/openapi.json"
          class="flex flex-col p-3 rounded-lg border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light text-ink dark:text-silk transition-colors text-center"
        >
          <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light">/openapi.json</span>
          <span class="text-xs text-ink-muted dark:text-silk-muted mt-1">API Schema</span>
        </a>
      </div>
    </section>

    {posts.length > 0 && (
      <section aria-labelledby="recent-posts-heading" class="mb-10">
        <h2 id="recent-posts-heading" class="font-mono text-xs uppercase text-ink-faint dark:text-silk-faint mb-4 tracking-wider">
          Recent Writings
        </h2>
        <ul class="space-y-2.5">
          {posts.map((post) => (
            <li>
              <a
                href={`/posts/${post.id}/`}
                class="text-sm text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors flex items-center gap-2"
              >
                <span class="text-terra dark:text-terra-light">&rsaquo;</span>
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="pt-4 border-t border-cream-200 dark:border-night-700">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-sm text-terra hover:text-terra-dark dark:text-terra-light dark:hover:text-terra transition-colors duration-200"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Return to Home
      </a>
    </div>
  </div>
</BaseLayout>
