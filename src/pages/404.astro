---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found (404)" description="The requested URL was not found on jayshah.dev.">
  <div class="py-12 max-w-lg">
    <p class="font-mono text-xs text-ink-faint dark:text-silk-faint mb-3 tabular-nums">404</p>
    <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">
      Page Not Found
    </h1>
    <p class="mt-5 font-body text-base text-ink-muted dark:text-silk-muted leading-relaxed">
      This page does not exist on jayshah.dev.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs">
      <a href="/" class="text-terra dark:text-terra-light hover:underline underline-offset-4">
        &larr; Home
      </a>
      <a href="/blog/" class="text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors">
        Blog
      </a>
      <a href="/projects/" class="text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors">
        Projects
      </a>
      <a href="/about/" class="text-ink-muted dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors">
        About
      </a>
    </div>

    <details class="mt-12 font-mono text-xs text-ink-faint dark:text-silk-faint">
      <summary class="cursor-pointer hover:text-terra dark:hover:text-terra-light transition-colors select-none">
        Machine-readable endpoints
      </summary>
      <ul class="mt-3 space-y-1.5 pl-4">
        <li><a href="/sitemap-index.xml" class="hover:text-terra dark:hover:text-terra-light">/sitemap-index.xml</a></li>
        <li><a href="/llms.txt" class="hover:text-terra dark:hover:text-terra-light">/llms.txt</a></li>
        <li><a href="/openapi.json" class="hover:text-terra dark:hover:text-terra-light">/openapi.json</a></li>
        <li><a href="/api/posts.json" class="hover:text-terra dark:hover:text-terra-light">/api/posts.json</a></li>
        <li><a href="/api/docs/" class="hover:text-terra dark:hover:text-terra-light">/api/docs/</a></li>
      </ul>
    </details>
  </div>
</BaseLayout>
