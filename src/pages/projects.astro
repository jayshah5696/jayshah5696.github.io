---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Engineering Projects" description="Selected open-source machine learning systems, agent tooling, and software repositories by Jay Shah.">
  <header class="mb-8">
    <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">Engineering Projects &amp; Tools</h1>
    <p class="mt-4 text-ink-light dark:text-silk-muted text-base leading-relaxed">
      Selected open-source machine learning systems, developer agent extensions, retrieval pipelines, and software repositories.
    </p>
    <div class="kolam-border mt-5"></div>
  </header>

  <div class="grid gap-5 sm:grid-cols-2">
    {projects.map((project, i) => (
      <ProjectCard
        title={project.title}
        description={project.description}
        url={project.url}
        tags={project.tags}
        featured={i === 0}
      />
    ))}
  </div>
</BaseLayout>

