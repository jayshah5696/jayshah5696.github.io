---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadCard from '../components/ReadCard.astro';
import { getCollection } from 'astro:content';
import { normalizeTagSlug, getTagDotClass } from '../utils/tags';

const entries = (await getCollection('reads'))
  .filter((r) => !r.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalLinks = entries.length;

interface MonthGroup {
  monthName: string;
  monthNum: string;
  entries: typeof entries;
}

const grouped: Record<string, Record<string, MonthGroup>> = {};
const tagCounts: Record<string, number> = {};

entries.forEach((entry) => {
  const date = entry.data.date;
  const year = date.getFullYear().toString();
  const monthName = date.toLocaleString('en-US', { month: 'long' });
  const monthNum = String(date.getMonth() + 1).padStart(2, '0');

  if (!grouped[year]) grouped[year] = {};
  if (!grouped[year][monthNum]) {
    grouped[year][monthNum] = { monthName, monthNum, entries: [] };
  }
  grouped[year][monthNum].entries.push(entry);

  new Set(entry.data.tags.map(normalizeTagSlug)).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
const topTopics = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([tag]) => tag);
---

<BaseLayout
  title="Reads"
  description="Curated papers, articles, and links on AI, ML systems, and engineering with personal notes by Jay Shah."
>
  <header class="reveal mb-10">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">
        Reads
      </h1>
      <span class="font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums">
        {totalLinks}
      </span>
    </div>

    <!-- Quiet inline topic filter with Vav jewel dots -->
    <nav aria-label="Topics" class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-xs text-ink-faint dark:text-silk-faint">
      {topTopics.map((tag) => (
        <a
          href={`/reads/?tag=${encodeURIComponent(tag)}`}
          data-tag-link={tag}
          class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
        >
          <span class:list={['size-1.5 rounded-full', getTagDotClass(tag)]} aria-hidden="true" />
          <span>#{tag}</span>
        </a>
      ))}
      <a
        href="/tags/"
        class="group/more inline-flex items-center gap-1 text-terra dark:text-terra-light hover:underline underline-offset-2 transition-colors duration-150"
      >
        <span>all tags</span>
        <span class="inline-block group-hover/more:translate-x-0.5 transition-transform duration-150" aria-hidden="true">&rarr;</span>
      </a>
    </nav>
  </header>

  {totalLinks === 0 ? (
    <p class="font-body text-sm text-ink-muted dark:text-silk-muted">No reading notes yet.</p>
  ) : (
    <div class="space-y-8">
      <!-- Quiet underline search input -->
      <div class="reveal flex items-center gap-3 pb-2.5 border-b border-terra/20 dark:border-gold/20 focus-within:border-terra dark:focus-within:border-terra-light transition-colors duration-150">
        <svg class="size-4 text-ink-faint dark:text-silk-faint shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="text"
          id="reads-search-input"
          class="w-full bg-transparent border-none outline-none font-body text-sm text-ink dark:text-silk placeholder:text-ink-faint dark:placeholder:text-silk-faint"
          placeholder="Filter reads..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Filter reads"
        />
        <button
          type="button"
          id="reset-all-btn"
          class="hidden font-mono text-xs text-terra dark:text-terra-light hover:underline shrink-0 cursor-pointer"
          aria-label="Clear filter"
        >
          clear
        </button>
        <kbd class="hidden sm:inline-block font-mono text-[11px] text-ink-faint dark:text-silk-faint select-none opacity-60">
          /
        </kbd>
      </div>

      <!-- Active Tag Line -->
      <div id="active-tag-banner" class="hidden items-center justify-between font-mono text-xs text-ink-muted dark:text-silk-muted">
        <span>Topic: <strong id="active-tag-label" class="text-terra dark:text-terra-light font-medium">#tag</strong></span>
        <button type="button" id="clear-tag-btn" class="text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light cursor-pointer">
          clear
        </button>
      </div>

      <!-- Empty State -->
      <div id="reads-empty-state" class="hidden py-10 text-center">
        <p class="font-body text-sm text-ink-muted dark:text-silk-muted">
          No matching notes.
        </p>
        <button
          type="button"
          data-reset-reads-filters
          class="mt-3 font-mono text-xs text-terra dark:text-terra-light hover:underline cursor-pointer"
        >
          Clear filter
        </button>
      </div>

      <!-- Timeline Content -->
      <div id="reads-timeline-root" class="space-y-12">
        {years.map((year, yIdx) => (
          <section class="reveal year-section" data-year={year}>
            <div class="flex items-center gap-3 mb-6">
              <div class="kolam-diamond-node relative static! ml-[5.5px] size-3 shrink-0" aria-hidden="true" />
              <h2 class="font-mono text-sm text-ink-muted dark:text-silk-muted tabular-nums">
                {year}
              </h2>
            </div>

            <div class="year-months-wrapper space-y-8">
              {Object.keys(grouped[year])
                .sort((a, b) => Number(b) - Number(a))
                .map((monthNum, mIdx) => {
                  const group = grouped[year][monthNum];
                  const isCurrentMonth = yIdx === 0 && mIdx === 0;
                  return (
                    <div
                      class="timeline-month-branch relative pl-7 sm:pl-8 stepwell-spine"
                      data-month={monthNum}
                      data-year={year}
                      data-current-month={isCurrentMonth ? 'true' : 'false'}
                      id={`month-${year}-${monthNum}`}
                    >
                      <div
                        class="timeline-node-dot kolam-diamond-node left-[5.5px] top-1.5 size-3"
                        aria-hidden="true"
                      />

                      <button
                        type="button"
                        class="month-accordion-header vav-row-hover w-full flex items-baseline justify-between gap-4 cursor-pointer select-none mb-2 px-2 -mx-2 py-1 group/month text-left"
                        aria-expanded={isCurrentMonth ? 'true' : 'false'}
                      >
                        <h3 class="font-body font-medium text-sm tracking-wide text-terra dark:text-terra-light group-hover/month:underline underline-offset-4">
                          {group.monthName}
                        </h3>
                        <span class="font-mono text-xs text-ink-faint dark:text-silk-faint group-hover/month:text-terra dark:group-hover/month:text-terra-light transition-colors duration-150 tabular-nums">
                          {group.entries.length}
                        </span>
                      </button>

                      <div class:list={['month-cards-wrapper', { hidden: !isCurrentMonth }]}>
                        {group.entries.map((entry) => (
                          <ReadCard entry={entry} expanded={false} />
                        ))}
                      </div>
                    </div>
                  );
                })}
            </div>
          </section>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

<script is:inline data-astro-rerun>
  (function initReadsPage() {
    var searchInput = document.getElementById('reads-search-input');
    var activeTagBanner = document.getElementById('active-tag-banner');
    var activeTagLabel = document.getElementById('active-tag-label');
    var clearTagBtn = document.getElementById('clear-tag-btn');
    var resetAllBtn = document.getElementById('reset-all-btn');
    var emptyStateEl = document.getElementById('reads-empty-state');
    var timelineRoot = document.getElementById('reads-timeline-root');

    if (!searchInput) return;

    var TAG_ALIASES = {
      ml: 'machine-learning',
      evaluation: 'evals',
      mrl: 'matryoshka-representation-learning',
    };

    function normalizeTag(tag) {
      var slug = String(tag || '').toLowerCase().trim().replace(/\s+/g, '-');
      return TAG_ALIASES[slug] || slug;
    }

    var state = {
      search: '',
      tag: 'all',
    };

    function setCardExpanded(card, isExpanded) {
      var collapse = card.querySelector('.read-card-notes-collapse');
      if (!collapse) return;
      card.dataset.expanded = isExpanded ? 'true' : 'false';
      collapse.setAttribute('aria-hidden', isExpanded ? 'false' : 'true');
      if (isExpanded) {
        collapse.removeAttribute('inert');
      } else {
        collapse.setAttribute('inert', '');
      }
      var toggleBtn = card.querySelector('.read-card-toggle');
      var toggleLabel = card.querySelector('.read-card-toggle-label');
      var chevron = card.querySelector('.read-card-chevron');
      if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      }
      if (toggleLabel) {
        toggleLabel.textContent = isExpanded ? 'hide note' : 'read note';
      }
      if (chevron) {
        chevron.classList.toggle('rotate-180', isExpanded);
      }
    }

    // Read URL query parameter ?tag=... on load
    var urlParams = new URLSearchParams(window.location.search);
    var initialTag = urlParams.get('tag');
    if (initialTag) {
      var normalizedInitial = normalizeTag(initialTag);
      state.tag = normalizedInitial;
      if (activeTagBanner && activeTagLabel) {
        activeTagLabel.textContent = '#' + normalizedInitial;
        activeTagBanner.classList.remove('hidden');
        activeTagBanner.classList.add('flex');
      }
    }

    // Card Click-to-Expand
    document.querySelectorAll('.read-card-item[data-has-notes="true"]').forEach(function(card) {
      card.onclick = function(e) {
        if (e.target.closest('a') || e.target.closest('.read-card-notes')) {
          return;
        }
        var willExpand = card.dataset.expanded !== 'true';
        setCardExpanded(card, willExpand);
      };
    });

    // Month Accordion Header Toggle
    document.querySelectorAll('.month-accordion-header').forEach(function(header) {
      header.onclick = function() {
        var branch = header.closest('.timeline-month-branch');
        var wrapper = branch.querySelector('.month-cards-wrapper');
        if (wrapper) {
          var isHidden = wrapper.classList.toggle('hidden');
          header.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        }
      };
    });

    // Search Input
    searchInput.addEventListener('input', function(e) {
      state.search = e.target.value.toLowerCase().trim();
      applyFilters();
    });

    // Keyboard shortcut "/" to focus local reads search
    if (window.__readsKeydownHandler) {
      document.removeEventListener('keydown', window.__readsKeydownHandler);
    }
    window.__readsKeydownHandler = function(e) {
      var input = document.getElementById('reads-search-input');
      if (!input) {
        document.removeEventListener('keydown', window.__readsKeydownHandler);
        window.__readsKeydownHandler = null;
        return;
      }
      var activeTag = document.activeElement ? document.activeElement.tagName : '';
      var isEditable = activeTag === 'INPUT' || activeTag === 'TEXTAREA' || (document.activeElement && document.activeElement.isContentEditable);
      if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey && !isEditable) {
        e.preventDefault();
        input.focus();
      }
      if (e.key === 'Escape' && document.activeElement === input) {
        input.value = '';
        state.search = '';
        input.blur();
        applyFilters();
      }
    };
    document.addEventListener('keydown', window.__readsKeydownHandler);

    function handleTagClick(tag) {
      var normalized = normalizeTag(tag);
      state.tag = normalized;
      if (activeTagBanner && activeTagLabel) {
        activeTagLabel.textContent = '#' + normalized;
        activeTagBanner.classList.remove('hidden');
        activeTagBanner.classList.add('flex');
      }
      var newUrl = window.location.pathname + '?tag=' + encodeURIComponent(normalized);
      window.history.pushState({ tag: normalized }, '', newUrl);
      applyFilters();
    }

    document.querySelectorAll('[data-tag-link]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        e.stopPropagation();
        var tag = link.dataset.tagLink;
        if (tag) handleTagClick(tag);
      });
    });

    if (clearTagBtn) {
      clearTagBtn.addEventListener('click', function() {
        state.tag = 'all';
        if (activeTagBanner) {
          activeTagBanner.classList.add('hidden');
          activeTagBanner.classList.remove('flex');
        }
        window.history.pushState({}, '', window.location.pathname);
        applyFilters();
      });
    }

    function resetAllFilters() {
      searchInput.value = '';
      state.search = '';
      state.tag = 'all';
      if (activeTagBanner) {
        activeTagBanner.classList.add('hidden');
        activeTagBanner.classList.remove('flex');
      }
      window.history.pushState({}, '', window.location.pathname);
      applyFilters();
    }

    if (resetAllBtn) {
      resetAllBtn.addEventListener('click', resetAllFilters);
    }
    document.querySelectorAll('[data-reset-reads-filters]').forEach(function(btn) {
      btn.addEventListener('click', resetAllFilters);
    });

    function applyFilters() {
      var totalVisible = 0;
      var hasActiveFilters = Boolean(state.search || state.tag !== 'all');

      if (resetAllBtn) {
        resetAllBtn.classList.toggle('hidden', !hasActiveFilters);
      }

      document.querySelectorAll('.year-section').forEach(function(ySection) {
        var yearHasVisible = false;

        ySection.querySelectorAll('.timeline-month-branch').forEach(function(mBranch) {
          var monthHasVisible = false;

          mBranch.querySelectorAll('.read-card-item').forEach(function(card) {
            var cardTitle = card.dataset.title || '';
            var cardDomain = card.dataset.domain || '';
            var cardTags = (card.dataset.tags || '').split(',').filter(Boolean);
            var cardText = card.textContent.toLowerCase();

            var matchTag = state.tag === 'all' || cardTags.indexOf(state.tag) !== -1;
            var matchSearch = !state.search ||
              cardTitle.indexOf(state.search) !== -1 ||
              cardDomain.indexOf(state.search) !== -1 ||
              cardText.indexOf(state.search) !== -1;

            if (matchTag && matchSearch) {
              card.classList.remove('hidden');
              if (hasActiveFilters) card.classList.add('is-visible');
              monthHasVisible = true;
              yearHasVisible = true;
              totalVisible++;
            } else {
              card.classList.add('hidden');
            }
          });

          mBranch.classList.toggle('hidden', !monthHasVisible);

          var wrapper = mBranch.querySelector('.month-cards-wrapper');
          var header = mBranch.querySelector('.month-accordion-header');
          if (monthHasVisible && hasActiveFilters) {
            if (wrapper) wrapper.classList.remove('hidden');
            if (header) header.setAttribute('aria-expanded', 'true');
          } else if (!hasActiveFilters) {
            var isCurrent = mBranch.dataset.currentMonth === 'true';
            if (wrapper) wrapper.classList.toggle('hidden', !isCurrent);
            if (header) header.setAttribute('aria-expanded', isCurrent ? 'true' : 'false');
          }
        });

        ySection.classList.toggle('hidden', !yearHasVisible);
        if (yearHasVisible && hasActiveFilters) ySection.classList.add('is-visible');
      });

      var isEmpty = totalVisible === 0 && hasActiveFilters;
      if (emptyStateEl) emptyStateEl.classList.toggle('hidden', !isEmpty);
      if (timelineRoot) timelineRoot.classList.toggle('hidden', isEmpty);
    }

    applyFilters();
  })();
</script>
