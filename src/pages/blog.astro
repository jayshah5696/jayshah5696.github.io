---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import IndexRow from '../components/IndexRow.astro';
import { getCollection } from 'astro:content';
import { normalizeTagSlug, getTagDotClass } from '../utils/tags';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPosts = posts.length;
const [latestPost, ...olderPosts] = posts;

const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  new Set(post.data.tags.map(normalizeTagSlug)).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const topTopics = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([tag]) => tag);

function formatShortMonthYear(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title="Blog"
  description="Technical essays, interactive labs, and production notes on machine learning systems, embeddings, and AI agents by Jay Shah."
  jsonLdType="CollectionPage"
>
  <header class="reveal mb-10">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">
        Blog
      </h1>
      <div class="flex items-center gap-4 font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums">
        <span>{totalPosts} posts</span>
        <a
          href="/archives/"
          class="group/more inline-flex items-center gap-1 hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
        >
          <span>Archives</span>
          <span class="inline-block group-hover/more:translate-x-0.5 transition-transform duration-150" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Quiet jewel-dotted topic navigation -->
    <nav aria-label="Topics" class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-xs text-ink-faint dark:text-silk-faint">
      {topTopics.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="inline-flex items-center gap-1.5 hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
        >
          <span class:list={['size-1.5 rounded-full', getTagDotClass(tag)]} aria-hidden="true" />
          <span>#{tag}</span>
        </a>
      ))}
      <a
        href="/tags/"
        class="group/more inline-flex items-center gap-1 text-terra dark:text-terra-light hover:underline underline-offset-2 transition-colors duration-150"
      >
        <span>all tags</span>
        <span class="inline-block group-hover/more:translate-x-0.5 transition-transform duration-150" aria-hidden="true">&rarr;</span>
      </a>
    </nav>
  </header>

  {latestPost && (
    <section aria-label="Latest post" class="mb-14">
      <PostCard
        title={latestPost.data.title}
        date={latestPost.data.date}
        description={latestPost.data.description}
        slug={latestPost.id}
        body={latestPost.body ?? ''}
        image={latestPost.data.image}
        interactive={latestPost.data.interactive}
        headingTag="h2"
      />
    </section>
  )}

  <section aria-label="All posts" class="reveal">
    <ul class="border-t border-terra/15 dark:border-gold/15">
      {olderPosts.map((post, i) => (
        <IndexRow
          href={`/posts/${post.id}/`}
          indexNum={String(i + 2).padStart(2, '0')}
          title={post.data.title}
          subtitle={post.data.description}
          meta={formatShortMonthYear(post.data.date)}
          badge={post.data.interactive ? 'lab' : undefined}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
