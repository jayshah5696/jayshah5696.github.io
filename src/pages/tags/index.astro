---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';
import { normalizeTagSlug, getTagDotClass } from '../../utils/tags';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const reads = (await getCollection('reads')).filter((r) => !r.data.draft);

const tagCounts: Record<string, number> = {};

posts.forEach((post) => {
  new Set(post.data.tags.map(normalizeTagSlug)).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

reads.forEach((read) => {
  new Set(read.data.tags.map(normalizeTagSlug)).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

projects.forEach((project) => {
  new Set(project.tags.map(normalizeTagSlug)).forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags" description="Browse all topics: AI, LLMs, RAG, developer tools, machine learning, and personal essays.">
  <header class="reveal mb-12">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">
        Tags
      </h1>
      <span class="font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums">
        {sortedTags.length}
      </span>
    </div>
  </header>

  <div class="reveal flex flex-wrap gap-x-6 gap-y-3.5">
    {sortedTags.map(([tag, count]) => (
      <a
        href={`/tags/${encodeURIComponent(tag)}/`}
        class="group inline-flex items-center gap-2 font-mono text-sm text-ink-light dark:text-silk-muted hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
      >
        <span class:list={['size-1.5 rounded-full opacity-85 group-hover:opacity-100', getTagDotClass(tag)]} aria-hidden="true" />
        <span>#{tag}</span>
        <span class="text-[11px] text-ink-faint dark:text-silk-faint tabular-nums">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>
