---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexRow from '../../components/IndexRow.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ReadCard from '../../components/ReadCard.astro';
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';
import { normalizeTagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const reads = (await getCollection('reads')).filter((r) => !r.data.draft);

  const tags = [...new Set([
    ...posts.flatMap((post) => post.data.tags.map(normalizeTagSlug)),
    ...reads.flatMap((read) => read.data.tags.map(normalizeTagSlug)),
    ...projects.flatMap((project) => project.tags.map(normalizeTagSlug)),
  ])];

  return tags.map((tag) => {
    const matchedPosts = posts
      .filter((post) => post.data.tags.some((t) => normalizeTagSlug(t) === tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    const matchedReads = reads
      .filter((read) => read.data.tags.some((t) => normalizeTagSlug(t) === tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    const matchedProjects = projects
      .filter((project) => project.tags.some((t) => normalizeTagSlug(t) === tag));

    return {
      params: { tag },
      props: {
        tag,
        posts: matchedPosts,
        reads: matchedReads,
        projects: matchedProjects,
      },
    };
  });
}

const { tag, posts, reads, projects: matchedProjects } = Astro.props;
const summaryParts = [
  posts.length > 0 ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}` : null,
  matchedProjects.length > 0 ? `${matchedProjects.length} ${matchedProjects.length === 1 ? 'project' : 'projects'}` : null,
  reads.length > 0 ? `${reads.length} ${reads.length === 1 ? 'read' : 'reads'}` : null,
].filter(Boolean);

function formatShortMonthYear(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title={`#${tag}`}
  description={`Browse ${summaryParts.join(', ')} about ${tag} by Jay Shah.`}
>
  <header class="reveal mb-12">
    <a href="/tags/" class="group/back inline-flex items-center gap-1.5 text-xs text-ink-faint dark:text-silk-faint hover:text-terra dark:hover:text-terra-light transition-colors duration-150 font-mono mb-4">
      <span class="inline-block group-hover/back:-translate-x-0.5 transition-transform duration-150" aria-hidden="true">&larr;</span>
      <span>All tags</span>
    </a>
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">
        #{tag}
      </h1>
      <span class="font-mono text-xs text-ink-faint dark:text-silk-faint tabular-nums">
        {summaryParts.join(' · ')}
      </span>
    </div>
  </header>

  <div class="space-y-14">
    {posts.length > 0 && (
      <section class="reveal">
        <div class="flex items-center gap-3 mb-4">
          <div class="kolam-diamond-node relative static! ml-[5.5px] size-3 shrink-0" aria-hidden="true" />
          <h2 class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
            Writing
          </h2>
        </div>
        <ul class="border-t border-terra/15 dark:border-gold/15">
          {posts.map((post, i) => (
            <IndexRow
              href={`/posts/${post.id}/`}
              indexNum={String(i + 1).padStart(2, '0')}
              title={post.data.title}
              subtitle={post.data.description}
              meta={formatShortMonthYear(post.data.date)}
              badge={post.data.interactive ? 'lab' : undefined}
            />
          ))}
        </ul>
      </section>
    )}

    {matchedProjects.length > 0 && (
      <section class="reveal">
        <div class="flex items-center gap-3 mb-5">
          <div class="kolam-diamond-node relative static! ml-[5.5px] size-3 shrink-0" aria-hidden="true" />
          <h2 class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
            Projects
          </h2>
        </div>
        <div class:list={['vav-lattice grid grid-cols-1', matchedProjects.length > 1 && 'sm:grid-cols-2']}>
          {matchedProjects.map((project, i) => (
            <ProjectCard
              title={project.title}
              script={project.script}
              summary={project.summary}
              description={project.description}
              url={project.url}
              tags={project.tags}
              index={i}
              headingTag="h3"
            />
          ))}
        </div>
      </section>
    )}

    {reads.length > 0 && (
      <section class="reveal">
        <div class="flex items-center gap-3 mb-4">
          <div class="kolam-diamond-node relative static! ml-[5.5px] size-3 shrink-0" aria-hidden="true" />
          <h2 class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
            Reads
          </h2>
        </div>
        <div class="border-t border-terra/15 dark:border-gold/15">
          {reads.map((read) => (
            <ReadCard entry={read} expanded={false} />
          ))}
        </div>
      </section>
    )}
  </div>

  <script is:inline data-astro-rerun>
    (function initTagReadCards() {
      document.querySelectorAll('.read-card-item[data-has-notes="true"]').forEach(function(card) {
        card.onclick = function(e) {
          if (e.target.closest('a') || e.target.closest('.read-card-notes')) return;
          var collapse = card.querySelector('.read-card-notes-collapse');
          if (!collapse) return;
          var isExpanded = card.dataset.expanded !== 'true';
          card.dataset.expanded = isExpanded ? 'true' : 'false';
          collapse.setAttribute('aria-hidden', isExpanded ? 'false' : 'true');
          if (isExpanded) collapse.removeAttribute('inert');
          else collapse.setAttribute('inert', '');
          var btn = card.querySelector('.read-card-toggle');
          var lbl = card.querySelector('.read-card-toggle-label');
          var chev = card.querySelector('.read-card-chevron');
          if (btn) btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
          if (lbl) lbl.textContent = isExpanded ? 'hide note' : 'read note';
          if (chev) chev.classList.toggle('rotate-180', isExpanded);
        };
      });
    })();
  </script>
</BaseLayout>
