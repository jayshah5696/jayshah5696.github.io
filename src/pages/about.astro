---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialIcon from '../components/SocialIcon.astro';
import KolamDivider from '../components/KolamDivider.astro';
import StepwellTimeline, { type TimelineItem } from '../components/StepwellTimeline.astro';
import { SOCIAL_LINKS, ABOUT_HEADLINE_PREFIX, ABOUT_ROTATING_PHRASES } from '../consts';
import { Image } from 'astro:assets';
import profileImage from '../../public/assets/images/profile.webp';

const CAREER_ITEMS: TimelineItem[] = [
  {
    period: '2026 - Present',
    role: 'Senior Machine Learning Engineer',
    organization: '6sense',
    orgUrl: 'https://6sense.com',
    current: true,
    description: 'Leading AI systems engineering initiatives for enterprise intent intelligence. Architecting foundational models with custom embeddings, model explainability pipelines, contextual knowledge graphs, and evaluation harnesses for autonomous agents.',
    highlights: [
      'Trained foundational models with custom embeddings to power B2B intent intelligence at enterprise scale.',
      'Shipped model explainability in production to provide transparent predictions for sales and marketing workflows.',
      'Architected a LLM agent evaluation framework adopted across the engineering and product organizations to prevent regressions.',
      'Built internal agents for key revenue acceleration use cases.',
      'Designed and developed a contextual knowledge graph to link enterprise accounts, intent signals, and buyer personas.',
    ],
    tags: ['AI AGENTS', 'FOUNDATIONAL MODELS', 'EMBEDDINGS', 'EVALS', 'KNOWLEDGE GRAPHS'],
  },
  {
    period: '2019 - 2026',
    role: 'Data Scientist III',
    organization: 'Avathon',
    orgUrl: 'https://avathon.com',
    description: 'Led foundation-model MLOps platforms, architected agent platforms with Model Context Protocol (MCP) tools, and built production anomaly detection and renewable energy forecasting systems across enterprise deployments.',
    highlights: [
      'Led foundation-model MLOps platform; cut release time 45% and increased model adoption.',
      'Architected agent platform with MCP tools to spin up domain agents in under 5 minutes; powered 20+ workflows.',
      'Built LLM interface integrating asset data, enabling reporting and task automation.',
      'Launched cross-site solar-storage autoencoder anomaly detection to predict failures and performance issues, saving >$500k.',
      'Shipped RAG compliance agent, reducing violations 10% and automating audit preparation for energy domains.',
      'Reduced false positives 25% by ranking predictive alerts and next-best actions with Bayesian analysis.',
    ],
    tags: ['MLOPS', 'MCP TOOLS', 'RAG', 'ANOMALY DETECTION', 'TIME-SERIES'],
  },
  {
    period: '2017 - 2019',
    role: 'Graduate Research Assistant',
    organization: 'Texas A&M University',
    orgUrl: 'https://www.tamu.edu',
    description: 'Graduate research focused on applying advanced machine learning and deep learning methods to solve and predict wind energy system failures under Dr. Yu Ding.',
    highlights: [
      'Researched with Dr. Yu Ding on applying advanced machine learning methods to solve and predict wind energy system failures.',
      'Implemented deep learning methods to predict possible power production and downtimes associated with wind turbine failures.',
      'Awarded Outstanding Master of Science Student (Apr 2019) by Department of Industrial and Systems Engineering.',
    ],
    tags: ['RESEARCH', 'DEEP LEARNING', 'TIME-SERIES', 'STATISTICS'],
  },
];
---

<BaseLayout title="About" description="About Jay Shah - Senior Machine Learning Engineer at 6sense, building production AI applications, foundational model systems, and agent evaluation frameworks" jsonLdType="ProfilePage">
  <article class="prose prose-kolam dark:prose-invert prose-lg max-w-none">
    <header class="reveal not-prose mb-10 flex flex-col items-center">
      <!-- 160px Profile photo with clean concentric Kolam yellow/gold boundaries & wave pedestal -->
      <div class="relative mb-6 flex flex-col items-center justify-center">
        <!-- Sinuous Kolam Wave Strand Bridge -->
        <div class="absolute inset-x-[-120px] sm:inset-x-[-160px] top-1/2 -translate-y-1/2 h-14 pointer-events-none flex items-center justify-center z-0" aria-hidden="true">
          <svg viewBox="0 0 600 40" class="w-full h-full" fill="none">
            <defs>
              <linearGradient id="aboutWaveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="white" stop-opacity="0"/>
                <stop offset="12%" stop-color="white" stop-opacity="1"/>
                <stop offset="88%" stop-color="white" stop-opacity="1"/>
                <stop offset="100%" stop-color="white" stop-opacity="0"/>
              </linearGradient>
              <mask id="aboutWaveMask">
                <rect width="600" height="40" fill="url(#aboutWaveGrad)"/>
              </mask>
            </defs>

            <g mask="url(#aboutWaveMask)">
              <path class="wave-terra-strand stroke-terra/50 dark:stroke-terra-light/50" d="M 0 20 Q 75 2, 150 20 Q 225 38, 300 20 Q 375 2, 450 20 Q 525 38, 600 20" stroke-width="1.2" stroke-linecap="round"/>
              <path class="wave-gold-strand stroke-gold/50 dark:stroke-gold-light/50" d="M 0 20 Q 75 38, 150 20 Q 225 2, 300 20 Q 375 38, 450 20 Q 525 2, 600 20" stroke-width="1.2" stroke-linecap="round"/>
            </g>
          </svg>
        </div>

        <!-- Concentric Yellow/Gold Round Boundaries -->
        <div class="relative shrink-0 z-10">
          <div class="absolute -inset-3.5 rounded-full border border-dashed border-gold/40 dark:border-gold-light/40 transition-colors"></div>
          <div class="absolute -inset-6 rounded-full border border-terra/20 dark:border-terra-light/25 transition-colors"></div>

          <div class="relative size-[160px] rounded-full overflow-hidden ring-4 ring-gold/60 dark:ring-gold-light/60 bg-cream-100 dark:bg-night-800 shadow-xl p-1 transition-all">
            <div class="relative size-full rounded-full overflow-hidden ring-1 ring-terra/30">
              <Image
                src={profileImage}
                alt="Jay Shah"
                width={160}
                height={160}
                densities={[1.5, 2, 3]}
                quality={95}
                class="size-full object-cover rounded-full"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Typewriter Headline: Anchored 50/50 Midpoint Grid (Non-shifting prefix) -->
      <div class="w-full mt-2 min-h-[48px] sm:min-h-[54px] flex items-center justify-center">
        <h1 class="grid grid-cols-2 gap-0 w-full font-display text-2xl sm:text-4xl leading-tight items-baseline m-0 p-0">
          <span class="text-right whitespace-nowrap text-ink dark:text-silk pr-1.5 select-none">
            {ABOUT_HEADLINE_PREFIX}
          </span>
          <span class="text-left whitespace-nowrap text-terra dark:text-terra-light font-normal pl-1.5 overflow-visible select-none">
            <span id="about-typewriter-text">{ABOUT_ROTATING_PHRASES[0]}</span><span class="cursor-caret" aria-hidden="true"></span>
          </span>
        </h1>
      </div>

      <!-- Carved Gradient Divider Bar -->
      <div class="w-12 h-[3px] mx-auto my-3.5 rounded bg-gradient-to-r from-terra via-gold to-terra" aria-hidden="true"></div>

      <!-- Bio Lead Statement -->
      <p class="font-body text-sm sm:text-base text-ink-muted dark:text-silk-muted mt-2 max-w-xl text-center leading-relaxed">
        Senior Machine Learning Engineer at <a href="https://6sense.com" target="_blank" rel="noopener noreferrer" class="text-terra dark:text-terra-light font-medium hover:underline decoration-terra/40 underline-offset-2">6sense</a>, building production AI applications, foundational embeddings, and agent evaluation frameworks.
      </p>

      <!-- Action Toolbar (GitHub, LinkedIn, Hugging Face, Resume) -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-5">
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-cream-300 dark:border-night-700 bg-cream-100/80 dark:bg-night-800/80 text-xs font-mono text-ink-light dark:text-silk-muted hover:border-terra hover:text-terra dark:hover:text-terra-light transition-all"
        >
          <SocialIcon name="github" class="size-3.5 text-ink-faint dark:text-silk-faint" />
          GitHub
        </a>
        <a
          href={SOCIAL_LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-cream-300 dark:border-night-700 bg-cream-100/80 dark:bg-night-800/80 text-xs font-mono text-ink-light dark:text-silk-muted hover:border-terra hover:text-terra dark:hover:text-terra-light transition-all"
        >
          <SocialIcon name="linkedin" class="size-3.5 text-ink-faint dark:text-silk-faint" />
          LinkedIn
        </a>
        <a
          href={SOCIAL_LINKS.huggingface}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-cream-300 dark:border-night-700 bg-cream-100/80 dark:bg-night-800/80 text-xs font-mono text-ink-light dark:text-silk-muted hover:border-terra hover:text-terra dark:hover:text-terra-light transition-all"
        >
          <SocialIcon name="huggingface" class="size-3.5 text-ink-faint dark:text-silk-faint" />
          Hugging Face
        </a>
        <a
          href={SOCIAL_LINKS.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-terra/30 bg-terra/10 text-xs font-mono text-terra dark:text-terra-light hover:bg-terra/20 transition-all font-semibold"
        >
          <SocialIcon name="resume" class="size-3.5" />
          Resume &nearr;
        </a>
      </div>

      <!-- Animated Breathing Kolam Divider Ribbon -->
      <KolamDivider class="my-8" />
    </header>

    <section class="reveal">
      <h2>About Me</h2>

      <p>
        I build machine-learning and language-model systems that have to work beyond the notebook.
      </p>

      <p>
        I write about the systems I build, the assumptions behind them, and the parts that usually break. If something is on this site, it shipped or I learned enough from it to explain what happened.
      </p>
    </section>

    <!-- Career & Work Experience Timeline -->
    <section class="reveal not-prose my-12">
      <div class="flex items-center justify-between gap-4 mb-8">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-terra dark:text-terra-light font-semibold">
            Work Experience
          </span>
          <h2 class="font-display text-2xl sm:text-3xl text-ink dark:text-silk mt-1">
            Career &amp; Engineering Timeline
          </h2>
        </div>
        <span class="font-mono text-xs text-ink-faint dark:text-silk-faint hidden sm:inline-block">
          2017 &ndash; Present
        </span>
      </div>

      <StepwellTimeline items={CAREER_ITEMS} />
    </section>

    <section class="reveal">
      <h2>Outside the Terminal</h2>

      <p>
        Cricket comes first. Tea, never coffee. Yoga is the habit that survived a newborn's sleep schedule.
      </p>

      <p>
        I care about Indic languages and culture, especially the gap between the languages people speak and the languages most AI systems understand. Gujarati Llama started as a personal project because useful language technology should not be limited to English-speaking users.
      </p>

      <p>
        I also read outside machine learning: systems thinking, philosophy, and energy policy. Some of my best technical ideas began as questions from another field.
      </p>
    </section>

    <!-- Honors & Awards (Consistent Kolam Stepwell Styling) -->
    <section class="reveal not-prose my-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
        <h2 class="font-display text-2xl text-ink dark:text-silk">
          Honors &amp; Awards
        </h2>
      </div>
      <div class="stepwell-spine pl-8 space-y-4">
        <div class="relative group">
          <div class="kolam-diamond-node -left-[27px] top-4 group-hover:border-gold group-hover:ring-4 group-hover:ring-gold/20 dark:group-hover:ring-gold/25 group-hover:scale-125 transition-transform duration-150" aria-hidden="true" />
          <div class="featured-card rangoli-corners p-4 sm:p-5 rounded-xl border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors duration-150">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <a
                href="https://github.com/rohrao/llamaindex_RAGathon"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-sm text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light transition-colors"
              >
                Winner at Ragathon by LlamaIndex &nearr;
              </a>
              <span class="font-mono text-xs text-terra dark:text-terra-light">Feb 2024</span>
            </div>
            <p class="text-xs text-ink-muted dark:text-silk-muted mt-1 leading-relaxed">
              Developed StreamLens, an agentic multi-model RAG system for interacting with autonomous vehicle video streams.
            </p>
          </div>
        </div>

        <div class="relative group">
          <div class="kolam-diamond-node -left-[27px] top-4 group-hover:border-gold group-hover:ring-4 group-hover:ring-gold/20 dark:group-hover:ring-gold/25 group-hover:scale-125 transition-transform duration-150" aria-hidden="true" />
          <div class="featured-card rangoli-corners p-4 sm:p-5 rounded-xl border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors duration-150">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-medium text-sm text-ink dark:text-silk">Outstanding Master of Science Student</span>
              <span class="font-mono text-xs text-gold">Apr 2019</span>
            </div>
            <p class="text-xs text-ink-muted dark:text-silk-muted mt-1 leading-relaxed">
              Texas A&amp;M University Department of Industrial and Systems Engineering.
            </p>
          </div>
        </div>

        <div class="relative group">
          <div class="kolam-diamond-node -left-[27px] top-4 group-hover:border-gold group-hover:ring-4 group-hover:ring-gold/20 dark:group-hover:ring-gold/25 group-hover:scale-125 transition-transform duration-150" aria-hidden="true" />
          <div class="featured-card rangoli-corners p-4 sm:p-5 rounded-xl border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors duration-150">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-medium text-sm text-ink dark:text-silk">2nd Runner-up at Texas Datathon by Citadel</span>
              <span class="font-mono text-xs text-ink-faint dark:text-silk-faint">Feb 2018</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Patents (Consistent Kolam Stepwell Styling) -->
    <section class="reveal not-prose my-12">
      <div class="flex items-center gap-3 mb-6">
        <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
        <h2 class="font-display text-2xl text-ink dark:text-silk">
          Patents
        </h2>
      </div>
      <div class="stepwell-spine pl-8 space-y-4">
        <div class="relative group">
          <div class="kolam-diamond-node -left-[27px] top-4 group-hover:border-gold group-hover:ring-4 group-hover:ring-gold/20 dark:group-hover:ring-gold/25 group-hover:scale-125 transition-transform duration-150" aria-hidden="true" />
          <div class="featured-card rangoli-corners p-4 sm:p-5 rounded-xl border border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light transition-colors duration-150">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <a
                href="https://patents.google.com/patent/US20230213560A1/en"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-sm text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light transition-colors"
