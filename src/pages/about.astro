---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialIcon from '../components/SocialIcon.astro';
import KolamDivider from '../components/KolamDivider.astro';
import { SOCIAL_LINKS, ABOUT_HEADLINE_PREFIX, ABOUT_ROTATING_PHRASES } from '../consts';
import { Image } from 'astro:assets';
import profileImage from '../../public/assets/images/profile.webp';
---

<BaseLayout title="About" description="About Jay Shah — Senior Machine Learning Engineer at 6sense, building production AI applications, foundational model systems, and agent evaluation frameworks" jsonLdType="ProfilePage">
  <article class="prose prose-kolam dark:prose-invert prose-lg max-w-none">
    <header class="reveal not-prose mb-10 flex flex-col items-center">
      <!-- 160px Profile photo with clean concentric Kolam yellow/gold boundaries & wave pedestal -->
      <div class="relative mb-6 flex flex-col items-center justify-center">
        <!-- Sinuous Kolam Wave Strand Bridge -->
        <div class="absolute inset-x-[-120px] sm:inset-x-[-160px] top-1/2 -translate-y-1/2 h-14 pointer-events-none flex items-center justify-center z-0" aria-hidden="true">
          <svg viewBox="0 0 600 40" class="w-full h-full" fill="none">
            <defs>
              <linearGradient id="aboutWaveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="white" stop-opacity="0"/>
                <stop offset="12%" stop-color="white" stop-opacity="1"/>
                <stop offset="88%" stop-color="white" stop-opacity="1"/>
                <stop offset="100%" stop-color="white" stop-opacity="0"/>
              </linearGradient>
              <mask id="aboutWaveMask">
                <rect width="600" height="40" fill="url(#aboutWaveGrad)"/>
              </mask>
            </defs>

            <g mask="url(#aboutWaveMask)">
              <path class="wave-terra-strand stroke-terra/50 dark:stroke-terra-light/50" d="M 0 20 Q 75 2, 150 20 Q 225 38, 300 20 Q 375 2, 450 20 Q 525 38, 600 20" stroke-width="1.2" stroke-linecap="round"/>
              <path class="wave-gold-strand stroke-gold/50 dark:stroke-gold-light/50" d="M 0 20 Q 75 38, 150 20 Q 225 2, 300 20 Q 375 38, 450 20 Q 525 2, 600 20" stroke-width="1.2" stroke-linecap="round"/>
            </g>
          </svg>
        </div>

        <!-- Concentric Yellow/Gold Round Boundaries -->
        <div class="relative shrink-0 z-10 group/avatar">
          <div class="absolute -inset-3.5 rounded-full border border-dashed border-gold/40 dark:border-gold-light/40 transition-all duration-700 ease-out group-hover/avatar:rotate-90 group-hover/avatar:scale-105"></div>
          <div class="absolute -inset-6 rounded-full border border-terra/20 dark:border-terra-light/25 transition-all duration-700 ease-out group-hover/avatar:-rotate-90"></div>

          <div class="relative size-[160px] rounded-full overflow-hidden ring-4 ring-gold/60 dark:ring-gold-light/60 bg-cream-100 dark:bg-night-800 shadow-xl p-1 transition-all duration-300 group-hover/avatar:scale-[1.02]">
            <div class="relative size-full rounded-full overflow-hidden ring-1 ring-terra/30">
              <Image
                src={profileImage}
                alt="Jay Shah"
                width={160}
                height={160}
                densities={[1.5, 2, 3]}
                quality={95}
                class="size-full object-cover rounded-full"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Typewriter Headline: Anchored 50/50 Midpoint Grid (Non-shifting prefix) -->
      <div class="w-full mt-2 min-h-[48px] sm:min-h-[54px] flex items-center justify-center">
        <h1 class="grid grid-cols-2 gap-0 w-full font-display text-2xl sm:text-4xl leading-tight items-baseline m-0 p-0">
          <span class="text-right whitespace-nowrap text-ink dark:text-silk pr-1.5 select-none">
            {ABOUT_HEADLINE_PREFIX}
          </span>
          <span class="text-left whitespace-nowrap text-terra dark:text-terra-light font-normal pl-1.5 overflow-visible select-none">
            <span id="about-typewriter-text">{ABOUT_ROTATING_PHRASES[0]}</span><span class="cursor-caret" aria-hidden="true"></span>
          </span>
        </h1>
      </div>

      <!-- Carved Gradient Divider Bar -->
      <div class="w-12 h-[3px] mx-auto my-3.5 rounded bg-gradient-to-r from-terra via-gold to-terra" aria-hidden="true"></div>

      <!-- Bio Lead Statement -->
      <p class="font-body text-sm sm:text-base text-ink-muted dark:text-silk-muted mt-2 max-w-xl text-center leading-relaxed">
        Senior Machine Learning Engineer at <a href="https://6sense.com" target="_blank" rel="noopener noreferrer" class="text-terra dark:text-terra-light font-medium hover:underline decoration-terra/40 underline-offset-2">6sense</a>, building production AI applications, foundational embeddings, and agent evaluation frameworks.
      </p>


      <!-- Action Toolbar (GitHub, LinkedIn, Hugging Face, Resume) -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-5">
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-cream-300 dark:border-night-700 bg-cream-100/80 dark:bg-night-800/80 text-xs font-mono text-ink-light dark:text-silk-muted hover:border-terra hover:text-terra dark:hover:text-terra-light transition-all"
        >
          <SocialIcon name="github" class="size-3.5 text-ink-faint dark:text-silk-faint" />
          GitHub
        </a>
        <a
          href={SOCIAL_LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-cream-300 dark:border-night-700 bg-cream-100/80 dark:bg-night-800/80 text-xs font-mono text-ink-light dark:text-silk-muted hover:border-terra hover:text-terra dark:hover:text-terra-light transition-all"
        >
          <SocialIcon name="linkedin" class="size-3.5 text-ink-faint dark:text-silk-faint" />
          LinkedIn
        </a>
        <a
          href={SOCIAL_LINKS.huggingface}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-cream-300 dark:border-night-700 bg-cream-100/80 dark:bg-night-800/80 text-xs font-mono text-ink-light dark:text-silk-muted hover:border-terra hover:text-terra dark:hover:text-terra-light transition-all"
        >
          <SocialIcon name="huggingface" class="size-3.5 text-ink-faint dark:text-silk-faint" />
          Hugging Face
        </a>
        <a
          href={SOCIAL_LINKS.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-terra/30 bg-terra/10 text-xs font-mono text-terra dark:text-terra-light hover:bg-terra/20 transition-all font-semibold"
        >
          <SocialIcon name="resume" class="size-3.5" />
          Resume &nearr;
        </a>
      </div>

      <!-- Animated Breathing Kolam Divider Ribbon -->
      <KolamDivider class="my-8" />
    </header>

    <section class="reveal">
      <h2>About Me</h2>

      <p>
        I build machine-learning and language-model systems that have to work beyond the notebook.
      </p>

      <p>
        At 6sense, I work on intent intelligence: foundational models with custom embeddings, model explainability, contextual knowledge graphs, and evaluation systems for large language model agents. The hard part is rarely choosing a better model. It is dealing with noisy signals, changing behavior, unclear definitions, and knowing whether a system is still trustworthy after it ships.
      </p>

      <p>
        Before 6sense, I built retrieval-augmented generation systems, Model Context Protocol agent platforms, anomaly detection products, and foundation-model operations at <a href="https://avathon.com">Avathon</a>. Some of that work supported more than 20 agent workflows and reduced model release cycles by 45%. Earlier, I worked on energy forecasting and failure prediction systems, including anomaly detection work that contributed to more than $500k in savings.
      </p>

      <p>
        My graduate research at Texas A&M focused on predicting wind-energy failures. That experience gave me a lasting rule: a model that works in a notebook has made a promise, not proved anything.
      </p>

      <p>
        I write about the systems I build, the assumptions behind them, and the parts that usually break. If something is on this site, it shipped or I learned enough from it to explain what happened.
      </p>
    </section>

    <section class="reveal mb-10">
      <h2>Outside the Terminal</h2>

      <p>
        Cricket comes first. Tea, never coffee. Yoga is the habit that survived a newborn's sleep schedule.
      </p>

      <div class="not-prose grid grid-cols-1 sm:grid-cols-3 gap-3 my-6">
        <div class="p-3.5 rounded-xl border border-cream-200/80 dark:border-night-700/80 bg-cream-100/40 dark:bg-night-900/40 flex items-center gap-3">
          <div class="size-9 rounded-lg bg-terra/10 dark:bg-terra-light/10 text-terra dark:text-terra-light flex items-center justify-center shrink-0 font-display text-base select-none">
            ☕
          </div>
          <div>
            <div class="font-body font-semibold text-xs text-ink dark:text-silk">Cutting Chai</div>
            <div class="text-[11px] text-ink-muted dark:text-silk-muted">Tea, never coffee</div>
          </div>
        </div>

        <div class="p-3.5 rounded-xl border border-cream-200/80 dark:border-night-700/80 bg-cream-100/40 dark:bg-night-900/40 flex items-center gap-3">
          <div class="size-9 rounded-lg bg-gold/10 dark:bg-gold-light/10 text-gold dark:text-gold-light flex items-center justify-center shrink-0 font-display text-base select-none">
            🏏
          </div>
          <div>
            <div class="font-body font-semibold text-xs text-ink dark:text-silk">Cricket First</div>
            <div class="text-[11px] text-ink-muted dark:text-silk-muted">Patience &amp; test cricket</div>
          </div>
        </div>

        <div class="p-3.5 rounded-xl border border-cream-200/80 dark:border-night-700/80 bg-cream-100/40 dark:bg-night-900/40 flex items-center gap-3">
          <div class="size-9 rounded-lg bg-mor/10 dark:bg-mor-light/10 text-mor dark:text-mor-light flex items-center justify-center shrink-0 font-display text-sm font-semibold select-none">
            ગુ
          </div>
          <div>
            <div class="font-body font-semibold text-xs text-ink dark:text-silk">Indic AI</div>
            <div class="text-[11px] text-ink-muted dark:text-silk-muted">Gujarati Llama &amp; regional LLMs</div>
          </div>
        </div>
      </div>

      <p>
        I care about Indic languages and culture, especially the gap between the languages people speak and the languages most AI systems understand. Gujarati Llama started as a personal project because useful language technology should not be limited to English-speaking users.
      </p>

      <p>
        I also read outside machine learning: systems thinking, philosophy, and energy policy. Some of my best technical ideas began as questions from another field.
      </p>
    </section>

    <section class="reveal not-prose mb-10">
      <h2 class="font-display text-2xl text-ink dark:text-silk carved-heading mb-4">Honors &amp; Awards</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-4 rounded-xl border border-cream-200 dark:border-night-700 bg-cream-50/70 dark:bg-night-800/70 shadow-xs">
          <div class="font-mono text-[10px] uppercase text-gold dark:text-gold-light mb-1.5 flex items-center gap-1 font-semibold tracking-wider">
            <span>★</span> 1st Place Winner
          </div>
          <h3 class="font-body font-semibold text-sm text-ink dark:text-silk leading-snug">
            Ragathon by LlamaIndex
          </h3>
          <p class="font-mono text-[11px] text-ink-faint dark:text-silk-faint mt-1">Feb 2024</p>
        </div>

        <div class="p-4 rounded-xl border border-cream-200 dark:border-night-700 bg-cream-50/70 dark:bg-night-800/70 shadow-xs">
          <div class="font-mono text-[10px] uppercase text-terra dark:text-terra-light mb-1.5 flex items-center gap-1 font-semibold tracking-wider">
            <span>◆</span> Academic Distinction
          </div>
          <h3 class="font-body font-semibold text-sm text-ink dark:text-silk leading-snug">
            Outstanding M.S. Student
          </h3>
          <p class="font-mono text-[11px] text-ink-faint dark:text-silk-faint mt-1">Apr 2019 • Texas A&amp;M</p>
        </div>

        <div class="p-4 rounded-xl border border-cream-200 dark:border-night-700 bg-cream-50/70 dark:bg-night-800/70 shadow-xs">
          <div class="font-mono text-[10px] uppercase text-mor dark:text-mor-light mb-1.5 flex items-center gap-1 font-semibold tracking-wider">
            <span>▲</span> 2nd Runner-up
          </div>
          <h3 class="font-body font-semibold text-sm text-ink dark:text-silk leading-snug">
            Texas Datathon by Citadel
          </h3>
          <p class="font-mono text-[11px] text-ink-faint dark:text-silk-faint mt-1">Feb 2018</p>
        </div>
      </div>
    </section>

    <section class="reveal not-prose mb-10">
      <h2 class="font-display text-2xl text-ink dark:text-silk carved-heading mb-4">Patents</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <a
          href="https://patents.google.com/patent/US20230213560A1/en"
          target="_blank"
          rel="noopener noreferrer"
          class="patent-card group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light flex items-center gap-1.5">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                US20230213560A1
              </span>
              <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded bg-cream-200 dark:bg-night-800 text-ink-muted dark:text-silk-muted">USPTO</span>
            </div>
            <h3 class="font-body font-semibold text-sm sm:text-base text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors leading-snug">
              Calculating energy loss during an outage
            </h3>
          </div>
          <div class="flex items-center justify-between mt-3 pt-2 border-t border-cream-200/60 dark:border-night-700/60 text-[11px] font-mono text-ink-faint dark:text-silk-faint">
            <span>Filed Dec 30, 2021</span>
            <span class="text-terra dark:text-terra-light group-hover:translate-x-0.5 transition-transform">Google Patents &nearr;</span>
          </div>
        </a>

        <a
          href="https://patents.google.com/patent/US20230214703A1/en"
          target="_blank"
          rel="noopener noreferrer"
          class="patent-card group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light flex items-center gap-1.5">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                US20230214703A1
              </span>
              <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded bg-cream-200 dark:bg-night-800 text-ink-muted dark:text-silk-muted">USPTO</span>
            </div>
            <h3 class="font-body font-semibold text-sm sm:text-base text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors leading-snug">
              Predicting energy production for assets
            </h3>
          </div>
          <div class="flex items-center justify-between mt-3 pt-2 border-t border-cream-200/60 dark:border-night-700/60 text-[11px] font-mono text-ink-faint dark:text-silk-faint">
            <span>Filed Dec 30, 2021</span>
            <span class="text-terra dark:text-terra-light group-hover:translate-x-0.5 transition-transform">Google Patents &nearr;</span>
          </div>
        </a>

        <a
          href="https://patents.google.com/patent/IN201721044402A/en"
          target="_blank"
          rel="noopener noreferrer"
          class="patent-card group flex flex-col justify-between sm:col-span-2"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-mono text-xs font-semibold text-terra dark:text-terra-light flex items-center gap-1.5">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                IN201721044402A
              </span>
              <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded bg-cream-200 dark:bg-night-800 text-ink-muted dark:text-silk-muted">Indian Patent Office</span>
            </div>
            <h3 class="font-body font-semibold text-sm sm:text-base text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors leading-snug">
              Dimension Measurement Using Image Processing
            </h3>
          </div>
          <div class="flex items-center justify-between mt-3 pt-2 border-t border-cream-200/60 dark:border-night-700/60 text-[11px] font-mono text-ink-faint dark:text-silk-faint">
            <span>Filed Dec 11, 2017</span>
            <span class="text-terra dark:text-terra-light group-hover:translate-x-0.5 transition-transform">Google Patents &nearr;</span>
          </div>
        </a>
      </div>
    </section>
  </article>

  <!-- Lightweight Typewriter Engine -->
  <script is:inline define:vars={{ phrases: ABOUT_ROTATING_PHRASES }}>
    (function () {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const typewriterEl = document.getElementById('about-typewriter-text');
      if (!typewriterEl || !Array.isArray(phrases) || phrases.length <= 1 || prefersReducedMotion) {
        return;
      }

      let phraseIdx = 0;
      let charIdx = phrases[0].length;
      let isDeleting = true;
      let timeoutId = null;

      const TYPING_SPEED = 65;
      const DELETING_SPEED = 35;
      const PAUSE_ON_WORD = 2400;
      const PAUSE_ON_EMPTY = 350;

      function typeLoop() {
        const currentPhrase = phrases[phraseIdx % phrases.length];

        if (!isDeleting) {
          charIdx++;
          typewriterEl.textContent = currentPhrase.substring(0, charIdx);

          if (charIdx === currentPhrase.length) {
            isDeleting = true;
            timeoutId = setTimeout(typeLoop, PAUSE_ON_WORD);
            return;
          }
          timeoutId = setTimeout(typeLoop, TYPING_SPEED);
        } else {
          charIdx--;
          typewriterEl.textContent = currentPhrase.substring(0, charIdx);

          if (charIdx === 0) {
            isDeleting = false;
            phraseIdx = (phraseIdx + 1) % phrases.length;
            timeoutId = setTimeout(typeLoop, PAUSE_ON_EMPTY);
            return;
          }
          timeoutId = setTimeout(typeLoop, DELETING_SPEED);
        }
      }

      timeoutId = setTimeout(typeLoop, PAUSE_ON_WORD);
    })();
  </script>
</BaseLayout>

<style>
  @keyframes blinkCaret {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .cursor-caret {
    display: inline-block;
    width: 2.5px;
    height: 0.85em;
    vertical-align: -0.04em;
    margin-left: 2px;
    background-color: #c4623a;
    animation: blinkCaret 0.85s infinite;
  }

  :global(.dark) .cursor-caret {
    background-color: #e07a4f;
  }

  .wave-terra-strand {
    animation: waveBreatheTerra 4.5s ease-in-out infinite alternate;
  }

  .wave-gold-strand {
    animation: waveBreatheGold 4.5s ease-in-out infinite alternate;
  }

  @keyframes waveBreatheTerra {
    0% { opacity: 0.35; stroke-width: 1px; }
    50% { opacity: 0.95; stroke-width: 1.6px; }
    100% { opacity: 0.35; stroke-width: 1px; }
  }

  @keyframes waveBreatheGold {
    0% { opacity: 0.95; stroke-width: 1.6px; }
    50% { opacity: 0.35; stroke-width: 1px; }
    100% { opacity: 0.95; stroke-width: 1.6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-caret,
    .wave-terra-strand,
    .wave-gold-strand {
      animation: none !important;
    }
  }
</style>

