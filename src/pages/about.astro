---
import BaseLayout from '../layouts/BaseLayout.astro';
import KolamDivider from '../components/KolamDivider.astro';
import StepwellTimeline, { type TimelineItem } from '../components/StepwellTimeline.astro';
import { SOCIAL_LINKS } from '../consts';
import { Image } from 'astro:assets';
import profileImage from '../../public/assets/images/profile.webp';

const CAREER_ITEMS: TimelineItem[] = [
  {
    period: '2026 - Present',
    role: 'Senior Machine Learning Engineer',
    organization: '6sense',
    orgUrl: 'https://6sense.com',
    current: true,
    description:
      'Training custom embedding models for B2B intent data, shipping model explainability in production, and building contextual knowledge graphs. Built an LLM agent evaluation harness used across engineering and product teams to catch regressions.',
  },
  {
    period: '2019 - 2026',
    role: 'Data Scientist III',
    organization: 'Avathon',
    orgUrl: 'https://avathon.com',
    description:
      'Built forecasting, anomaly detection, and MLOps systems for energy and industrial customers. Led a foundation-model MLOps platform that cut release cycles by 45%, built an MCP agent platform powering 20+ workflows, and shipped solar-storage anomaly detection and Bayesian alert ranking that saved over $500k and cut false positives by 25%.',
  },
  {
    period: '2017 - 2019',
    role: 'Graduate Research Assistant',
    organization: 'Texas A&M University',
    orgUrl: 'https://www.tamu.edu',
    description:
      'Researched wind-turbine failure prediction and power production forecasting under Dr. Yu Ding while completing an M.S. in Industrial and Systems Engineering with a minor in Applied Statistics.',
  },
];

const HONORS = [
  {
    title: 'Winner, Ragathon by LlamaIndex',
    date: 'Feb 2024',
    url: 'https://github.com/rohrao/llamaindex_RAGathon',
    note: 'StreamLens, a multi-model RAG system for autonomous vehicle video streams.',
  },
  {
    title: 'Outstanding Master of Science Student',
    date: 'Apr 2019',
    note: 'Department of Industrial and Systems Engineering, Texas A&M University.',
  },
  {
    title: '2nd Runner-up, Texas Datathon by Citadel',
    date: 'Feb 2018',
  },
];

const PATENTS = [
  {
    title: 'Calculating energy loss during an outage',
    id: 'US20230213560A1',
    url: 'https://patents.google.com/patent/US20230213560A1/en',
    filed: 'Filed Dec 30, 2021',
  },
  {
    title: 'Predicting energy production for energy generating assets',
    id: 'US20230214703A1',
    url: 'https://patents.google.com/patent/US20230214703A1/en',
    filed: 'Filed Dec 30, 2021',
  },
  {
    title: 'Dimension Measurement Using Image Processing and Separation of Defective Products',
    id: 'IN 201721044402',
    url: 'https://patents.google.com/patent/IN201721044402A/en',
    filed: 'Filed Dec 11, 2017',
  },
];
---

<BaseLayout
  title="About"
  description="About Jay Shah, a machine learning engineer in San Francisco working on embeddings, retrieval, and AI agent tools."
  jsonLdType="ProfilePage"
>
  <article class="max-w-[68ch]">
    <header class="reveal mb-8" style="--index: 0;">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6">
        <div class="min-w-0">
          <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading leading-[1.15] tracking-tight">
            About
          </h1>
          <p class="mt-3 font-mono text-xs text-ink-muted dark:text-silk-faint flex flex-wrap items-center gap-x-2.5 gap-y-1">
            <span>San Francisco, CA</span>
            <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
            <a
              href={SOCIAL_LINKS.cv}
              target="_blank"
              rel="noopener noreferrer"
              class="text-terra dark:text-terra-light hover:underline underline-offset-2"
            >
              Resume &nearr;
            </a>
            <span class="text-cream-400 dark:text-night-700 select-none" aria-hidden="true">&bull;</span>
            <a
              href={SOCIAL_LINKS.email}
              class="hover:text-terra dark:hover:text-terra-light transition-colors"
            >
              Email
            </a>
          </p>
        </div>

        <div class="relative shrink-0 self-start sm:self-center">
          <div class="absolute -inset-2 rounded-full border border-dashed border-gold/45 dark:border-gold-light/45" aria-hidden="true" />
          <div class="relative size-[76px] sm:size-[88px] rounded-full overflow-hidden ring-2 ring-gold/60 dark:ring-gold-light/60 bg-cream-100 dark:bg-night-800 p-0.5 shadow-sm">
            <div class="relative size-full rounded-full overflow-hidden">
              <Image
                src={profileImage}
                alt="Jay Shah"
                width={88}
                height={88}
                densities={[1.5, 2]}
                quality={92}
                class="size-full object-cover object-top rounded-full"
              />
            </div>
          </div>
        </div>
      </div>

      <KolamDivider class="mt-7" />
    </header>

    <section class="reveal prose prose-kolam dark:prose-invert max-w-[65ch]" style="--index: 1;">
      <p>
        I'm a machine learning engineer in San Francisco. I work across classical ML, retrieval, and language models: training custom embeddings, building agent evaluations, and debugging what breaks once real data hits a model.
      </p>

      <p>
        My path into ML started with mechanical engineering in Gujarat, followed by graduate research at Texas A&amp;M under Dr. Yu Ding, where I worked on wind-turbine failure prediction and minored in applied statistics. From 2019 to 2026 I was at <a href="https://avathon.com" target="_blank" rel="noopener noreferrer">Avathon</a>, building forecasting, anomaly detection, MLOps, and later RAG and MCP agent systems for energy and industrial teams. Now I'm a Senior Machine Learning Engineer at <a href="https://6sense.com" target="_blank" rel="noopener noreferrer">6sense</a>, working on embeddings, explainability, knowledge graphs, and agent evals.
      </p>

      <p>
        On the side, I build small tools and run my own experiments instead of taking benchmarks at face value. Lately that has meant extensions for the Pi coding agent, experiments on dense retrieval and text watermarking, and <a href="https://huggingface.co/jayshah5696/Gujarati-Llama-7b-Base" target="_blank" rel="noopener noreferrer">Gujarati Llama</a>, a Llama 2 model I fine-tuned on 60,000 English-Gujarati pairs because Indic languages are still poorly served by most AI tools. This site is where I write up those projects and what actually happened.
      </p>
    </section>

    <section aria-labelledby="experience-heading" class="reveal my-12" style="--index: 2;">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
          <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
          <h2 id="experience-heading" class="font-display text-xl sm:text-2xl text-ink dark:text-silk">
            Experience
          </h2>
        </div>
        <a
          href={SOCIAL_LINKS.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-terra dark:text-terra-light hover:underline whitespace-nowrap"
        >
          Full CV &nearr;
        </a>
      </div>

      <StepwellTimeline items={CAREER_ITEMS} />
    </section>

    <section aria-labelledby="outside-work-heading" class="reveal prose prose-kolam dark:prose-invert max-w-[65ch] my-12" style="--index: 3;">
      <h2 id="outside-work-heading">Outside work</h2>

      <p>
        Outside work, I follow cricket closely and drink tea, never coffee. I have kept up a yoga and meditation practice for years, starting with Sadhguru's work, and it is still the one habit that survived a newborn's sleep schedule. I also spend a lot of time reading outside ML, mostly around systems thinking, philosophy, and energy policy.
      </p>
    </section>

    <KolamDivider class="my-10" />

    <section aria-labelledby="patents-heading" class="reveal my-10" style="--index: 4;">
      <div class="flex items-center gap-3 mb-4">
        <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
        <h2 id="patents-heading" class="font-display text-xl sm:text-2xl text-ink dark:text-silk">
          Patents
        </h2>
      </div>

      <ul class="divide-y divide-cream-200/80 dark:divide-night-700/80 border-t border-b border-cream-200/80 dark:border-night-700/80">
        {PATENTS.map((patent) => (
          <li class="py-3.5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
            <div class="min-w-0">
              <a
                href={patent.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body text-sm font-medium text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light transition-colors"
              >
                {patent.title} &nearr;
              </a>
              <p class="font-body text-xs text-ink-muted dark:text-silk-faint mt-0.5">
                {patent.filed}
              </p>
            </div>
            <span class="font-mono text-xs text-terra dark:text-terra-light shrink-0 tabular-nums">
              {patent.id}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="honors-heading" class="reveal my-10" style="--index: 5;">
      <div class="flex items-center gap-3 mb-4">
        <div class="kolam-diamond-node relative static! size-3.5 shrink-0" aria-hidden="true" />
        <h2 id="honors-heading" class="font-display text-xl sm:text-2xl text-ink dark:text-silk">
          Honors &amp; Awards
        </h2>
      </div>

      <ul class="divide-y divide-cream-200/80 dark:divide-night-700/80 border-t border-b border-cream-200/80 dark:border-night-700/80">
        {HONORS.map((honor) => (
          <li class="py-3.5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
            <div class="min-w-0">
              {honor.url ? (
                <a
                  href={honor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-body text-sm font-medium text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light transition-colors"
                >
                  {honor.title} &nearr;
                </a>
              ) : (
                <span class="font-body text-sm font-medium text-ink dark:text-silk">
                  {honor.title}
                </span>
              )}
              {honor.note && (
                <p class="font-body text-xs text-ink-muted dark:text-silk-faint mt-0.5 leading-relaxed">
                  {honor.note}
                </p>
              )}
            </div>
            <span class="font-mono text-xs text-ink-faint dark:text-silk-faint shrink-0 tabular-nums">
              {honor.date}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
