---
import BaseLayout from '../layouts/BaseLayout.astro';
import StepwellTimeline, { type TimelineItem } from '../components/StepwellTimeline.astro';
import KolamDivider from '../components/KolamDivider.astro';
import { SOCIAL_LINKS } from '../consts';
import { Image } from 'astro:assets';
import profileImage from '../../public/assets/images/profile.webp';

const CAREER_ITEMS: TimelineItem[] = [
  {
    period: '2026 - Present',
    role: 'Senior Machine Learning Engineer',
    organization: '6sense',
    orgUrl: 'https://6sense.com',
    current: true,
    description: 'Leading Forward-Deployed Engineering (FDE) for predictive ML, working with customers on model health and custom workflows and bringing feedback into product decisions. Also working on model explainability, account embeddings, knowledge-graph prototyping, and AI agent evaluations.',
  },
  {
    period: '2019 - 2026',
    role: 'Data Scientist III',
    organization: 'Avathon',
    orgUrl: 'https://avathon.com',
    description: 'Industrial forecasting, anomaly detection, MLOps, and MCP agent workflows.',
  },
  {
    period: '2017 - 2019',
    role: 'Graduate Research Assistant',
    organization: 'Texas A&M University',
    orgUrl: 'https://www.tamu.edu',
    description: 'M.S. Industrial Engineering (Applied Statistics). Wind-turbine failure prediction.',
  },
];

const RECOGNITION = [
  {
    title: 'Winner, Ragathon by LlamaIndex (StreamLens)',
    meta: '2024',
    url: 'https://github.com/rohrao/llamaindex_RAGathon',
  },
  {
    title: 'Calculating energy loss during an outage',
    meta: 'US12066472B2 · Granted 2024',
    url: 'https://patents.google.com/patent/US12066472B2/en',
  },
  {
    title: 'Predicting energy production for energy generating assets',
    meta: 'US20230214703A1',
    url: 'https://patents.google.com/patent/US20230214703A1/en',
  },
  {
    title: 'Outstanding Master of Science Student, Texas A&M',
    meta: '2019',
  },
  {
    title: '2nd Runner-up, Texas Datathon by Citadel',
    meta: '2018',
  },
  {
    title: 'Dimension measurement using image processing for defect separation',
    meta: 'IN201721044402',
    url: 'https://patents.google.com/patent/IN201721044402A/en',
  },
];
---

<BaseLayout
  title="About"
  description="About Jay Shah, a Senior Machine Learning Engineer in San Francisco leading forward-deployed predictive ML, model explainability, embeddings, and AI agent evaluations."
  jsonLdType="ProfilePage"
>
  <article class="max-w-[65ch]">
    <!-- Warm Editorial Header with Larger Portrait & Kinetic Identity Line -->
    <header class="reveal mb-14" style="--index: 0;">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-7">
        <div class="min-w-0 flex-1">
          <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading leading-[1.15] tracking-tight">
            About
          </h1>

          <p class="mt-5 font-body text-base sm:text-[17px] text-ink dark:text-silk leading-relaxed">
            I am<span class="about-rotator inline-grid align-baseline overflow-hidden ml-[0.28em] pr-1" aria-label="an ML engineer, a tool builder, a tea drinker, a quiet meditator">
              <span class="about-slot about-slot-1 italic text-terra dark:text-terra-light">an ML engineer.</span>
              <span class="about-slot about-slot-2 italic text-mor dark:text-mor-light" aria-hidden="true">a tool builder.</span>
              <span class="about-slot about-slot-3 italic text-gold-dark dark:text-gold-light" aria-hidden="true">a tea drinker, never coffee.</span>
              <span class="about-slot about-slot-4 italic text-kumkum dark:text-kumkum-light" aria-hidden="true">a quiet meditator.</span>
            </span>
          </p>

          <p class="mt-3.5 font-mono text-xs text-ink-faint dark:text-silk-faint flex flex-wrap items-center gap-x-2.5 gap-y-1">
            <span>San Francisco</span>
            <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
            <a
              href={SOCIAL_LINKS.cv}
              target="_blank"
              rel="noopener noreferrer"
              class="group/cv inline-flex items-center gap-0.5 text-terra dark:text-terra-light hover:underline underline-offset-2 transition-colors duration-150"
            >
              <span>Resume</span>
              <span class="inline-block group-hover/cv:translate-x-0.5 group-hover/cv:-translate-y-0.5 transition-transform duration-150" aria-hidden="true">&nearr;</span>
            </a>
            <span class="opacity-40 select-none" aria-hidden="true">&middot;</span>
            <a
              href={SOCIAL_LINKS.email}
              class="hover:text-terra dark:hover:text-terra-light transition-colors duration-150"
            >
              Email
            </a>
          </p>
        </div>

        <!-- Bigger Portrait with Delicate Kolam Halo -->
        <div class="relative shrink-0 self-start sm:self-center">
          <div
            class="about-portrait-halo absolute -inset-2.5 rounded-full border border-dashed border-gold/45 dark:border-gold-light/40"
            aria-hidden="true"
          />
          <div class="relative size-28 sm:size-32 rounded-full overflow-hidden ring-1 ring-gold/70 dark:ring-gold-light/65 bg-cream-100 dark:bg-night-800 p-1 shadow-xs">
            <div class="relative size-full rounded-full overflow-hidden">
              <Image
                src={profileImage}
                alt="Jay Shah"
                width={128}
                height={128}
                densities={[1.5, 2]}
                quality={92}
                class="size-full object-cover object-top rounded-full"
              />
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Soulful, Tight Editorial Bio (Zero Career-Timeline Repetition) -->
    <section class="reveal prose prose-kolam dark:prose-invert max-w-[60ch]" style="--index: 1;">
      <p>
        Originally from Gujarat, now in San Francisco. My path into machine learning ran through mechanical engineering and applied statistics, and I still care most about what actually holds up once messy real-world data hits a model.
      </p>
      <p>
        On the side, I build small tools and run my own experiments instead of taking benchmarks at face value: extensions for the Pi coding agent, text watermarking labs, and <a href="https://huggingface.co/jayshah5696/Gujarati-Llama-7b-Base" target="_blank" rel="noopener noreferrer">Gujarati Llama</a>, a model I fine-tuned on 60k English-Gujarati pairs because Indic languages are still poorly served by modern AI.
      </p>
      <p>
        Outside work, I follow cricket closely, drink tea (never coffee), and keep a daily yoga and meditation practice that even survived a newborn's sleep schedule. Most of my non-ML reading leans toward systems thinking, philosophy, and energy policy.
      </p>
    </section>

    <section aria-labelledby="experience-heading" class="reveal mt-16" style="--index: 2;">
      <div class="flex items-center gap-3 mb-6">
        <div class="kolam-diamond-node relative static! ml-[5.5px] size-3 shrink-0" aria-hidden="true" />
        <h2 id="experience-heading" class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
          Experience
        </h2>
      </div>

      <StepwellTimeline items={CAREER_ITEMS} />
    </section>

    <section aria-labelledby="recognition-heading" class="reveal mt-16" style="--index: 3;">
      <div class="flex items-center gap-3 mb-4">
        <div class="kolam-diamond-node relative static! ml-[5.5px] size-3 shrink-0" aria-hidden="true" />
        <h2 id="recognition-heading" class="font-body font-medium text-sm tracking-wide text-ink-muted dark:text-silk-muted">
          Recognition &amp; Patents
        </h2>
      </div>

      <ul class="border-t border-terra/15 dark:border-gold/15">
        {RECOGNITION.map((item, i) => (
          <li class="vav-row-hover py-4 px-2 -mx-2 border-b border-terra/15 dark:border-gold/15 last:border-b-0 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
            <div class="flex items-baseline gap-3.5 min-w-0">
              <span class="font-mono text-[11px] text-ink-faint/80 dark:text-silk-faint/75 tabular-nums shrink-0 w-5">
                {String(i + 1).padStart(2, '0')}
              </span>
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/rec font-body font-medium text-[15px] text-ink dark:text-silk hover:text-terra dark:hover:text-terra-light transition-colors duration-150 leading-snug"
                >
                  {item.title} <span class="inline-block font-mono text-xs text-ink-faint/80 dark:text-silk-faint/80 group-hover/rec:text-terra dark:group-hover/rec:text-terra-light group-hover/rec:translate-x-0.5 group-hover/rec:-translate-y-0.5 transition-[color,transform] duration-150" aria-hidden="true">&nearr;</span>
                </a>
              ) : (
                <span class="font-body font-medium text-[15px] text-ink dark:text-silk leading-snug">
                  {item.title}
                </span>
              )}
            </div>
            <span class="font-mono text-xs text-ink-faint dark:text-silk-faint shrink-0 tabular-nums pl-[34px] sm:pl-0">
              {item.meta}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <KolamDivider class="mt-20" />
  </article>
</BaseLayout>

<style>
  .about-rotator {
    position: relative;
    line-height: inherit;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .about-slot {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(55%);
    animation: aboutRoleCycle 12s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .about-slot-1 { animation-delay: 0s; }
  .about-slot-2 { animation-delay: 3s; }
  .about-slot-3 { animation-delay: 6s; }
  .about-slot-4 { animation-delay: 9s; }

  @keyframes aboutRoleCycle {
    0% {
      opacity: 0;
      transform: translateY(55%);
    }
    5%, 22% {
      opacity: 1;
      transform: translateY(0%);
    }
    27%, 100% {
      opacity: 0;
      transform: translateY(-55%);
    }
  }

  .about-portrait-halo {
    animation: aboutHaloDrift 48s linear infinite;
  }

  @keyframes aboutHaloDrift {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-slot {
      animation: none !important;
      opacity: 0;
      transform: none;
    }
    .about-slot-1 {
      opacity: 1;
    }
    .about-portrait-halo {
      animation: none !important;
    }
  }
</style>
