---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import IndexRow from '../components/IndexRow.astro';
import { SOCIAL_LINKS } from '../consts';

const PROFILES = [
  {
    name: 'GitHub',
    icon: 'github',
    url: SOCIAL_LINKS.github,
    handle: '@jayshah5696',
    external: true,
  },
  {
    name: 'LinkedIn',
    icon: 'linkedin',
    url: SOCIAL_LINKS.linkedin,
    handle: 'in/jayshah5696',
    external: true,
  },
  {
    name: 'Hugging Face',
    icon: 'huggingface',
    url: SOCIAL_LINKS.huggingface,
    handle: '@jayshah5696',
    external: true,
  },
  {
    name: 'X',
    icon: 'x',
    url: SOCIAL_LINKS.twitter,
    handle: '@jayjshah',
    external: true,
  },
  {
    name: 'Email',
    icon: 'email',
    url: SOCIAL_LINKS.email,
    handle: 'contact@jayshah.dev',
    external: false,
  },
];
---

<BaseLayout title="Links" description="Connect with Jay Shah across GitHub, LinkedIn, X, Hugging Face, or Email.">
  <div class="max-w-xl">
    <header class="reveal mb-12">
      <h1 class="font-display text-3xl sm:text-4xl text-ink dark:text-silk carved-heading">
        Links
      </h1>
    </header>

    <ul class="reveal border-t border-terra/15 dark:border-gold/15">
      {PROFILES.map((profile, i) => (
        <IndexRow
          href={profile.url}
          indexNum={String(i + 1).padStart(2, '0')}
          title={profile.name}
          meta={profile.handle}
          external={profile.external}
        >
          <span slot="leading" class="text-ink-faint dark:text-silk-faint group-hover:text-terra dark:group-hover:text-terra-light transition-colors self-center mr-1">
            <SocialIcon name={profile.icon} class="size-4" />
          </span>
        </IndexRow>
      ))}
    </ul>
  </div>
</BaseLayout>
