---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SOCIAL_LINKS } from '../consts';

const PROFILES = [
  {
    name: 'GitHub',
    icon: 'github',
    url: SOCIAL_LINKS.github,
    description: 'Open source contributions, synthetic data pipelines, and RLHF training.',
    featured: true,
    badge: 'Primary Profile',
    handle: '@jayshah5696',
  },
  {
    name: 'LinkedIn',
    icon: 'linkedin',
    url: SOCIAL_LINKS.linkedin,
    description: 'Professional updates, embedding models, and agent evaluation frameworks.',
    handle: 'in/jayshah5696',
  },
  {
    name: 'Hugging Face',
    icon: 'huggingface',
    url: SOCIAL_LINKS.huggingface,
    description: 'Open-source model checkpoints, datasets, and the Gujarati Llama model.',
    handle: '@jayshah5696',
  },
  {
    name: 'Email',
    icon: 'email',
    url: SOCIAL_LINKS.email,
    description: 'Reach out directly at contact@jayshah.dev.',
    handle: 'contact@jayshah.dev',
  },
  {
    name: 'Twitter / X',
    icon: 'x',
    url: SOCIAL_LINKS.twitter,
    description: 'Quick dev insights, paper discussions, and technical updates.',
    handle: '@jayshah5696',
  },
];
---

<BaseLayout title="Profiles & Links" description="Connect with Jay Shah across GitHub, LinkedIn, Twitter, Hugging Face, or Email.">
  <div class="max-w-2xl space-y-6">
    <header class="reveal mb-8">
      <h1 class="font-display text-3xl text-ink dark:text-silk carved-heading">Profiles &amp; Links</h1>
      <p class="text-ink-muted dark:text-silk-muted text-sm mt-2 font-mono">
        Find me across the internet.
      </p>
      <div class="kolam-border mt-5"></div>
    </header>

    <div class="space-y-4">
      {PROFILES.map((profile, i) => (
        <a
          href={profile.url}
          target={profile.icon === 'email' ? undefined : '_blank'}
          rel={profile.icon === 'email' ? undefined : 'noopener noreferrer'}
          class:list={[
            'reveal featured-card rangoli-corners overflow-hidden relative flex items-center justify-between p-4 sm:p-5 rounded-xl border transition-all duration-200 group hover:-translate-y-0.5',
            profile.featured
              ? 'border-terra/30 dark:border-terra-light/20 hover:border-terra dark:hover:border-terra-light'
              : 'border-cream-200 dark:border-night-700 hover:border-terra dark:hover:border-terra-light',
          ]}
          style={`--index: ${i};`}
        >
          <div class="flex items-start sm:items-center gap-4 relative z-10 min-w-0">
            <div class="flex items-center justify-center size-11 rounded-lg bg-terra/10 dark:bg-terra-light/10 text-terra dark:text-terra-light group-hover:scale-105 group-hover:bg-terra/15 dark:group-hover:bg-terra-light/15 transition-all duration-300 shrink-0">
              <SocialIcon name={profile.icon} class="size-5" />
            </div>
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="font-display text-base sm:text-lg text-ink dark:text-silk group-hover:text-terra dark:group-hover:text-terra-light transition-colors">
                  {profile.name}
                </h2>
                {profile.featured && (
                  <span class="inline-block font-mono text-[10px] uppercase text-terra dark:text-terra-light px-2 py-0.5 rounded bg-terra/10 dark:bg-terra-light/10 border border-terra/20 dark:border-terra-light/20" style="letter-spacing: 0.12em;">
                    {profile.badge}
                  </span>
                )}
                {profile.handle && (
                  <span class="font-mono text-xs text-ink-faint dark:text-silk-faint">
                    {profile.handle}
                  </span>
                )}
              </div>
              <p class="text-ink-muted dark:text-silk-muted text-xs sm:text-sm mt-0.5 leading-relaxed">
                {profile.description}
              </p>
            </div>
          </div>

          <div class="flex items-center text-ink-muted dark:text-silk-muted group-hover:text-terra dark:group-hover:text-terra-light transition-all duration-200 shrink-0 pl-2 relative z-10">
            <svg class="size-5 transform group-hover:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
